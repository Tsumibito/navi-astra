{
  "name": "navi-astro",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "sync:payload-certificates": "node scripts/sync-payload-certificates.mjs",
    "sync:payload-content": "node scripts/sync-payload-content.mjs",
    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "generate:webp": "node scripts/generate-webp.mjs",
    "build": "npm run generate:sitemap && astro build && node scripts/validate-build.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --experimental-strip-types --test test/**/*.test.mjs",
    "validate": "node scripts/validate-build.mjs",
    "deploy:cloudflare": "npm run build && wrangler pages deploy dist --project-name=navi-training"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^26.1.1",
    "astro": "^7.1.0",
    "playwright": "^1.61.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.112.0"
  },
  "dependencies": {
    "@phosphor-icons/web": "^2.1.2"
  }
}
