---
import landingData from '../data/landing-charter-for-everybody.json' with { type: 'json' };
interface Props { locale: 'ru' | 'ua' }
const { locale } = Astro.props;
const entries = Object.entries(landingData.program[locale]);
const lectures = entries.slice(0, 7);
const bonuses = entries.slice(7);
const copy = locale === 'ua'
  ? { title: 'Програма навчання', subtitle: '7 денний марафон «Яхтовий чартер для всіх»', lecture: 'Лекція', bonusTitle: 'Ваші Бонуси', bonus: 'Бонус' }
  : { title: 'Программа марафона', subtitle: '7-дневный марафон «Яхтинг для всех»', lecture: 'Лекция', bonusTitle: 'Ваши Бонусы', bonus: 'Бонус' };
const paragraphs = (text: string) => text.split(/\n\s*\n/).filter(Boolean);
---
<section class="campaign-program" data-evo-section="6">
  <div class="campaign-program__inner">
    <h2>{copy.title}</h2><p>{copy.subtitle}</p>
    <div class="campaign-program__list">
      {lectures.map(([title, answer], index) => <div class="campaign-program__row"><div>{copy.lecture} {index + 1}</div><details><summary>{title}</summary><article>{paragraphs(answer).map((p) => <p>{p}</p>)}</article></details></div>)}
    </div>
    <h2>{copy.bonusTitle}</h2>
    <div class="campaign-program__list">
      {bonuses.map(([title, answer], index) => <div class="campaign-program__row"><div>{copy.bonus} {index + 1}</div><details><summary>{title}</summary><article>{paragraphs(answer).map((p) => <p>{p}</p>)}</article></details></div>)}
    </div>
  </div>
</section>
<style is:global>
  .campaign-program{position:relative;z-index:0;width:100vw;margin-left:calc(50% - 50vw);padding:96px 24px;background:linear-gradient(160deg,#b6d8fa 0 18%,#2d8dbc 18% 68%,#b6d8fa 68%);color:#073746;box-sizing:border-box}
  .campaign-program__inner{max-width:700px;margin:auto}.campaign-program h2{margin:0;text-align:center;font:400 clamp(32px,4vw,52px)/1.1 'Tenor Sans',Arial,sans-serif}.campaign-program__inner>p{text-align:center;margin:18px 0 42px;font:18px/1.4 Arial,sans-serif}.campaign-program__list{overflow:hidden;border:2px solid #c8c8c8;border-radius:20px;background:#fff;margin-bottom:56px}.campaign-program__row{display:grid;grid-template-columns:165px minmax(0,1fr);border-top:1px solid #dce3e6}.campaign-program__row:first-child{border-top:0}.campaign-program__row>div{display:grid;place-items:center;padding:24px 12px;background:#ffb454;color:#fff;font:700 16px/1.2 Arial,sans-serif}.campaign-program details{min-width:0;background:#fff}.campaign-program summary{padding:24px 36px;cursor:pointer;font:700 18px/1.25 Arial,sans-serif;list-style:none}.campaign-program summary::-webkit-details-marker{display:none}.campaign-program article{padding:0 36px 28px;color:#4d6872;font:16px/1.65 Arial,sans-serif}.campaign-program article p{margin:0 0 16px}@media(max-width:640px){.campaign-program{padding:64px 20px}.campaign-program__row{grid-template-columns:1fr}.campaign-program__row>div{padding:18px}.campaign-program summary{padding:22px 20px;font-size:16px}.campaign-program article{padding:0 20px 22px;font-size:15px}}
</style>
