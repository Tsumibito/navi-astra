---
import { saronicPoints, saronicRoute, type PilotLocale } from '~/data/geography/saronic-pilot';

interface Props { locale: PilotLocale; mode?: 'region' | 'marina' | 'route'; title: string; intro?: string; }
const { locale, mode = 'region', title, intro } = Astro.props as Props;
const points = mode === 'marina' ? saronicPoints.filter((point) => point.id === 'alimos') : saronicPoints;
const labels = locale === 'ru'
  ? { list: 'Места на карте', note: 'Интерактивная карта · не навигационная', open: 'Подробнее', attribution: 'Карта: OpenStreetMap / MapLibre' }
  : locale === 'ua'
    ? { list: 'Місця на карті', note: 'Інтерактивна карта · не навігаційна', open: 'Докладніше', attribution: 'Мапа: OpenStreetMap / MapLibre' }
    : { list: 'Places on the map', note: 'Interactive map · not for navigation', open: 'Learn more', attribution: 'Map: OpenStreetMap / MapLibre' };
const bounds = mode === 'marina' ? '23.676,37.900,23.723,37.929' : '23.22,37.25,23.83,38.02';
const mapData = {
  locale,
  mode,
  points: points.map((point) => ({ ...point, label: point.labels[locale], href: point.href?.[locale] ?? null })),
  route: mode === 'route' ? saronicRoute : [],
};
---
<section class:list={['charter-map', `charter-map--${mode}`]} data-geography-map data-map={JSON.stringify(mapData)}>
  <div class="charter-map__head">
    <div><p class="ds-eyebrow">36.9°–38.0° N · 23.2°–23.8° E</p><h2>{title}</h2>{intro && <p>{intro}</p>}</div>
    <span>{labels.note}</span>
  </div>
  <div class="charter-map__viewport">
    <iframe
      class="charter-map__fallback"
      title={title}
      src={`https://www.openstreetmap.org/export/embed.html?bbox=${encodeURIComponent(bounds)}&layer=mapnik&marker=37.91401%2C23.69997`}
      loading="lazy"
      referrerpolicy="strict-origin-when-cross-origin"
    ></iframe>
    <div class="charter-map__canvas" aria-label={`${title}. ${labels.note}`}></div>
  </div>
  <nav class="charter-map__places" aria-label={labels.list}>
    {points.map((point, index) => point.href?.[locale]
      ? <a href={point.href[locale]}><b>{mode === 'route' ? index + 1 : '•'}</b><span>{point.labels[locale]}</span><small>{labels.open} →</small></a>
      : <span><b>{mode === 'route' ? index + 1 : '•'}</b><span>{point.labels[locale]}</span></span>)}
  </nav>
  <p class="charter-map__credit"><a href="https://www.openstreetmap.org/copyright" rel="license external noopener">{labels.attribution}</a> · © OpenStreetMap contributors</p>
</section>

<script>
  import maplibregl from 'maplibre-gl';
  import 'maplibre-gl/dist/maplibre-gl.css';

  document.querySelectorAll<HTMLElement>('[data-geography-map]').forEach((root) => {
    if (root.dataset.mapReady === 'true') return;
    const canvas = root.querySelector<HTMLElement>('.charter-map__canvas');
    const fallback = root.querySelector<HTMLElement>('.charter-map__fallback');
    if (!canvas || !root.dataset.map) return;
    const data = JSON.parse(root.dataset.map);
    const map = new maplibregl.Map({
      container: canvas,
      style: 'https://demotiles.maplibre.org/style.json',
      center: data.mode === 'marina' ? [23.69997, 37.91401] : [23.51, 37.64],
      zoom: data.mode === 'marina' ? 14.2 : 8.4,
      attributionControl: false,
      cooperativeGestures: true,
    });
    map.addControl(new maplibregl.NavigationControl({ showCompass: false }), 'top-right');
    map.addControl(new maplibregl.AttributionControl({ compact: true }), 'bottom-right');
    map.on('style.load', () => {
      // The editorial geography layer supplies all labels used on these pages.
      // Hiding base-map symbols keeps the chart calm and avoids irrelevant POIs.
      for (const layer of map.getStyle().layers ?? []) {
        if (layer.type === 'symbol') map.setLayoutProperty(layer.id, 'visibility', 'none');
      }
    });
    map.on('load', () => {
      if (data.route?.length) {
        map.addSource('editorial-route', { type: 'geojson', data: { type: 'Feature', properties: {}, geometry: { type: 'LineString', coordinates: data.route } } });
        map.addLayer({ id: 'editorial-route-halo', type: 'line', source: 'editorial-route', paint: { 'line-color': '#f7faf9', 'line-width': 7, 'line-opacity': .88 } });
        map.addLayer({ id: 'editorial-route', type: 'line', source: 'editorial-route', paint: { 'line-color': '#c2410c', 'line-width': 4 } });
      }
      const bounds = new maplibregl.LngLatBounds();
      data.points.forEach((point: any, index: number) => {
        bounds.extend([point.lon, point.lat]);
        const marker = document.createElement(point.href ? 'a' : 'span');
        marker.className = `charter-map__marker charter-map__marker--${point.kind}`;
        marker.textContent = data.mode === 'route' ? String(index + 1) : '';
        marker.setAttribute('aria-label', point.label);
        marker.setAttribute('title', point.label);
        if (point.href) (marker as HTMLAnchorElement).href = point.href;
        new maplibregl.Marker({ element: marker, anchor: 'center' }).setLngLat([point.lon, point.lat]).setPopup(new maplibregl.Popup({ offset: 18 }).setText(point.label)).addTo(map);
      });
      if (data.mode !== 'marina') map.fitBounds(bounds, { padding: 68, maxZoom: 9.3, duration: 0 });
      fallback?.setAttribute('hidden', '');
      root.dataset.mapReady = 'true';
    });
  });
</script>

<style>
  .charter-map{display:grid;gap:22px;width:100%;min-width:0}.charter-map__head{display:grid;grid-template-columns:minmax(0,1fr) minmax(150px,240px);gap:32px;align-items:end}.charter-map__head h2{max-width:18ch;margin:8px 0 10px;color:var(--ds-ink);font:400 clamp(32px,4vw,54px)/1.06 'Tenor Sans',sans-serif}.charter-map__head p{max-width:66ch;margin:0;color:var(--ds-muted);font-size:17px;line-height:1.65}.charter-map__head>span{color:var(--ds-muted);font:700 11px/1.4 ui-monospace,monospace;text-align:right;text-transform:uppercase;letter-spacing:.08em}.charter-map__viewport{position:relative;width:100%;height:clamp(420px,58vw,650px);overflow:hidden;border:1px solid var(--ds-line);border-radius:18px;background:#dceff4;box-shadow:0 18px 50px rgba(7,55,70,.1)}.charter-map--marina .charter-map__viewport{height:clamp(390px,50vw,570px)}.charter-map__fallback,.charter-map__canvas{position:absolute;inset:0;width:100%;height:100%;border:0}.charter-map__fallback[hidden]{display:none}.charter-map__places{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}.charter-map__places>a,.charter-map__places>span{display:flex;min-width:0;min-height:54px;align-items:center;gap:9px;padding:10px 12px;border:1px solid var(--ds-line);border-radius:14px;background:var(--ds-paper);color:var(--ds-ink);text-decoration:none}.charter-map__places a:hover,.charter-map__places a:focus-visible{border-color:var(--ds-accent-text);outline:2px solid transparent}.charter-map__places b{color:var(--ds-accent-text)}.charter-map__places small{margin-left:auto;color:var(--ds-muted)}.charter-map__credit{margin:0;color:var(--ds-muted);font-size:12px}.charter-map__credit a{color:inherit}.charter-map :global(.charter-map__marker){display:grid;width:30px;height:30px;place-items:center;border:3px solid #fff;border-radius:50%;background:var(--ds-ink);box-shadow:0 4px 16px rgba(7,55,70,.32);color:#fff;font:700 12px Arial,sans-serif;text-decoration:none;cursor:pointer}.charter-map :global(.charter-map__marker--marina){width:36px;height:36px;background:var(--ds-accent-text)}.charter-map :global(.maplibregl-popup-content){padding:10px 14px;border-radius:10px;color:var(--ds-ink);font:700 13px Arial,sans-serif}.charter-map :global(.maplibregl-ctrl-attrib){font-size:10px}@media(max-width:760px){.charter-map__head{grid-template-columns:1fr;gap:12px}.charter-map__head>span{text-align:left}.charter-map__viewport{height:460px}.charter-map__places{grid-template-columns:1fr 1fr}}@media(max-width:480px){.charter-map__viewport{height:420px;border-radius:14px}.charter-map__places{grid-template-columns:1fr}.charter-map__places small{display:none}}
</style>
