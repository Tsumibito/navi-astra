---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/design-system/Hero.astro';
import Section from '~/components/design-system/Section.astro';
import YachtSearch from '~/components/YachtSearch.astro';
import YachtRail from '~/components/YachtRail.astro';
import GeographyMap from '~/components/GeographyMap.astro';
import { geographyCopy, routeLegs, saronicPoints, type PilotLocale } from '~/data/geography/saronic-pilot';
import { getRouteById } from '~/lib/charter/routes';
import { defaultSearchState } from '~/lib/charter/search';
import { getPilotYachtsByScope } from '~/lib/charter/pilotInventory';

interface Props { locale: PilotLocale; kind: 'region' | 'route'; }
const { locale, kind } = Astro.props as Props;
const isRoute = kind === 'route';
const copy = geographyCopy[locale][kind] as any;
const scopeId = isRoute ? 'marina:alimos-marina' : 'region:saronic-gulf';
const routeIntent = getRouteById(scopeId) ?? getRouteById(isRoute ? 'marina:alimos-marina' : 'locality:athens');
const yachts = getPilotYachtsByScope(isRoute ? 'marina:alimos-marina' : 'locality:athens');
const initialSearch = routeIntent ? defaultSearchState(routeIntent, locale) : null;
const now = new Date();
const minDate = now.toISOString().slice(0, 10);
const maxDate = new Date(now.getTime() + 365 * 86400000).toISOString().slice(0, 10);
const paths = isRoute
  ? { ru: '/ru/yacht-routes/greece/saronic-gulf/alimos-aegina-poros-hydra/', ua: '/ua/yacht-routes/greece/saronic-gulf/alimos-aegina-poros-hydra/', en: '/en/yacht-routes/greece/saronic-gulf/alimos-aegina-poros-hydra/' }
  : { ru: '/ru/yacht-charter/greece/saronic-gulf/', ua: '/ua/yacht-charter/greece/saronic-gulf/', en: '/en/yacht-charter/greece/saronic-gulf/' };
const canonical = `https://navi.training${paths[locale]}`;
const regionPath = `/${locale}/yacht-charter/greece/saronic-gulf/`;
const marinaPath = `/${locale}/yacht-charter/greece/athens/alimos-marina/`;
const routePath = `/${locale}/yacht-routes/greece/saronic-gulf/alimos-aegina-poros-hydra/`;
const title = copy.title;
const description = copy.lead;
const heroAlt = locale === 'ru' ? 'Острова и море Саронического залива с воздуха' : locale === 'ua' ? 'Острови та море Саронічної затоки з повітря' : 'Aerial view of the islands and sea of the Saronic Gulf';
const preloadImage = { href: '/media/heroes/saronic-gulf-640.avif', type: 'image/avif', srcset: [640, 960, 1280, 1920].map((width) => `/media/heroes/saronic-gulf-${width}.avif ${width}w`).join(', '), sizes: '100vw' };
const routeLabels = Object.fromEntries(saronicPoints.map((point) => [point.id, point.labels[locale]]));
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebPage', '@id': `${canonical}#page`, url: canonical, name: title, description },
    ...(!isRoute ? [{ '@type': 'Place', '@id': `${canonical}#place`, name: title, containedInPlace: { '@type': 'Country', name: 'Greece' } }] : []),
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: locale === 'ru' ? 'Аренда яхт' : locale === 'ua' ? 'Оренда яхт' : 'Yacht charter', item: `https://navi.training/${locale}/charter/` },
      { '@type': 'ListItem', position: 2, name: locale === 'ru' ? 'Саронический залив' : locale === 'ua' ? 'Саронічна затока' : 'Saronic Gulf', item: `https://navi.training${regionPath}` },
      ...(isRoute ? [{ '@type': 'ListItem', position: 3, name: title, item: canonical }] : []),
    ] },
    ...(isRoute ? [{ '@type': 'ItemList', name: title, itemListElement: saronicPoints.map((point, index) => ({ '@type': 'ListItem', position: index + 1, name: point.labels[locale] })) }] : []),
  ],
};
---
<BaseLayout fullBleed locale={locale} title={title} description={description} canonical={canonical} languageHrefs={paths} structuredData={structuredData} noindex={true} preloadImage={preloadImage} leadForm={{ service: isRoute ? 'yacht-route-request' : 'yacht-charter', context: { route_id: isRoute ? 'route:saronic-week-from-alimos' : 'region:saronic-gulf', departure_marina: 'marina:alimos-marina' } }}>
  <Hero variant="cinematic" image="/media/heroes/saronic-gulf-1920.jpg" imageBaseName="saronic-gulf" imageWidths={[640, 960, 1280, 1920]} imageAlt={heroAlt} imagePosition="center 54%" imageOverlay="linear-gradient(90deg, rgba(3,30,40,.86) 0%, rgba(3,30,40,.55) 48%, rgba(3,30,40,.2) 100%)" eyebrow={copy.eyebrow} title={copy.title} description={copy.lead} align="left">
    <div slot="actions" class="geo-actions"><a class="ds-button ds-button--primary" href={isRoute ? marinaPath : '#yacht-search'}>{copy.cta}</a><a class="ds-button ds-button--secondary" href={isRoute ? regionPath : routePath}>{isRoute ? (locale === 'ru' ? 'О регионе' : locale === 'ua' ? 'Про регіон' : 'About the region') : copy.routeTitle}</a></div>
  </Hero>

  <Section surface="mist" width="wide" radius="feature" stacked class="geo-intro"><div class="geo-intro__grid"><h2>{isRoute ? (locale === 'ru' ? 'Основа, а не жёсткий план' : locale === 'ua' ? 'Основа, а не жорсткий план' : 'A framework, not a fixed plan') : copy.characterTitle}</h2><div><p>{copy.intro}</p>{!isRoute && <p>{copy.character}</p>}</div></div></Section>

  <Section surface="paper" width="wide" radius="feature" stacked><GeographyMap locale={locale} mode={isRoute ? 'route' : 'region'} title={copy.title} intro={copy.disclaimer} /></Section>

  {isRoute && <Section surface="mist" width="wide" radius="feature" stacked><div class="route-grid"><div><p class="ds-eyebrow">7 DAYS · 86 NM</p><h2>{locale === 'ru' ? 'План по дням' : locale === 'ua' ? 'План за днями' : 'Day-by-day outline'}</h2><ol>{copy.itinerary.map((day: string, index: number) => <li><span>{String(index + 1).padStart(2, '0')}</span><p>{day}</p></li>)}</ol></div><div class="route-legs"><h3>{locale === 'ru' ? 'Переходы' : locale === 'ua' ? 'Переходи' : 'Passages'}</h3>{routeLegs.map((leg) => <p><span>{routeLabels[leg.from]} → {routeLabels[leg.to]}</span><strong>{leg.nm} NM</strong></p>)}</div></div></Section>}

  <div id="yacht-search">{routeIntent && initialSearch && <YachtSearch locale={locale} route={routeIntent} initialState={initialSearch} minDate={minDate} maxDate={maxDate} />}</div>
  <YachtRail yachts={yachts} locale={locale} searchState={initialSearch} title={copy.yachts} empty={locale === 'ru' ? 'Для выбранных параметров пока нет опубликованных карточек.' : locale === 'ua' ? 'Для вибраних параметрів поки немає опублікованих карток.' : 'No published yacht cards match these parameters yet.'} />

  <Section surface="sea" width="wide" radius="feature" stacked class="geo-final"><div><p class="ds-eyebrow">NAVI.TRAINING · LA ROCHELLE / ATHENS</p><h2>{copy.cta}</h2><p>{copy.disclaimer}</p><button type="button" class="ds-button ds-button--accent" data-open-service-form data-service={isRoute ? 'yacht-route-request' : 'yacht-charter'}>{copy.cta}</button></div></Section>
</BaseLayout>

<style>
  .geo-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:28px}.geo-intro__grid{display:grid;grid-template-columns:minmax(0,.7fr) minmax(0,1.3fr);gap:clamp(32px,7vw,100px)}.geo-intro h2,.route-grid h2,.geo-final h2{margin:0;font:400 clamp(36px,5vw,64px)/1.05 'Tenor Sans',sans-serif}.geo-intro p,.geo-final p{font-size:18px;line-height:1.75}.route-grid{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(280px,.7fr);gap:64px}.route-grid ol{list-style:none;margin:32px 0 0;padding:0;border-top:1px solid rgba(7,55,70,.16)}.route-grid li{display:grid;grid-template-columns:48px 1fr;gap:16px;padding:17px 0;border-bottom:1px solid rgba(7,55,70,.16)}.route-grid li span{color:#d97706;font:700 12px ui-monospace,monospace}.route-grid li p{margin:0}.route-legs{align-self:start;padding:26px;background:#f7faf9;border:1px solid rgba(7,55,70,.16);border-radius:18px}.route-legs h3{margin-top:0}.route-legs p{display:flex;justify-content:space-between;gap:16px;padding:12px 0;margin:0;border-top:1px solid rgba(7,55,70,.12)}.route-legs strong{white-space:nowrap;color:#d97706}.geo-final{color:#fff}.geo-final>div{max-width:780px}.geo-final p{color:rgba(255,255,255,.82)}@media(max-width:760px){.geo-intro__grid,.route-grid{grid-template-columns:1fr;gap:28px}.geo-actions{align-items:stretch;flex-direction:column}.geo-actions a{text-align:center}}
</style>
