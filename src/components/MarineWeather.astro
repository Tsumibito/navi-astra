---
interface Props { locale: 'ru' | 'ua' | 'en'; place?: 'alimos' | 'saronic'; latitude?: number; longitude?: number; title?: string }
const { locale, place = 'alimos', latitude = 37.914, longitude = 23.700, title } = Astro.props;
const copy = {
  ru: { eyebrow:'Прогноз на 7 дней', alimos:'Морская погода в Алимосе', saronic:'Погода в Сароническом заливе', loading:'Загружаем прогноз…', unavailable:'Прогноз сейчас недоступен — откройте источник перед выходом.', wave:'Волна', period:'Период', temperature:'Море', wind:'Ветер', gust:'Порывы', rain:'Осадки', source:'Open-Meteo Marine и Weather API', note:'Справочная информация, не для навигации. Перед выходом проверьте официальный морской прогноз, предупреждения и указания портовых властей.' },
  ua: { eyebrow:'Прогноз на 7 днів', alimos:'Морська погода в Алімосі', saronic:'Погода в Саронічній затоці', loading:'Завантажуємо прогноз…', unavailable:'Прогноз зараз недоступний — відкрийте джерело перед виходом.', wave:'Хвиля', period:'Період', temperature:'Море', wind:'Вітер', gust:'Пориви', rain:'Опади', source:'Open-Meteo Marine та Weather API', note:'Довідкова інформація, не для навігації. Перед виходом перевірте офіційний морський прогноз, попередження та вказівки портової влади.' },
  en: { eyebrow:'Seven-day outlook', alimos:'Marine weather at Alimos', saronic:'Weather in the Saronic Gulf', loading:'Loading forecast…', unavailable:'The forecast is unavailable — open the source before departure.', wave:'Wave', period:'Period', temperature:'Sea', wind:'Wind', gust:'Gusts', rain:'Rain', source:'Open-Meteo Marine and Weather APIs', note:'For planning only, not navigation. Check official marine forecasts, warnings and port authority instructions before departure.' },
}[locale];
---
<div class="weather" data-marine-weather data-latitude={latitude} data-longitude={longitude} data-locale={locale} data-unavailable={copy.unavailable}>
  <header><div><p class="weather__eyebrow">{copy.eyebrow}</p><h2>{title ?? (place === 'saronic' ? copy.saronic : copy.alimos)}</h2></div><div class="weather__summary"><span class="weather__wind-icon" data-weather-icon aria-hidden="true">≈</span><p class="weather__status" data-weather-status>{copy.loading}</p><strong data-weather-condition></strong></div></header>
  <div class="weather__days" data-weather-days aria-label={copy.eyebrow}></div>
  <div class="weather__values" data-weather-values hidden>
    <div><strong data-weather-value="wind">—</strong><span>{copy.wind}</span></div><div><strong data-weather-value="gust">—</strong><span>{copy.gust}</span></div><div><strong data-weather-value="rain">—</strong><span>{copy.rain}</span></div><div><strong data-weather-value="wave">—</strong><span>{copy.wave}</span></div><div><strong data-weather-value="period">—</strong><span>{copy.period}</span></div><div><strong data-weather-value="temperature">—</strong><span>{copy.temperature}</span></div>
  </div>
  <footer><a href="https://open-meteo.com/en/docs/marine-weather-api" target="_blank" rel="external noopener">{copy.source} ↗</a><p>{copy.note}</p></footer>
</div>
<script>
  type Day = { date:string; wind:number|null; gust:number|null; rain:number|null; wave:number|null; period:number|null; temperature:number|null };
  const at = (items: unknown, i: number) => Array.isArray(items) && typeof items[i] === 'number' ? items[i] as number : null;
  for (const root of document.querySelectorAll<HTMLElement>('[data-marine-weather]')) {
    const status=root.querySelector<HTMLElement>('[data-weather-status]'); const condition=root.querySelector<HTMLElement>('[data-weather-condition]'); const icon=root.querySelector<HTMLElement>('[data-weather-icon]'); const values=root.querySelector<HTMLElement>('[data-weather-values]'); const daysRoot=root.querySelector<HTMLElement>('[data-weather-days]');
    const lat=root.dataset.latitude; const lon=root.dataset.longitude;
    const marine=`https://marine-api.open-meteo.com/v1/marine?latitude=${lat}&longitude=${lon}&daily=wave_height_max,wave_period_max,sea_surface_temperature_mean&forecast_days=7&timezone=Europe%2FAthens`;
    const weather=`https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&daily=wind_speed_10m_max,wind_gusts_10m_max,precipitation_sum&wind_speed_unit=kn&forecast_days=7&timezone=Europe%2FAthens`;
    Promise.all([fetch(marine),fetch(weather)]).then(async ([m,w])=>{if(!m.ok||!w.ok)throw new Error('weather');return [await m.json(),await w.json()]}).then(([m,w])=>{
      const dates=(m.daily?.time ?? w.daily?.time ?? []) as string[];
      const forecast:Day[]=dates.map((date,i)=>({date,wind:at(w.daily?.wind_speed_10m_max,i),gust:at(w.daily?.wind_gusts_10m_max,i),rain:at(w.daily?.precipitation_sum,i),wave:at(m.daily?.wave_height_max,i),period:at(m.daily?.wave_period_max,i),temperature:at(m.daily?.sea_surface_temperature_mean,i)}));
      const locale=root.dataset.locale==='ua'?'uk':root.dataset.locale||'en';
      const strength=(wind:number|null)=>wind==null?0:wind<7?1:wind<15?2:wind<22?3:4;
      const conditionLabels={ru:['Штиль','Слабый ветер','Умеренный ветер','Свежий ветер','Сильный ветер'],ua:['Штиль','Слабкий вітер','Помірний вітер','Свіжий вітер','Сильний вітер'],en:['Calm','Light wind','Moderate wind','Fresh wind','Strong wind']}[root.dataset.locale as 'ru'|'ua'|'en']||['Calm','Light wind','Moderate wind','Fresh wind','Strong wind'];
      const render=(day:Day,index:number)=>{ root.querySelectorAll<HTMLElement>('[data-weather-value]').forEach((node)=>{const key=node.dataset.weatherValue as keyof Day;const value=day[key] as number|null;const unit=key==='wind'||key==='gust'?' kn':key==='rain'?' mm':key==='wave'?' m':key==='period'?' s':key==='temperature'?' °C':'';node.textContent=value==null?'—':`${Math.round(value*10)/10}${unit}`}); root.querySelectorAll<HTMLButtonElement>('.weather__day').forEach((button,i)=>{button.setAttribute('aria-pressed',String(i===index))}); const level=strength(day.wind); if(icon){icon.textContent=level<2?'≈':level===2?'↝':level===3?'➜':'➜➜';icon.dataset.strength=String(level)} if(condition)condition.textContent=conditionLabels[level]; if(status)status.textContent=new Date(`${day.date}T12:00:00`).toLocaleDateString(locale,{weekday:'long',day:'numeric',month:'long'}); };
      forecast.forEach((day,index)=>{const button=document.createElement('button');button.type='button';button.className='weather__day';const date=new Date(`${day.date}T12:00:00`);button.innerHTML=`<span>${date.toLocaleDateString(locale,{weekday:'short'})}</span><strong>${date.toLocaleDateString(locale,{day:'numeric',month:'short'})}</strong><small>${day.wind==null?'—':Math.round(day.wind)+' kn'}</small>`;button.addEventListener('click',()=>render(day,index));daysRoot?.appendChild(button)});
      if(forecast[0]){render(forecast[0],0);if(values)values.hidden=false}else throw new Error('empty');
    }).catch(()=>{if(status)status.textContent=root.dataset.unavailable||''});
  }
</script>
<style>
  .weather{display:grid;gap:24px;padding:clamp(30px,5vw,64px);border-radius:32px;background:#073746;color:#fff}.weather header{display:flex;justify-content:space-between;gap:28px;align-items:end}.weather__eyebrow{margin:0 0 12px;color:#ffb24a;font:700 12px/1.2 Arial,sans-serif;letter-spacing:.14em;text-transform:uppercase}h2{margin:0;font:400 clamp(34px,4vw,58px)/1.02 'Tenor Sans',sans-serif}.weather__summary{display:grid;grid-template-columns:auto 1fr;gap:0 12px;align-items:center;min-width:240px}.weather__wind-icon{grid-row:1/3;display:grid;width:58px;height:58px;place-items:center;border-radius:50%;background:#ffb24a;color:#073746;font-size:22px;font-weight:800}.weather__wind-icon[data-strength="4"]{background:#ff7a59}.weather__status{margin:0;color:#fff;text-transform:capitalize}.weather__summary strong{color:#aacbd3;font-size:13px}.weather__days{display:grid;grid-template-columns:repeat(7,1fr);gap:8px}.weather__day{display:grid;gap:5px;min-height:86px;padding:10px 6px;border:1px solid rgba(255,255,255,.2);border-radius:14px;background:rgba(255,255,255,.06);color:#fff;cursor:pointer}.weather__day span,.weather__day small{color:#aacbd3;font-size:11px;text-transform:uppercase}.weather__day strong{font-size:15px}.weather__day[aria-pressed="true"]{border-color:#ffb24a;background:#ffb24a;color:#073746;box-shadow:0 8px 24px rgba(0,0,0,.18)}.weather__day[aria-pressed="true"] span,.weather__day[aria-pressed="true"] small{color:#073746}.weather__values{display:grid;grid-template-columns:repeat(6,1fr);gap:10px}.weather__values div{padding:18px 12px;border:1px solid rgba(255,255,255,.18);border-radius:16px;background:rgba(255,255,255,.06)}.weather__values strong,.weather__values span{display:block}.weather__values strong{font:400 clamp(23px,2.6vw,34px)/1 'Tenor Sans',sans-serif;color:#ffb24a}.weather__values span{margin-top:9px;color:#c9e3e9;font-size:13px}footer{padding-top:18px;border-top:1px solid rgba(255,255,255,.15)}footer a{color:#fff;font-weight:700}footer p{max-width:90ch;margin:10px 0 0;color:#aacbd3;font-size:13px;line-height:1.5}@media(max-width:800px){.weather{border-radius:24px}.weather header{display:grid}.weather__summary{min-width:0}.weather__days{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;padding-bottom:8px}.weather__day{min-width:92px;scroll-snap-align:start}.weather__values{grid-template-columns:repeat(2,1fr)}}
</style>
