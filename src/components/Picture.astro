---
import dimsRaw from '../data/image-dims.json';
const dims = dimsRaw as Record<string, { width?: number; height?: number; webp?: string }>;

interface Props {
  src: string;
  alt: string;
  width?: number | string;
  height?: number | string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'auto' | 'low';
  decoding?: 'async' | 'auto' | 'sync';
  class?: string;
}

const { src, alt, width, height, loading = 'lazy', fetchpriority, decoding = 'async', class: className } = Astro.props;
const info = dims[src];
const w = width ?? info?.width;
const h = height ?? info?.height;
const webp = info?.webp || `${src}.webp`;
---
{info ? (
  <picture>
    <source srcset={webp} type="image/webp" />
    <img src={src} alt={alt} width={w} height={h} loading={loading} fetchpriority={fetchpriority} decoding={decoding} class={className} />
  </picture>
) : (
  <img src={src} alt={alt} width={w} height={h} loading={loading} fetchpriority={fetchpriority} decoding={decoding} class={className} />
)}
