---
/**
 * Global lead-form modal using the native <dialog> element. Opened by any
 * element with [data-open-service-form], which gets commandfor/command="show-modal"
 * progressively in supported browsers. The click handler remains as a JS fallback.
 * Works on any layout because styles are embedded globally.
 */
interface ContextField {
  [key: string]: string | null | undefined;
}
const { service = 'general', locale = 'ru', title, intro, button, context = {} } = Astro.props as { service?: string; locale?: string; title?: string; intro?: string; button?: string; context?: ContextField };
const t = locale === 'ua' ? { step:'Перший крок', name:'Як до вас звертатися', phone:'Телефон або месенджер', email:'E-mail', location:'Де знаходиться яхта', message:'Розкажіть про яхту та задачу', consent:'Я погоджуюся з', privacy:'політикою конфіденційності', close:'Закрити форму', sending:'Надсилаємо…', success:'Запит прийнято', successText:'Вивчу деталі та зв’яжуся з вами, щоб обговорити яхту й наступні кроки.', error:'Не вдалося надіслати. Напишіть на alex@navi.training або спробуйте ще раз.', title:'Залишити заявку', intro:'Час узяти курс на пригоди! Розкажіть, чим ми можемо допомогти, і ми звʼяжемося з вами найближчим часом.', button:'Відправити' } : locale === 'en' ? { step:'First step', name:'Your name', phone:'Phone or messenger', email:'Email', location:'Where is the yacht?', message:'Tell us about the yacht and your plans', consent:'I agree to the', privacy:'privacy policy', close:'Close form', sending:'Sending…', success:'Request received', successText:'I will review the details and contact you to discuss the yacht and next steps.', error:'Could not send. Email alex@navi.training or try again.', title:'Submit a request', intro:"It's time to set a course for adventure! Tell us how we can help and we will get back to you shortly.", button:'Submit' } : { step:'Первый шаг', name:'Как к вам обращаться', phone:'Телефон или мессенджер', email:'E-mail', location:'Где находится яхта', message:'Расскажите о яхте и задаче', consent:'Я согласен с', privacy:'политикой конфиденциальности', close:'Закрыть форму', sending:'Отправляем…', success:'Запрос принят', successText:'Изучу вводные и свяжусь с вами, чтобы обсудить яхту и следующие шаги.', error:'Не удалось отправить. Напишите на alex@navi.training или попробуйте ещё раз.', title:'Оставить заявку', intro:'Пора взять курс на приключения! Расскажите, чем мы можем помочь, и мы свяжемся с вами в ближайшее время.', button:'Отправить' };
const formTitle = title || t.title;
const formIntro = intro || t.intro;
const formButton = button || t.button;
const privacyHref = `/${locale}/privacy-policy/`;
const isYachtBooking = service.startsWith('yacht-charter') && Boolean(context.yacht_id);
const bookingCopy = locale === 'ua' ? {
  eyebrow:'Запит на конкретну яхту', bookTitle:'Забронювати цю яхту', holdTitle:'Опція на 48 годин',
  bookIntro:'Перевіримо доступність і ціну у чартерної компанії. Оплата — лише після підтвердження.',
  holdIntro:'Зафіксуємо яхту, дати й ціну на 48 годин. €20 сплачуються після підтвердження доступності та зараховуються в оплату бронювання.',
  dates:'Дати', guests:'Гостей', adults:'Дорослих', children:'Дітей', charter:'Формат чартеру',
  bareboat:'Без шкіпера', skippered:'Зі шкіпером', qualification:'Кваліфікація шкіпера',
  qualificationHint:'ICC, RYA Day Skipper або інший сертифікат. Якщо не впевнені — так і напишіть.',
  contact:'Контактні дані', comment:'Побажання та запитання', summary:'Ваш запит',
  price:'Ціна в каталозі на дату спостереження', extras:'Обов’язкові доплати розрахуємо за складом екіпажу',
  availability:'Доступність і остаточна вартість підтверджуються перед оплатою.',
  holdTerms:'€20 не списуються зараз. Після підтвердження ми надішлемо захищене посилання на оплату. Сума зараховується в бронювання; якщо яхта недоступна — оплата повертається.',
  submitBook:'Перевірити й забронювати', submitHold:'Запросити опцію на 48 годин',
} : locale === 'en' ? {
  eyebrow:'Request for this yacht', bookTitle:'Book this yacht', holdTitle:'Hold for 48 hours',
  bookIntro:'We will recheck availability and price with the charter company. No payment is taken before confirmation.',
  holdIntro:'Hold this yacht, dates and price for 48 hours. The €20 is paid after availability is confirmed and counts towards your booking.',
  dates:'Dates', guests:'Guests', adults:'Adults', children:'Children', charter:'Charter format',
  bareboat:'Bareboat', skippered:'With skipper', qualification:'Skipper qualification',
  qualificationHint:'ICC, RYA Day Skipper or another certificate. If unsure, just say so.',
  contact:'Contact details', comment:'Requests and questions', summary:'Your request',
  price:'Observed charter price', extras:'Obligatory extras will be calculated for your crew',
  availability:'Availability and final price are confirmed before payment.',
  holdTerms:'No €20 payment is taken now. Once availability is confirmed, we will send a secure payment link. It is credited to the booking; if the yacht is unavailable, it is refunded.',
  submitBook:'Check and book', submitHold:'Request a 48-hour hold',
} : {
  eyebrow:'Запрос на конкретную яхту', bookTitle:'Забронировать эту яхту', holdTitle:'Опция на 48 часов',
  bookIntro:'Проверим доступность и цену у чартерной компании. Оплата — только после подтверждения.',
  holdIntro:'Зафиксируем яхту, даты и цену на 48 часов. €20 оплачиваются после подтверждения доступности и засчитываются в стоимость бронирования.',
  dates:'Даты', guests:'Гости', adults:'Взрослые', children:'Дети', charter:'Формат чартера',
  bareboat:'Без шкипера', skippered:'Со шкипером', qualification:'Квалификация шкипера',
  qualificationHint:'ICC, RYA Day Skipper или другой сертификат. Если не уверены — так и напишите.',
  contact:'Контактные данные', comment:'Пожелания и вопросы', summary:'Ваш запрос',
  price:'Цена в каталоге на дату наблюдения', extras:'Обязательные доплаты рассчитаем по составу экипажа',
  availability:'Доступность и итоговая стоимость подтверждаются перед оплатой.',
  holdTerms:'€20 сейчас не списываются. После подтверждения мы пришлём защищённую ссылку на оплату. Сумма засчитывается в бронирование; если яхта недоступна — платёж возвращается.',
  submitBook:'Проверить и забронировать', submitHold:'Запросить опцию на 48 часов',
};
---
<dialog class="service-modal" data-service-modal id="service-modal" aria-modal="true" aria-labelledby="service-form-title">
  <section class="service-modal__card">
    <button class="service-modal__close" type="button" data-close-service-form aria-label={t.close}>×</button>
    <form class:list={["service-form", isYachtBooking && "service-form--booking"]} data-service-lead data-service={service} data-yacht-booking={isYachtBooking ? '' : undefined} aria-describedby="service-form-status">
      {Object.entries(context).map(([key, value]) => value !== undefined && value !== null ? <input type="hidden" name={key} value={value} data-context /> : null)}
      {isYachtBooking && <input type="hidden" name="booking_action" value="booking" data-booking-action data-context />}
      <div class="form-heading">
        <p class="eyebrow">{isYachtBooking ? bookingCopy.eyebrow : t.step}</p>
        <h2 id="service-form-title" data-modal-title>{isYachtBooking ? bookingCopy.bookTitle : formTitle}</h2>
        <p data-modal-intro>{isYachtBooking ? bookingCopy.bookIntro : formIntro}</p>
        {isYachtBooking && <div class="booking-summary">
          <p><strong>{context.yacht_name}</strong></p>
          <p>{bookingCopy.dates}: <strong>{context.offer_start || '—'} — {context.offer_end || '—'}</strong></p>
          <p>{bookingCopy.price}: <strong>{context.final_price || '—'} {context.currency}</strong></p>
          <span>{bookingCopy.availability}</span>
        </div>}
      </div>
      <div class="form-grid">
        {isYachtBooking && <>
          <p class="form-section-title form-wide">{bookingCopy.guests}</p>
          <label><span>{bookingCopy.adults}</span><input name="adults" type="number" min="1" max="24" value="2" required /></label>
          <label><span>{bookingCopy.children}</span><input name="children" type="number" min="0" max="24" value="0" /></label>
          <label class="form-wide"><span>{bookingCopy.charter}</span><select name="charter_format" data-charter-format><option value="bareboat">{bookingCopy.bareboat}</option><option value="skippered">{bookingCopy.skippered}</option></select></label>
          <label class="form-wide" data-qualification-field><span>{bookingCopy.qualification}</span><textarea name="skipper_qualification" rows="2" placeholder={bookingCopy.qualificationHint}></textarea></label>
          <p class="form-section-title form-wide">{bookingCopy.contact}</p>
        </>}
        <label><span>{t.name}</span><input name="name" autocomplete="name" required /></label><label><span>{t.phone}</span><input name="phone" type="tel" autocomplete="tel" required /></label>
        <label><span>{t.email}</span><input name="email" type="email" autocomplete="email" required /></label>{!isYachtBooking && <label><span>{t.location}</span><input name="location" autocomplete="address-level2" /></label>}
        <label class="form-wide"><span>{isYachtBooking ? bookingCopy.comment : t.message}</span><textarea name="message" rows="4" required={!isYachtBooking}></textarea></label><input class="form-trap" name="company" aria-label="Company" tabindex="-1" autocomplete="off" />
        {isYachtBooking && <div class="booking-terms form-wide" data-booking-terms><strong>{bookingCopy.summary}</strong><p>{bookingCopy.extras}</p><p data-hold-terms hidden>{bookingCopy.holdTerms}</p></div>}
        <label class="form-consent form-wide"><input name="consent" type="checkbox" required /><span>{t.consent} <a href={privacyHref}>{t.privacy}</a></span></label>
        <div class="form-action form-wide"><button type="submit" aria-describedby="service-form-status"><span data-submit-label>{isYachtBooking ? bookingCopy.submitBook : formButton}</span><span aria-hidden="true">↗</span></button><p id="service-form-status" data-form-status aria-live="polite"></p></div>
      </div>
    </form>
  </section>
</dialog>
<style is:global>
  /* Lock body scroll when a dialog is open; keep the class for the newsletter overlay. */
  body:has(dialog[open]){overflow:hidden}
  .navi-modal-open{overflow:hidden}

  .service-modal:not([open]) { display:none }
  .service-modal[open] { display:grid }
  .service-modal { box-sizing:border-box; margin:auto; padding:20px; width:100%; max-width:100%; border:0; background:transparent; color:inherit; place-items:center; opacity:0; transform:translateY(18px); transition:opacity .22s ease, transform .22s ease }
  .service-modal.is-open { opacity:1; transform:translateY(0) }
  .service-modal::backdrop { background:rgba(3,29,38,.76); backdrop-filter:blur(7px); opacity:0; transition:opacity .22s ease }
  .service-modal.is-open::backdrop { opacity:1 }

  .service-modal__card { position:relative; width:min(980px,calc(100vw - 32px)); max-height:calc(100vh - 40px); overflow:auto; padding:clamp(32px,5vw,66px); box-sizing:border-box; background:var(--ds-paper,#f7faf9); color:var(--ds-ink,#073746); box-shadow:0 28px 90px rgba(3,29,38,.28); border-radius:var(--ds-radius-feature,24px) }
  .service-modal__close { position:absolute; top:17px; right:20px; width:44px; height:44px; display:grid; place-items:center; border:1px solid var(--ds-line,rgba(7,55,70,.16)); background:transparent; color:var(--ds-ink,#073746); font-size:30px; line-height:1; cursor:pointer; border-radius:9px }
  .service-modal .eyebrow { margin:0 0 20px; color:var(--ds-accent,#d97706); font:700 12px/1.4 Arial,sans-serif; letter-spacing:.18em; text-transform:uppercase }
  .service-modal .service-form { display:grid; grid-template-columns:.8fr 1.2fr; gap:60px }
  .service-modal .form-heading h2 { margin:0 0 25px; color:var(--ds-ink,#073746); font:400 clamp(38px,4vw,58px)/1.05 'Tenor Sans',serif }
  .service-modal .form-heading>p:last-child { margin:0; color:#476773; line-height:1.7 }
  .service-modal .form-grid { display:grid; grid-template-columns:1fr 1fr; gap:24px }
  .service-modal .service-form label { display:flex; flex-direction:column; gap:9px }
  .service-modal .service-form label>span { font-size:12px; letter-spacing:.08em; text-transform:uppercase; color:#365e69 }
  .service-modal .service-form input,.service-modal .service-form textarea { width:100%; box-sizing:border-box; border:0; border-bottom:1px solid rgba(7,55,70,.32); border-radius:0; background:transparent; padding:12px 2px; color:var(--ds-ink,#073746); font:16px var(--font-neo,Arial,sans-serif); outline:none }
  .service-modal .service-form select { width:100%; min-height:50px; box-sizing:border-box; border:1px solid var(--ds-line,rgba(7,55,70,.16)); border-radius:10px; background:#fff; padding:12px; color:var(--ds-ink,#073746); font:16px var(--font-neo,Arial,sans-serif) }
  .service-modal .service-form input:focus,.service-modal .service-form textarea:focus { border-color:var(--ds-accent,#d97706) }
  .service-modal .service-form input:user-invalid,.service-modal .service-form textarea:user-invalid { border-color:var(--ds-accent,#d97706) }
  .service-modal .form-wide { grid-column:1/-1 }
  .service-modal .form-trap { position:absolute; left:-9999px }
  .service-modal .form-consent { flex-direction:row !important; align-items:center }
  .service-modal .form-consent input { width:18px; height:18px; accent-color:var(--ds-accent,#d97706) }
  .service-modal .form-consent a { color:var(--ds-ink,#073746) }
  .service-modal .form-action { display:flex; align-items:center; gap:25px }
  .service-modal .form-action button { border:0; background:var(--ds-action,#ffb052); color:#073746; padding:18px 25px; font-weight:700; cursor:pointer; min-width:220px; border-radius:5px }
  .service-modal .form-action p { color:#476773; font-size:13px; margin:0 }
  .service-modal .form-success { grid-column:1/-1; padding:55px; border:1px solid var(--ds-line,rgba(7,55,70,.16)) }
  .service-modal .form-success span { color:var(--ds-accent,#d97706); font-size:40px }
  .service-modal .form-success h2 { font-size:48px; margin:20px 0 12px; font-family:'Tenor Sans',serif; font-weight:400 }
  .service-modal .form-success p { color:#476773 }
  .service-modal .service-form--booking { grid-template-columns:minmax(250px,.72fr) minmax(0,1.28fr); gap:clamp(32px,5vw,64px) }
  .service-modal .booking-summary { margin-top:28px; padding:20px; border-radius:16px; background:var(--ds-mist,#eaf4f4); font-size:14px }
  .service-modal .booking-summary p { margin:0 0 9px; color:var(--ds-ink,#073746) }
  .service-modal .booking-summary span { display:block; margin-top:14px; color:#476773; line-height:1.45 }
  .service-modal .form-section-title { margin:4px 0 -8px; padding-bottom:9px; border-bottom:1px solid var(--ds-line,rgba(7,55,70,.16)); color:var(--ds-ink,#073746); font:400 22px/1.2 'Tenor Sans',serif }
  .service-modal .booking-terms { padding:16px 18px; border-radius:12px; background:var(--ds-mist,#eaf4f4); color:#476773; font-size:14px; line-height:1.5 }
  .service-modal .booking-terms strong { color:var(--ds-ink,#073746) }
  .service-modal .booking-terms p { margin:7px 0 0 }

  @media (max-width:800px){
    .service-modal { inset:0; width:100%; height:var(--navi-modal-height,100dvh); max-height:none; margin:0; padding:max(8px,env(safe-area-inset-top)) 8px max(8px,env(safe-area-inset-bottom)); overflow:hidden; place-items:stretch; transform:none }
    .service-modal__card { width:100%; height:100%; max-height:none; margin:0; overflow-x:hidden; overflow-y:auto; overscroll-behavior:contain; -webkit-overflow-scrolling:touch; scroll-padding-block:76px 120px; padding:64px 20px calc(34px + env(safe-area-inset-bottom)); border-radius:18px; touch-action:pan-y }
    .service-modal__close { position:fixed; top:calc(max(8px,env(safe-area-inset-top)) + 12px); right:20px; z-index:20; width:46px; height:46px; background:rgba(255,255,255,.96); box-shadow:0 4px 18px rgba(3,29,38,.14) }
    .service-modal .service-form { grid-template-columns:1fr; gap:30px }
    .service-modal .form-heading h2 { font-size:clamp(34px,10vw,42px) }
    .service-modal .form-heading>p:last-child { line-height:1.55 }
    .service-modal .form-grid { grid-template-columns:1fr }
    .service-modal .service-form input { min-height:50px }
    .service-modal .form-action { align-items:stretch; flex-direction:column; gap:10px; padding-bottom:8px }
    .service-modal .form-action button { width:100%; min-height:54px }
    .service-modal .service-form textarea { min-height:110px }
  }
</style>
<script define:vars={{ t, locale, bookingCopy }} is:inline>
  const modal = document.querySelector('[data-service-modal]');
  if (modal && !modal.id) modal.id = 'service-modal';

  // Progressive enhancement: commandfor/command for browsers that support Invoker Commands.
  const openers = [...document.querySelectorAll('[data-open-service-form]')];
  openers.forEach((button) => {
    if (!button.getAttribute('commandfor')) {
      button.setAttribute('commandfor', modal.id);
      button.setAttribute('command', 'show-modal');
    }
  });

  const form = modal.querySelector('[data-service-lead]');
  const analytics = (name, parameters = {}) => window.naviAnalytics?.track(name, parameters);
  let formStarted = false;
  form.addEventListener('input', () => {
    if (formStarted) return;
    formStarted = true;
    analytics('form_start', { form_name: 'service_lead', service: form.dataset.service || 'general', locale });
  });
  const syncModalViewport = () => modal?.style.setProperty('--navi-modal-height', `${window.visualViewport?.height || window.innerHeight}px`);
  const openModal = () => {
    if (!modal || modal.open) return;
    document.querySelectorAll('dialog[open]').forEach((dialog) => dialog.close());
    syncModalViewport();
    window.visualViewport?.addEventListener('resize', syncModalViewport);
    modal.showModal();
    requestAnimationFrame(() => modal.classList.add('is-open'));
    if (matchMedia('(min-width: 801px) and (pointer: fine)').matches) setTimeout(() => modal.querySelector('input')?.focus({ preventScroll:true }), 250);
  };
  const closeModal = () => {
    if (!modal || !modal.open) return;
    window.visualViewport?.removeEventListener('resize', syncModalViewport);
    modal.classList.remove('is-open');
    setTimeout(() => modal.close(), 220);
  };

  // Click handler is the JS fallback for browsers without command/commandfor.
  openers.forEach((button) => button.addEventListener('click', () => {
    if (button.dataset.service) form.dataset.service = button.dataset.service;
    analytics('form_open', { form_name: 'service_lead', service: form.dataset.service || 'general', locale });
    if (form.hasAttribute('data-yacht-booking')) {
      const hold = button.dataset.service === 'yacht-charter-hold';
      form.querySelector('[data-booking-action]').value = hold ? 'hold_48h' : 'booking';
      form.querySelector('[data-modal-title]').textContent = hold ? bookingCopy.holdTitle : bookingCopy.bookTitle;
      form.querySelector('[data-modal-intro]').textContent = hold ? bookingCopy.holdIntro : bookingCopy.bookIntro;
      form.querySelector('[data-submit-label]').textContent = hold ? bookingCopy.submitHold : bookingCopy.submitBook;
      form.querySelector('[data-hold-terms]').hidden = !hold;
    }
    openModal();
  }));
  modal.querySelectorAll('[data-close-service-form]').forEach((button) => button.addEventListener('click', (event) => { event.preventDefault(); closeModal(); }));
  modal.addEventListener('cancel', (event) => { event.preventDefault(); closeModal(); });
  modal.addEventListener('click', (event) => {
    if (event.target === modal) closeModal();
  });

  const collectContext = (f) => { const c = {}; f.querySelectorAll('input[type="hidden"][data-context]').forEach((i) => { const input = i; if (input.name) c[input.name] = input.value; }); return c; };

  form.querySelector('[data-charter-format]')?.addEventListener('change', (event) => {
    const field = form.querySelector('[data-qualification-field]');
    if (field) field.hidden = event.target.value !== 'bareboat';
  });

  form.addEventListener('submit', async (event) => { event.preventDefault(); const button=form.querySelector('button[type="submit"]'); const status=form.querySelector('[data-form-status]'); const data=new FormData(form); const submissionId=crypto.randomUUID(); const submittedService=form.dataset.service||'general'; button.disabled=true; status.textContent=t.sending; const context=collectContext(form); if(form.hasAttribute('data-yacht-booking')) { context.adults=data.get('adults'); context.children=data.get('children'); context.charter_format=data.get('charter_format'); context.skipper_qualification=data.get('skipper_qualification'); } try { const response=await fetch('https://forms.navi.training/api/public/leads',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({submissionId,kind:'contact',service:submittedService,firstName:data.get('name'),email:data.get('email'),phone:data.get('phone'),message:form.hasAttribute('data-yacht-booking') ? String(data.get('message')||'') : `${data.get('message')}\n\nLocation: ${data.get('location')||'-'}`,company:data.get('company'),consent:true,locale,sourceUrl:location.href,utm:location.search.slice(1),context})}); if(!response.ok) throw new Error(); analytics('generate_lead',{form_name:'service_lead',service:submittedService,locale}); try { localStorage.setItem('navi-newsletter-state-v1', JSON.stringify({ subscribed:true })); } catch {} form.innerHTML=`<div class="form-success"><span>✓</span><h2>${t.success}</h2><p>${t.successText}</p></div>`; } catch { status.textContent=t.error; button.disabled=false; } });
</script>
