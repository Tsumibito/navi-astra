---
import type { InventoryYacht } from '~/lib/charter/adapter';
import type { SearchState } from '~/lib/charter/search';
import { denormalizeSearchState } from '~/lib/charter/search';
import { getYachtTypeLabel } from '~/lib/charter/routes.ts';
import YachtImage from './YachtImage.astro';

interface Props {
  yacht: InventoryYacht;
  locale: 'ru' | 'ua' | 'en';
  searchState?: SearchState | null;
  isDemo?: boolean;
}

const { yacht, locale, searchState, isDemo = false } = Astro.props;
const t = {
  ru: { view: 'Смотреть яхту', from: 'от', cabins: 'кают', berths: 'мест', heads: 'санузлов', demo: 'Демо' },
  ua: { view: 'Дивитися яхту', from: 'від', cabins: 'кают', berths: 'місць', heads: 'санвузлів', demo: 'Демо' },
  en: { view: 'View yacht', from: 'from', cabins: 'cabins', berths: 'berths', heads: 'heads', demo: 'Demo' },
}[locale];

const baseHref = `/${locale}/yacht-charter/${yacht.regionSlug}/${yacht.slug}/`;
const query = searchState ? denormalizeSearchState(searchState).toString() : '';
const href = baseHref + (query ? `?${query}` : '');
const mainImage = yacht.images[0];

const hasExactOffer =
  !isDemo &&
  searchState?.startDate &&
  searchState?.endDate &&
  yacht.ctaMode === 'exact' &&
  yacht.selectedOffer &&
  yacht.selectedOffer.startDate === searchState.startDate &&
  yacht.selectedOffer.endDate === searchState.endDate;
---

<article
  id={isDemo ? `demo-yacht-${yacht.slug}` : undefined}
  class="yacht-card group flex flex-col bg-white border border-structural-line rounded-2xl overflow-hidden h-full"
  data-yacht-card
  data-boat-type={yacht.vesselClass}
  data-base-id={yacht.baseId}
  data-base-from-ids={JSON.stringify(yacht.baseFromIds)}
  data-is-demo={isDemo}
>
  {isDemo ? (
    <div class="block aspect-[3/2] overflow-hidden bg-slate-100">
      {mainImage ? (
        <YachtImage
          image={mainImage}
          loading="lazy"
          aspect="3/2"
          class="w-full h-full object-cover"
          sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 320px"
        />
      ) : (
        <div class="w-full h-full bg-slate-100" />
      )}
    </div>
  ) : (
    <a
      href={href}
      class="block aspect-[3/2] overflow-hidden bg-slate-100"
      data-yacht-link
      data-yacht-href={baseHref}
      data-locale={locale}
    >
      {mainImage ? (
        <YachtImage
          image={mainImage}
          loading="lazy"
          aspect="3/2"
          class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
          sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 320px"
        />
      ) : (
        <div class="w-full h-full bg-slate-100" />
      )}
    </a>
  )}

  <div class="p-4 flex flex-col gap-2 flex-1">
    <h3 class="font-display text-lg text-deep-sea leading-snug">
      {isDemo ? (
        <span>{yacht.name}</span>
      ) : (
        <a href={href} class="hover:underline focus:underline" data-yacht-link data-yacht-href={baseHref}>{yacht.name}</a>
      )}
      {isDemo && <span class="ml-2 text-xs px-2 py-0.5 bg-amber-100 text-amber-800 rounded-full">{t.demo}</span>}
    </h3>
    {yacht.model && <p class="text-sm text-muted">{yacht.model}{yacht.year ? ` · ${yacht.year}` : ''}</p>}

    <div class="flex flex-wrap gap-2 text-xs text-muted mt-1">
      {yacht.vesselClass && <span class="px-2 py-1 bg-surface-mist rounded-full">{getYachtTypeLabel(yacht.vesselClass, locale)}</span>}
      {yacht.lengthM !== null && <span class="px-2 py-1 bg-surface-mist rounded-full">{yacht.lengthM} m</span>}
      {yacht.cabins !== null && <span class="px-2 py-1 bg-surface-mist rounded-full">{yacht.cabins} {t.cabins}</span>}
      {yacht.berths !== null && <span class="px-2 py-1 bg-surface-mist rounded-full">{yacht.berths} {t.berths}</span>}
    </div>

    {yacht.base && <p class="text-sm text-muted mt-auto">{yacht.base}</p>}

    {yacht.selectedOffer ? (
      <p
        class="font-display text-deep-sea mt-2"
        data-yacht-price
        data-offer-start={yacht.selectedOffer.startDate}
        data-offer-end={yacht.selectedOffer.endDate}
        data-price-eligible={yacht.ctaMode === 'exact'}
        hidden={!hasExactOffer}
      >
        {t.from} {yacht.selectedOffer.finalPrice} {yacht.selectedOffer.currency}
      </p>
    ) : (
      <p class="text-sm text-muted mt-2">{t.view}</p>
    )}
  </div>
</article>
