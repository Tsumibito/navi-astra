---
import type { YachtImage as YachtImageType } from '~/lib/charter/adapter';
import YachtImage from './YachtImage.astro';

interface Props {
  images: YachtImageType[];
  viewImageLabel?: string;
}

const { images, viewImageLabel = 'View image' } = Astro.props;
const main = images[0];
---

{main && (
  <figure class="yacht-gallery" data-gallery="root">
    <div class="yacht-gallery__main relative rounded-2xl overflow-hidden">
      <YachtImage
        image={main}
        loading="eager"
        fetchpriority="high"
        aspect="16/9"
      />
      <figcaption class="sr-only">{main.alt}</figcaption>
    </div>
    {images.length > 1 && (
      <ul class="yacht-gallery__thumbs mt-4 flex gap-2 overflow-x-auto pb-1 min-w-0 max-w-full" aria-label="Yacht images">
        {images.map((image, idx) => (
          <li class="flex-shrink-0">
            <button
              type="button"
              aria-current={idx === 0 ? 'true' : undefined}
              aria-label={`${viewImageLabel} ${idx + 1}`}
              data-gallery-thumb
              data-url={image.url}
              data-alt={image.alt}
              data-width={image.width}
              data-height={image.height}
              class:list={[
                'yacht-gallery__thumb w-20 h-20 rounded-lg overflow-hidden border-2 transition-colors',
                idx === 0 ? 'border-[var(--ds-accent)]' : 'border-transparent hover:border-[var(--ds-line)]',
              ]}
            >
              <YachtImage image={image} loading="eager" aspect="1/1" class="pointer-events-none" />
            </button>
          </li>
        ))}
      </ul>
    )}
  </figure>
)}

<script>
  document.querySelectorAll('[data-gallery="root"]').forEach((root) => {
    const mainImg = root.querySelector('img');
    const caption = root.querySelector('figcaption');
    const buttons = root.querySelectorAll('[data-gallery-thumb]');
    if (!mainImg || !caption) return;

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const data = btn as HTMLElement;
        mainImg.src = data.dataset.url || mainImg.src;
        mainImg.alt = data.dataset.alt || mainImg.alt;
        mainImg.width = Number(data.dataset.width) || mainImg.width;
        mainImg.height = Number(data.dataset.height) || mainImg.height;
        caption.textContent = data.dataset.alt || '';
        buttons.forEach((b) => {
          b.removeAttribute('aria-current');
          b.classList.remove('border-[var(--ds-accent)]');
          b.classList.add('border-transparent');
        });
        btn.setAttribute('aria-current', 'true');
        btn.classList.remove('border-transparent');
        btn.classList.add('border-[var(--ds-accent)]');
      });
    });
  });
</script>
