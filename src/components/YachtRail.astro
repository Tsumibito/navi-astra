---
import type { InventoryYacht } from '~/lib/charter/adapter';
import type { SearchState } from '~/lib/charter/search';
import Section from './design-system/Section.astro';
import YachtCard from './YachtCard.astro';

interface Props {
  yachts: InventoryYacht[];
  locale: 'ru' | 'ua' | 'en';
  title?: string;
  empty?: string;
  searchState?: SearchState | null;
  isDemo?: boolean;
  layout?: 'rail' | 'grid';
  embedded?: boolean;
}

const { yachts, locale, title, empty, searchState, isDemo = false, layout = 'rail', embedded = false } = Astro.props;
---

{embedded ? <div class:list={['yacht-rail', `yacht-rail--${layout}`]}>
  <div data-yacht-rail>
    {title && <h2 class="text-2xl font-display text-deep-sea mb-4">{title}</h2>}
    {yachts.length === 0 ? <p class="text-muted" data-yacht-empty>{empty ?? 'No matching yachts'}</p> : <div class="yacht-rail__track" role="list">{yachts.map((yacht) => <div class="yacht-rail__item" role="listitem"><YachtCard {yacht} {locale} {searchState} {isDemo} /></div>)}</div>}
  </div>
</div> : <Section surface="paper" width="wide" class={`yacht-rail yacht-rail--${layout}`}>
  <div data-yacht-rail>
    {title && <h2 class="text-2xl font-display text-deep-sea mb-4">{title}</h2>}
    {yachts.length === 0 ? (
      <p class="text-muted" data-yacht-empty>{empty ?? 'No matching yachts'}</p>
    ) : (
      <div class="yacht-rail__track" role="list">
        {yachts.map((yacht) => (
          <div class="yacht-rail__item" role="listitem">
            <YachtCard {yacht} {locale} {searchState} {isDemo} />
          </div>
        ))}
      </div>
    )}
  </div>
</Section>}

<style>
  .yacht-rail__track {
    box-sizing: border-box;
    display: flex;
    gap: 16px;
    width: 100%;
    max-width: 100%;
    padding-bottom: 16px;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scroll-snap-type: x mandatory;
  }
  .yacht-rail__item {
    box-sizing: border-box;
    flex: 0 0 min(288px, calc(100vw - 56px));
    min-width: 0;
    scroll-snap-align: start;
  }
  .yacht-rail--grid .yacht-rail__track { display:grid; grid-template-columns:repeat(auto-fit,minmax(min(100%,250px),1fr)); overflow:visible; scroll-snap-type:none; }
  .yacht-rail--grid .yacht-rail__item { width:auto; max-width:none; flex:auto; }
</style>
