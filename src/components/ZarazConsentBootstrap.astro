<script is:inline>
  (() => {
    const ANALYTICS_PURPOSE = 'amuB';
    const MARKETING_PURPOSE = 'ICtY';
    const focusedConsentDialogs = new WeakSet();
    const pendingConsentDialogs = new WeakSet();
    const observedConsentRoots = new WeakSet();

    const getConsentRoots = () => {
      const roots = [document];
      for (let index = 0; index < roots.length; index += 1) {
        for (const element of roots[index].querySelectorAll?.('*') || []) {
          if (element.shadowRoot && !roots.includes(element.shadowRoot)) roots.push(element.shadowRoot);
        }
      }
      return roots;
    };

    const focusPrimaryConsentAction = () => {
      const dialog = getConsentRoots()
        .map((root) => root.querySelector?.('dialog.cf_modal[open]'))
        .find(Boolean);
      if (!dialog || focusedConsentDialogs.has(dialog) || pendingConsentDialogs.has(dialog)) return dialog;
      pendingConsentDialogs.add(dialog);

      requestAnimationFrame(() => {
        if (!dialog.hasAttribute('open') || focusedConsentDialogs.has(dialog)) {
          pendingConsentDialogs.delete(dialog);
          return;
        }
        const acceptAll = dialog.querySelector('.cf_button--accept');
        if (!(acceptAll instanceof HTMLElement)) {
          pendingConsentDialogs.delete(dialog);
          return;
        }

        acceptAll.setAttribute('autofocus', '');
        acceptAll.focus({ preventScroll: true });

        // Zaraz focuses its modal container after inserting the dialog. Check
        // once after that initialization, but never steal focus from another
        // button/control the visitor has already chosen.
        setTimeout(() => {
          if (!dialog.hasAttribute('open')) {
            pendingConsentDialogs.delete(dialog);
            return;
          }
          const active = dialog.getRootNode()?.activeElement || document.activeElement;
          const zarazAutoFocus =
            active === dialog ||
            active?.classList?.contains('cf_modal_container') ||
            (active instanceof HTMLAnchorElement && dialog.contains(active));
          if (zarazAutoFocus) acceptAll.focus({ preventScroll: true });
          focusedConsentDialogs.add(dialog);
          pendingConsentDialogs.delete(dialog);
        }, 250);
      });
      return dialog;
    };

    const consentDialogObserver = new MutationObserver((mutations) => {
      for (const mutation of mutations) {
        if (
          mutation.type === 'attributes' &&
          mutation.target instanceof HTMLDialogElement &&
          !mutation.target.hasAttribute('open')
        ) {
          focusedConsentDialogs.delete(mutation.target);
          pendingConsentDialogs.delete(mutation.target);
        }
      }
      observeConsentRoots();
      focusPrimaryConsentAction();
    });

    const observeConsentRoots = () => {
      for (const root of getConsentRoots()) {
        if (observedConsentRoots.has(root)) continue;
        consentDialogObserver.observe(root === document ? document.documentElement : root, {
          attributes: true,
          attributeFilter: ['open'],
          childList: true,
          subtree: true,
        });
        observedConsentRoots.add(root);
      }
    };

    observeConsentRoots();
    focusPrimaryConsentAction();
    const consentDiscoveryInterval = setInterval(() => {
      observeConsentRoots();
      const dialog = focusPrimaryConsentAction();
      if (dialog && focusedConsentDialogs.has(dialog)) clearInterval(consentDiscoveryInterval);
    }, 100);
    setTimeout(() => clearInterval(consentDiscoveryInterval), 5000);

    const syncGoogleConsent = () => {
      const consent = window.zaraz?.consent;
      if (!consent?.getAll || !window.zaraz?.set) return;

      const choices = consent.getAll();
      const analyticsGranted = choices[ANALYTICS_PURPOSE] === true;
      const marketingGranted = choices[MARKETING_PURPOSE] === true;

      window.zaraz.set('google_consent_update', {
        analytics_storage: analyticsGranted ? 'granted' : 'denied',
        ad_storage: marketingGranted ? 'granted' : 'denied',
        ad_user_data: marketingGranted ? 'granted' : 'denied',
        ad_personalization: marketingGranted ? 'granted' : 'denied',
      });
    };

    const handleConsentReady = () => {
      syncGoogleConsent();
      document.addEventListener('zarazConsentChoicesUpdated', syncGoogleConsent);
    };

    if (window.zaraz?.consent?.APIReady) {
      handleConsentReady();
    } else {
      document.addEventListener('zarazConsentAPIReady', handleConsentReady, { once: true });
    }
  })();
</script>
