---
import LandingLayout from '../../layouts/LandingLayout.astro';
import FaqAccordion from '../FaqAccordion.astro';
import sharedData from '../../data/landing-charter-for-everybody.json' with { type: 'json' };

interface Review { quote: string; name: string; role: string }
interface AudienceItem { icon?: string; text: string }
interface Outcome { title: string; description: string }
interface Step { title: string; description: string }
interface ProgramItem { title: string; description: string }
interface Bonus { title: string; description: string }

interface HeroSection {
  type: 'hero';
  eyebrow?: string;
  title: string;
  description?: string;
  backgroundImage?: string;
  priceCurrent?: string;
  priceOriginal?: string;
  startLabel?: string;
  cta?: string;
  discount?: string;
  ctaPrimary?: string;
  ctaSecondary?: string;
  ctaSecondaryHint?: string;
  note?: string;
}

type Section =
  | HeroSection
  | { type: 'audience'; title: string; items: AudienceItem[] }
  | { type: 'reviews'; title: string; items: Review[] }
  | { type: 'problem'; title: string; text?: string; questions?: string[]; footer?: string; cta?: string }
  | { type: 'outcomes'; title: string; items: Outcome[]; cta?: string; layout?: 'grid' | 'cards' }
  | { type: 'choice'; noChoice: string; yesChoice: string }
  | { type: 'program'; title: string; subtitle?: string; source?: string; items?: ProgramItem[] }
  | { type: 'instructor'; name: string; title: string; image?: string; bio?: string; credentials?: string[]; cta?: string }
  | { type: 'howItWorks'; title: string; items: Step[] }
  | { type: 'pricing'; title: string; start?: string; price?: string; access?: string; format?: string; cta?: string }
  | { type: 'faq'; title: string; subtitle?: string; source?: string; items?: { q: string; a: string }[] }
  | { type: 'steps'; title: string; subtitle?: string; items: string[] }
  | { type: 'bonuses'; title: string; subtitle?: string; items: Bonus[] }
  | { type: 'guarantee'; title: string; text: string; cta?: string }
  | { type: 'finalCta'; title: string; subtitle?: string; description?: string; cta: string };

interface Props {
  locale: 'ru' | 'ua';
  data: {
    meta: {
      title: string;
      description: string;
      canonical: string;
      alternates?: Array<{ hreflang: string; href: string }>;
      og?: Record<string, string>;
      schema?: object;
    };
    sections: any[];
  };
}

const { locale, data } = Astro.props;

function resolveSource(source?: string) {
  if (!source) return [];
  if (!source.startsWith('landing-charter-for-everybody.json:')) return [];
  const path = source.replace('landing-charter-for-everybody.json:', '').split('.');
  let value: any = sharedData;
  for (const key of path) value = value?.[key];
  if (!value) return [];
  if (Array.isArray(value)) return value as { q: string; a: string }[];
  return Object.entries(value).map(([q, a]) => ({ q, a: a as string }));
}

function programItems(source?: string) {
  const entries = resolveSource(source);
  return entries.map(({ q, a }: { q: string; a: string }) => ({ title: q, description: a }));
}

function faqItems(source?: string) {
  return resolveSource(source);
}

function paragraphs(text: string) {
  return text.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
}

const ctaClass = 'navi-cta-button';

const programLabels = locale === 'ua'
  ? { lecture: 'Лекція', bonus: 'Бонус', bonusTitle: 'Ваші', bonusAccent: 'Бонуси', ctaTitle: 'Бажаєте розпочати навчання?', ctaText: 'Рішучість - відмінна риса справжніх моряків', cta: 'Записатися на курс' }
  : { lecture: 'Лекция', bonus: 'Бонус', bonusTitle: 'Ваши', bonusAccent: 'Бонусы', ctaTitle: 'Хотите начать обучение?', ctaText: 'Решительность - отличительная черта настоящих моряков', cta: 'Записаться на курс' };
---

<LandingLayout {...data.meta} locale={locale}>
  <main class="navi-landing">
    {data.sections.map((section) => {
      switch (section.type) {
        case 'hero':
          return (
            <header class="navi-hero" style={section.backgroundImage ? `--navi-hero-bg:url('${section.backgroundImage}')` : undefined}>
              <div class="navi-hero__content">
                {section.eyebrow && <p class="navi-hero__eyebrow">{section.eyebrow}</p>}
                <h1>{section.title}</h1>
                {section.description && <p class="navi-hero__lead">{section.description}</p>}
                <div class="navi-hero__actions">
                  {section.priceCurrent && (
                    <div class="navi-hero__price">
                      <span>Стоимость - {section.priceCurrent}</span>
                      {section.priceOriginal && <del>{section.priceOriginal}</del>}
                    </div>
                  )}
                  {section.startLabel && <p class="navi-hero__start">{section.startLabel}</p>}
                  {section.cta && <button class={ctaClass} data-navi-formbutton>{section.cta}</button>}
                  {section.discount && <p class="navi-hero__discount">{section.discount}</p>}
                  {section.ctaPrimary && <button class={ctaClass} data-navi-formbutton>{section.ctaPrimary}</button>}
                  {section.ctaSecondary && <a href="#program" class="navi-link-button">{section.ctaSecondary}{section.ctaSecondaryHint && <span>{section.ctaSecondaryHint}</span>}</a>}
                  {section.note && <p class="navi-hero__note">{section.note}</p>}
                </div>
                <img class="navi-hero__badge" src="/cgi/asset/black_friday_hLdX4v3zpbSf0EVV3GOqO.png" alt="" width="200" height="101" loading="eager" />
                <img class="navi-hero__payments" src="/cgi/asset/logo-stripe-secure-payments-1_i_c_rtmvYLKSygQJFMuB8.png" alt="" width="537" height="228" loading="lazy" />
              </div>
            </header>
          );

        case 'audience':
          return (
            <section class="navi-section navi-section--paper">
              <div class="navi-section__content">
                <h2>{section.title}</h2>
                <ul class="navi-audience">
                  {section.items.map((item: any) => (
                    <li>
                      {item.icon && <img src={item.icon} alt="" loading="lazy" width="200" height="200" />}
                      <p>{item.text}</p>
                    </li>
                  ))}
                </ul>
              </div>
            </section>
          );

        case 'reviews':
          return (
            <section class="navi-section navi-section--sea">
              <div class="navi-section__content">
                <h2>{section.title}</h2>
                <div class="navi-reviews">
                  {section.items.map((review: any) => (
                    <article class="navi-review">
                      <p>{review.quote}</p>
                      <footer>
                        <b>{review.name}</b>
                        <span>{review.role}</span>
                      </footer>
                    </article>
                  ))}
                </div>
              </div>
            </section>
          );

        case 'problem':
          return (
            <section class="navi-section navi-section--mist">
              <div class="navi-section__content navi-section__content--narrow">
                <h2>{section.title}</h2>
                {section.text && <p class="navi-lead">{section.text}</p>}
                {section.questions && section.questions.length > 0 && (
                  <ul class="navi-list">
                    {section.questions.map((q: any) => <li>{q}</li>)}
                  </ul>
                )}
                {section.footer && <p class="navi-footer-text">{section.footer}</p>}
                {section.cta && <button class={ctaClass} data-navi-formbutton>{section.cta}</button>}
              </div>
            </section>
          );

        case 'outcomes':
          return (
            <section class="navi-section navi-section--paper">
              <div class="navi-section__content">
                <h2>{section.title}</h2>
                <div class:list={['navi-outcomes', { 'navi-outcomes--cards': section.layout === 'cards' }]}>
                  {section.items.map((item: any, i: any) => (
                    <div class="navi-outcome">
                      <span class="navi-outcome__num">{i + 1}</span>
                      <h3>{item.title}</h3>
                      <p>{item.description}</p>
                    </div>
                  ))}
                </div>
                {section.cta && <button class={ctaClass} data-navi-formbutton>{section.cta}</button>}
              </div>
            </section>
          );

        case 'choice':
          return (
            <section class="navi-section navi-section--mist">
              <div class="navi-section__content navi-section__content--narrow">
                <p class="navi-choice navi-choice--no">{section.noChoice}</p>
                <p class="navi-choice navi-choice--yes">{section.yesChoice}</p>
              </div>
            </section>
          );

        case 'program': {
          const lectures = section.items || programItems(section.source);
          const [main, bonuses] = [lectures.slice(0, 7), lectures.slice(7)];
          return (
            <section id="program" class="navi-section navi-section--program">
              <div class="navi-section__content navi-section__content--narrow">
                <h2>{section.title}</h2>
                {section.subtitle && <p class="navi-subtitle">{section.subtitle}</p>}
                <div class="navi-program">
                  {main.map((item: any, i: any) => (
                    <div class="navi-program__row">
                      <div>{programLabels.lecture} {i + 1}</div>
                      <details>
                        <summary>{item.title}</summary>
                        <article>{paragraphs(item.description).map((p) => <p>{p}</p>)}</article>
                      </details>
                    </div>
                  ))}
                </div>
                {bonuses.length > 0 && (
                  <>
                    <h2 class="navi-program__bonuses-title">{programLabels.bonusTitle} <span>{programLabels.bonusAccent}</span></h2>
                    <div class="navi-program">
                      {bonuses.map((item: any, i: any) => (
                        <div class="navi-program__row">
                          <div>{programLabels.bonus} {i + 1}</div>
                          <details>
                            <summary>{item.title}</summary>
                            <article>{paragraphs(item.description).map((p) => <p>{p}</p>)}</article>
                          </details>
                        </div>
                      ))}
                    </div>
                  </>
                )}
                <div class="navi-program__cta">
                  <h3>{programLabels.ctaTitle}</h3>
                  <p>{programLabels.ctaText}</p>
                  <button class={ctaClass} data-navi-formbutton>{programLabels.cta}</button>
                </div>
              </div>
            </section>
          );
        }

        case 'instructor':
          return (
            <section class="navi-section navi-section--mist">
              <div class="navi-section__content">
                <div class="navi-instructor">
                  {section.image && <img src={section.image} alt={section.name} loading="lazy" width="576" height="640" />}
                  <div>
                    <p class="navi-instructor__label">{section.title}</p>
                    <h2>{section.name}</h2>
                    {section.bio && <p class="navi-instructor__bio">{section.bio}</p>}
                    {section.credentials && (
                      <ul>
                        {section.credentials.map((c: any) => <li>{c}</li>)}
                      </ul>
                    )}
                    {section.cta && <button class={ctaClass} data-navi-formbutton>{section.cta}</button>}
                  </div>
                </div>
              </div>
            </section>
          );

        case 'howItWorks':
          return (
            <section class="navi-section navi-section--paper">
              <div class="navi-section__content">
                <h2>{section.title}</h2>
                <div class="navi-steps">
                  {section.items.map((step: any, i: any) => (
                    <div class="navi-step">
                      <span>{i + 1}</span>
                      <h3>{step.title}</h3>
                      <p>{step.description}</p>
                    </div>
                  ))}
                </div>
              </div>
            </section>
          );

        case 'pricing':
          return (
            <section class="navi-section navi-section--sea navi-section--pricing">
              <div class="navi-section__content navi-section__content--narrow navi-pricing">
                <h2>{section.title}</h2>
                <dl>
                  {section.start && <><dt>Старт</dt><dd>{section.start}</dd></>}
                  {section.price && <><dt>Стоимость</dt><dd>{section.price}</dd></>}
                  {section.access && <><dt>Доступ</dt><dd>{section.access}</dd></>}
                  {section.format && <><dt>Формат</dt><dd>{section.format}</dd></>}
                </dl>
                {section.cta && <button class={ctaClass} data-navi-formbutton>{section.cta}</button>}
              </div>
            </section>
          );

        case 'faq': {
          const faq = section.items || faqItems(section.source);
          return (
            <section class="navi-section navi-section--mist">
              <div class="navi-section__content navi-section__content--narrow">
                <h2>{section.title}</h2>
                {section.subtitle && <p class="navi-subtitle">{section.subtitle}</p>}
                <FaqAccordion items={faq} />
              </div>
            </section>
          );
        }

        case 'steps':
          return (
            <section class="navi-section navi-section--paper">
              <div class="navi-section__content">
                <h2>{section.title}</h2>
                {section.subtitle && <p class="navi-subtitle">{section.subtitle}</p>}
                <div class="navi-step-list">
                  {section.items.map((text: any, i: any) => (
                    <div class="navi-step-list__item">
                      <span>{i + 1}</span>
                      <p>{text}</p>
                    </div>
                  ))}
                </div>
              </div>
            </section>
          );

        case 'bonuses':
          return (
            <section class="navi-section navi-section--mist">
              <div class="navi-section__content">
                <h2>{section.title}</h2>
                {section.subtitle && <p class="navi-subtitle">{section.subtitle}</p>}
                <div class="navi-bonuses">
                  {section.items.map((bonus: any, i: any) => (
                    <div class="navi-bonus">
                      <span>{i + 1}</span>
                      <h3>{bonus.title}</h3>
                      <p>{bonus.description}</p>
                    </div>
                  ))}
                </div>
              </div>
            </section>
          );

        case 'guarantee':
          return (
            <section class="navi-section navi-section--paper">
              <div class="navi-section__content navi-section__content--narrow">
                <h2>{section.title}</h2>
                <p>{section.text}</p>
                {section.cta && <button class={ctaClass} data-navi-formbutton>{section.cta}</button>}
              </div>
            </section>
          );

        case 'finalCta':
          return (
            <section class="navi-section navi-section--sea navi-section--final">
              <div class="navi-section__content">
                <h2>{section.title}</h2>
                {section.subtitle && <p class="navi-final__subtitle">{section.subtitle}</p>}
                {section.description && <p class="navi-final__description">{section.description}</p>}
                <button class={ctaClass} data-navi-formbutton>{section.cta}</button>
              </div>
            </section>
          );

        default:
          return null;
      }
    })}
  </main>
</LandingLayout>

<style is:global>
  :root {
    --navi-ink: #073746;
    --navi-sea: #0d4c5d;
    --navi-paper: #f7faf9;
    --navi-mist: #e9f2f1;
    --navi-accent: #d97706;
    --navi-program-bg: #2d8dbc;
    --navi-program-label: #ffb454;
    --navi-radius-section: 60px 60px 0 0;
    --navi-radius-section-mobile: 36px 36px 0 0;
    --navi-shadow-section: 0 -7px 20px rgba(135, 135, 135, .25);
    --navi-content: 1180px;
    --navi-narrow: 760px;
  }

  .navi-landing { color: var(--navi-ink); }

  .navi-hero {
    position: relative;
    display: grid;
    place-items: center;
    min-height: clamp(520px, 80vh, 860px);
    padding: 140px 20px 100px;
    color: #fff;
    text-align: center;
    background: linear-gradient(90deg, rgba(7, 55, 70, .92), rgba(7, 55, 70, .55)), var(--navi-hero-bg, #0d4c5d) center/cover no-repeat;
  }
  .navi-hero__content {
    position: relative;
    width: min(var(--navi-content), calc(100% - 40px));
    margin: 0 auto;
  }
  .navi-hero__eyebrow {
    margin: 0 0 18px;
    font: 700 12px/1.3 Arial, sans-serif;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: #ffb454;
  }
  .navi-hero h1 {
    max-width: 18ch;
    margin: 0 auto;
    font: 400 clamp(38px, 6.4vw, 78px)/1.05 'Tenor Sans', Arial, sans-serif;
  }
  .navi-hero__lead {
    max-width: 720px;
    margin: 24px auto 0;
    font-size: clamp(17px, 1.6vw, 21px);
    line-height: 1.55;
  }
  .navi-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    justify-content: center;
    align-items: center;
    margin-top: 40px;
  }
  .navi-hero__price {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 14px 22px;
    background: rgba(255, 255, 255, .12);
    border-radius: 16px;
  }
  .navi-hero__price span { font-size: 22px; font-weight: 700; }
  .navi-hero__price del { position: relative; font-size: 16px; color: rgba(255, 255, 255, .7); }
  .navi-hero__start { margin: 0; font-size: 15px; color: rgba(255, 255, 255, .9); }
  .navi-hero__discount { margin: 0; font-size: 18px; font-weight: 700; }
  .navi-hero__note { width: 100%; margin: 8px 0 0; font-size: 15px; color: rgba(255, 255, 255, .85); }
  .navi-hero__badge { display: block; width: 160px; height: auto; margin: 24px auto 0; }
  .navi-hero__payments { display: block; width: min(280px, 60%); height: auto; margin: 18px auto 0; opacity: .95; }

  .navi-cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 18px 32px;
    border: 0;
    border-radius: 50px;
    background: var(--navi-accent);
    color: #fff;
    font: 600 17px/1.3 Arial, sans-serif;
    cursor: pointer;
    text-decoration: none;
  }
  .navi-link-button {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: #fff;
    font-weight: 600;
    text-decoration: none;
  }
  .navi-link-button span { opacity: .8; }

  .navi-section {
    position: relative;
    width: 100%;
    padding: clamp(64px, 8vw, 110px) clamp(20px, 4vw, 48px);
    box-sizing: border-box;
  }
  .navi-section + .navi-section {
    margin-top: -60px;
    border-radius: var(--navi-radius-section);
    box-shadow: var(--navi-shadow-section);
  }
  .navi-section--paper { background: var(--navi-paper); }
  .navi-section--mist { background: var(--navi-mist); }
  .navi-section--sea { color: #fff; background: var(--navi-ink); }
  .navi-section--program { color: var(--navi-ink); background: var(--navi-program-bg); }
  .navi-section--program h2 { color: var(--navi-ink); }
  .navi-section--program h2 span { color: var(--navi-program-label); }
  .navi-section__content { max-width: var(--navi-content); margin: 0 auto; }
  .navi-section__content--narrow { max-width: var(--navi-narrow); }
  .navi-section h2 { margin: 0 0 24px; font: 400 clamp(32px, 4vw, 56px)/1.1 'Tenor Sans', sans-serif; color: inherit; text-align: center; }
  .navi-section--paper h2, .navi-section--mist h2, .navi-section--program h2 { color: var(--navi-ink); }
  .navi-subtitle { margin: -14px 0 36px; font-size: clamp(17px, 1.5vw, 21px); color: #52656b; text-align: center; }

  .navi-audience { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 28px; margin: 48px 0 0; padding: 0; list-style: none; }
  .navi-audience li { display: flex; gap: 18px; align-items: flex-start; padding: 24px; background: #fff; border-radius: 18px; box-shadow: 0 8px 24px rgba(7, 55, 70, .06); }
  .navi-audience img { width: 80px; height: 80px; border-radius: 50%; object-fit: cover; flex: none; }
  .navi-audience p { margin: 0; font-size: 16px; line-height: 1.55; color: var(--navi-ink); }

  .navi-reviews { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px; margin-top: 48px; }
  .navi-review { padding: 28px; background: #fff; border-radius: 18px; color: var(--navi-ink); box-shadow: 0 12px 30px rgba(7, 55, 70, .08); }
  .navi-review p { margin: 0; font-size: 15px; line-height: 1.65; }
  .navi-review footer { display: flex; flex-direction: column; gap: 4px; margin-top: 20px; }
  .navi-review footer b { color: var(--navi-accent); font-size: 17px; }
  .navi-review footer span { font-size: 14px; color: #52656b; }

  .navi-lead { font-size: clamp(17px, 1.5vw, 20px); line-height: 1.7; color: #3f5b64; }
  .navi-list { display: grid; gap: 14px; margin: 28px 0; padding: 0; list-style: none; }
  .navi-list li { position: relative; padding-left: 28px; font-size: 16px; line-height: 1.55; color: var(--navi-ink); }
  .navi-list li::before { content: ''; position: absolute; left: 0; top: 9px; width: 8px; height: 8px; border-radius: 50%; background: var(--navi-accent); }
  .navi-footer-text { font-size: 17px; line-height: 1.65; color: #3f5b64; }

  .navi-outcomes { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 24px; margin: 48px 0 36px; }
  .navi-outcome { padding: 28px; background: #fff; border-radius: 18px; box-shadow: 0 8px 24px rgba(7, 55, 70, .06); }
  .navi-outcome__num { display: grid; place-items: center; width: 44px; height: 44px; margin-bottom: 18px; border-radius: 50%; background: var(--navi-ink); color: #fff; font: 600 18px/1 Arial, sans-serif; }
  .navi-outcome h3 { margin: 0 0 10px; font-size: 20px; color: var(--navi-ink); }
  .navi-outcome p { margin: 0; font-size: 15px; line-height: 1.6; color: #52656b; }

  .navi-choice { position: relative; padding-left: 36px; font-size: clamp(18px, 2vw, 24px); line-height: 1.55; }
  .navi-choice::before { position: absolute; left: 0; top: 4px; width: 24px; height: 24px; display: grid; place-items: center; font-size: 16px; font-weight: 700; border-radius: 50%; }
  .navi-choice--no { color: #52656b; margin-bottom: 28px; }
  .navi-choice--no::before { content: '×'; background: #e2e8f0; color: #9aa9ae; }
  .navi-choice--yes { font-weight: 600; color: var(--navi-ink); }
  .navi-choice--yes::before { content: '✓'; background: #22c55e; color: #fff; }

  .navi-program { overflow: hidden; border: 2px solid #c8c8c8; border-radius: 20px; background: #fff; margin-bottom: 56px; }
  .navi-program__row { display: grid; grid-template-columns: 165px minmax(0, 1fr); border-top: 1px solid #dce3e6; }
  .navi-program__row:first-child { border-top: 0; }
