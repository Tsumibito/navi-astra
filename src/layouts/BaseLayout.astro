---
import "../styles/global.css";
import "../styles/evolution-native.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PhotoStrip from "../components/PhotoStrip.astro";
import NavMenu from "../components/NavMenu.astro";
import ServiceLeadForm from "../components/ServiceLeadForm.astro";
import NewsletterModal from "../components/NewsletterModal.astro";
import ZarazConsentBootstrap from "../components/ZarazConsentBootstrap.astro";
import AnalyticsBootstrap from "../components/AnalyticsBootstrap.astro";
const {
  title = 'Navi Astro', description = 'Astro 5 + Tailwind starter', locale = 'ru',
  canonical: canonicalOverride, image, structuredData, languageHrefs = {}, fullBleed = false,
  leadForm = {}, preloadImage,
} = Astro.props;
const canonicalPath = Astro.url.pathname === '/' ? '/' : `${Astro.url.pathname.replace(/\/+$/, '')}/`;
const canonical = canonicalOverride || `https://navi.training${canonicalPath}`;
const htmlLang = locale === 'ua' ? 'uk' : locale;
const defaultSocialImage = 'https://navi.training/cgi/asset/Navi_logo_150x150_C_9IEN2-7O865fBBu5MBc.png';
const socialImage = image ? new URL(image, 'https://navi.training').href : defaultSocialImage;
const navByLocale: Record<string, Array<{ label: string; href: string }>> = {
  ru: [
    { label: 'Путешествия', href: '/ru/tags/sailing-routes' },
    { label: 'Аренда яхт', href: '/ru/charter' },
    { label: 'Блог', href: '/ru/blog' },
    { label: 'Энциклопедия', href: '/ru/encyclopedia' },
  ],
  ua: [
    { label: 'Головна', href: '/ua/' },
    { label: 'Подорожі', href: '/ua/tags/sailing-routes' },
    { label: 'Оренда яхт', href: '/ua/charter' },
    { label: 'Блог', href: '/ua/blog' },
    { label: 'Енциклопедія', href: '/ua/encyclopedia' },
  ],
  en: [
    { label: 'Home', href: '/en/' },
    { label: 'Yacht travel', href: '/en/tags/sailing-routes' },
    { label: 'Yacht charter', href: '/en/charter' },
    { label: 'Journal', href: '/en/blog' },
    { label: 'Encyclopedia', href: '/en/encyclopedia' },
  ],
  fr: [
    { label: 'Accueil', href: '/fr/' },
    { label: 'École', href: '/fr/school' },
    { label: 'Charter', href: '/fr/charter' },
    { label: 'Convoyage', href: '/fr/delivery' },
    { label: 'Articles', href: '/fr/blog' },
    { label: 'Contacts', href: '/fr/contacts' },
  ],
};
const items = navByLocale[locale] ?? navByLocale['en'];
const langs = ['ru','ua','en'] as const;
const pageSchema = structuredData ?? {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  url: canonical,
};
---
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <ZarazConsentBootstrap />
    <AnalyticsBootstrap />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (() => {
        const nav = performance.getEntriesByType?.('navigation')?.[0];
        if (nav?.type === 'reload' && !location.hash) {
          if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
          addEventListener('pageshow', () => requestAnimationFrame(() => scrollTo(0, 0)), { once: true });
        }
      })();
    </script>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {Object.entries(languageHrefs).map(([lang, href]) => <link rel="alternate" hreflang={lang === 'ua' ? 'uk' : lang} href={`https://navi.training${href}`} />)}
    {languageHrefs.ru && <link rel="alternate" hreflang="x-default" href={`https://navi.training${languageHrefs.ru}`} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Navi.training" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={image ? title : 'Navi.training'} />
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    {preloadImage && (
      <link
        rel="preload"
        as="image"
        href={preloadImage.href}
        type={preloadImage.type}
        imagesrcset={preloadImage.srcset}
        imagesizes={preloadImage.sizes || '100vw'}
        fetchpriority="high"
      />
    )}
    {image && <link rel="preload" as="image" href={image} media="(min-width: 1024px)" />}
    <link rel="preconnect" href="https://pub-c14094474319495887321b74b5186100.r2.dev" crossorigin />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(pageSchema).replaceAll('<', '\\u003c')}></script>
    <link rel="icon" href="/cgi/asset/Navi_logo_48x48_Jrw0nV6TLB6EdlDeYrhlw.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/cgi/asset/Navi_logo_150x150_C_9IEN2-7O865fBBu5MBc.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="stylesheet" href="/fonts/fonts.css" />
    <link rel="stylesheet" href="/navi-standard-v1.css?v=20260726-3" />
    <title>{title}</title>
  </head>
  <body class="min-h-dvh bg-white text-black antialiased font-neo flex flex-col">
    <Header locale={locale} languageHrefs={languageHrefs} />
    <div id="mobileDrawer" popover="auto" aria-label="Меню" class="fixed bg-white shadow-2xl" style="width:min(88vw,360px)">
      <div class="flex flex-col h-full px-[30px] pb-[30px] pt-[30px]">
        <div class="flex-1">
          <NavMenu items={items} class="flex-col items-center gap-y-3 text-lg" />
        </div>
        <div class="h-px w-full bg-slate-200 my-4" />
        <div class="flex items-center justify-center gap-4 text-base">
          {langs.map((l) => (
            <a href={languageHrefs[l] ?? (l === 'ru' ? '/' : `/${l}/`)} class={`uppercase tracking-wide transition-colors ${l === locale ? 'text-brand-orangeDark font-bold underline underline-offset-4' : 'text-slate-400 hover:text-slate-700'}`}>{l}</a>
          ))}
        </div>
        <button type="button" data-open-service-form data-service="charter" class="inline-flex w-full items-center justify-center rounded-md border-0 bg-brand-orange px-4 py-[18px] text-sm font-medium text-black hover:bg-brand-orangeDark hover:text-white transition-colors mt-4">{locale === 'ru' ? 'Арендовать яхту' : locale === 'ua' ? 'Орендувати яхту' : locale === 'fr' ? 'Affréter' : 'Charter a yacht'}</button>
      </div>
    </div>
    <main class:list={["flex-1", fullBleed ? "w-full" : "container mx-auto px-6 py-10"]}>
      <slot />
    </main>
    <PhotoStrip />
    <Footer locale={locale} />
    <ServiceLeadForm locale={locale} service={leadForm.service} title={leadForm.title} intro={leadForm.intro} button={leadForm.button} />
    <NewsletterModal locale={locale} />
  </body>
</html>
