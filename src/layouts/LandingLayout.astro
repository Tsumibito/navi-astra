---
import CourseUnavailableModal from '../components/CourseUnavailableModal.astro';
import Footer from '../components/Footer.astro';
import PhotoStrip from '../components/PhotoStrip.astro';
interface Alternate { hreflang: string; href: string }
interface Props {
  locale: 'ru' | 'ua' | 'en';
  title: string;
  description: string;
  canonical: string;
  alternates?: Alternate[];
  og?: { url?: string; title?: string; description?: string; image?: string; type?: string; site_name?: string };
  schema?: object;
  styleTags?: string[];
}
const { locale, title, description, canonical, alternates = [], og = {}, schema, styleTags = [] } = Astro.props;
const langTag = locale === 'ua' ? 'uk-UA' : locale === 'en' ? 'en' : 'ru-RU';
const home = locale === 'ru' ? '/' : `/${locale}/home`;
---
<!DOCTYPE html>
<html lang={langTag}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <meta property="og:url" content={og.url ?? canonical} />
    {og.title && <meta property="og:title" content={og.title} />}
    {og.description && <meta property="og:description" content={og.description} />}
    {og.image && <meta property="og:image" content={og.image} />}
    {og.type && <meta property="og:type" content={og.type} />}
    {og.site_name && <meta property="og:site_name" content={og.site_name} />}
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />}
    <link rel="icon" href="/cgi/asset/Navi_logo_48x48_Jrw0nV6TLB6EdlDeYrhlw.png" type="image/png" />
    {styleTags.map((tag) => <Fragment set:html={tag} />)}
    <link rel="stylesheet" href="/navi-runtime.css" />
    <link rel="stylesheet" href="/navi-evolution-v1.css" />
    <style is:global>
      html { display: block !important; overflow-x: hidden; }
      body { width: 100%; overflow-x: hidden; white-space: normal; }
      details.w-item summary.w-item-header { list-style: none; cursor: pointer; }
      details.w-item summary.w-item-header::-webkit-details-marker { display: none; }
      details.w-item .w-item-trigger { pointer-events: none; }
      details.w-item:not([open]) .w-item-content { display: none !important; }
      details.w-item[open] .w-item-content { display: block; }
      body[data-navi-page="generic"] section[data-evo-section]:not([data-evo-section="0"]):not([data-evo-section="6"]) { position: relative; z-index: 1; margin-top: -60px; border-radius: 60px 60px 0 0; box-shadow: 0 -7px 20px rgba(135,135,135,.25); overflow: hidden; }
      section[data-evo-section="10"] { transform: translateY(-48px); margin-bottom: -48px; }
      .navi-landing-answer { padding: 0 24px 24px; color: #38545d; font-size: 16px; line-height: 1.7; }
      .navi-landing-answer p { margin: 0 0 12px; }
      .landing-logo-bar { box-sizing: border-box; width: 100%; min-height: 4rem; display: flex; align-items: center; padding: 12px max(16px, 5vw); background: #fff; box-shadow: 0 7px 15px -1px rgba(0,0,0,.2); }
      .landing-logo-bar a { display: inline-block; }
      .landing-logo-bar img { display: block; width: auto; max-width: min(220px, 40vw); height: auto; }
      section .swiper,
      .c88twz7 .swiper {
        overflow-x: auto !important;
        overflow-y: hidden !important;
        scroll-snap-type: x mandatory !important;
        width: 100% !important;
        -webkit-overflow-scrolling: touch !important;
        scrollbar-width: none !important;
      }
      section .swiper::-webkit-scrollbar,
      .c88twz7 .swiper::-webkit-scrollbar { display: none; }
      section .swiper-wrapper,
      .c88twz7 .swiper-wrapper {
        display: flex !important;
        gap: 16px !important;
        width: max-content !important;
      }
      section .swiper-wrapper .swiper-slide,
      .c88twz7 .swiper-wrapper .swiper-slide {
        flex: 0 0 auto !important;
        width: 260px !important;
        scroll-snap-align: start !important;
      }
      section .swiper-button-next,
      section .swiper-button-prev,
      .c88twz7 .swiper-button-next,
      .c88twz7 .swiper-button-prev {
        display: none !important;
      }
      @media (max-width: 760px) {
        body > section.w-box,
        body > section.w-box .w-box {
          max-width: 100vw !important;
          box-sizing: border-box !important;
        }
        section[data-evo-section="7"] .c1ifwduf.c1chdpzo,
        section[data-evo-section="6"] .c1ifwduf.c1chdpzo {
          grid-template-columns: 1fr !important;
          justify-items: center !important;
          gap: 24px !important;
        }
        section[data-evo-section="7"] .c1ifwduf.c1chdpzo img,
        section[data-evo-section="6"] .c1ifwduf.c1chdpzo img {
          max-width: min(100%, 360px) !important;
          height: auto !important;
        }
        section:not([data-evo-section="0"]) .c1eb8odi,
        .c88twz7 .c1eb8odi {
          width: 100% !important;
          max-width: 100vw !important;
          margin-top: 24px !important;
          flex-direction: column !important;
          align-items: center !important;
          padding: 0 16px !important;
          gap: 12px !important;
          box-sizing: border-box !important;
        }
        section:not([data-evo-section="0"]) .c1eb8odi img,
        .c88twz7 .c1eb8odi img {
          max-width: 80px !important;
          height: auto !important;
        }
        section .swiper-wrapper .swiper-slide,
        .c88twz7 .swiper-wrapper .swiper-slide {
          width: 100% !important;
          min-width: 100% !important;
        }
        body[data-navi-page="generic"] section[data-evo-section]:not([data-evo-section="0"]):not([data-evo-section="6"]) {
          margin-top: -36px;
          border-radius: 36px 36px 0 0;
          box-shadow: 0 -4px 12px rgba(135, 135, 135, .25);
        }
        section[data-evo-section="10"] {
          transform: translateY(-24px);
          margin-bottom: -24px;
        }
      }
    </style>
  </head>
  <body class="w-body" data-navi-evolution="v6" data-navi-page="generic">
    <div class="landing-logo-bar">
      <a href={home} aria-label="Navi.training"><img src="/navi_training_logo_c1.avif" alt="Navi.training" width="640" height="120" /></a>
    </div>
    <slot />
    <PhotoStrip />
    <Footer locale={locale} />
    <CourseUnavailableModal locale={locale} />
    <script is:inline defer>
      (() => {
        // Prevent navi-runtime.js from handling these buttons and open the temporary form instead.
        document.querySelectorAll('[data-navi-formbutton]').forEach((button) => {
          button.removeAttribute('data-navi-formbutton');
          button.setAttribute('data-course-unavailable', '');
          if (button.getAttribute('href') === '#') button.removeAttribute('href');
        });
        const modal = document.getElementById('course-unavailable-modal');
        if (!modal) return;
        const openModal = () => {
          if (modal.open) return;
          document.querySelectorAll('dialog[open]').forEach((dialog) => dialog.close());
          modal.showModal();
          requestAnimationFrame(() => modal.classList.add('is-open'));
          setTimeout(() => modal.querySelector('input[type="email"]')?.focus(), 250);
        };
        document.querySelectorAll('[data-course-unavailable]').forEach((button) => {
          button.addEventListener('click', (event) => {
            event.preventDefault();
            openModal();
          });
        });
      })();
    </script>
    <script src="/navi-runtime.js" defer></script>
  </body>
</html>
