---
import BaseLayout from '~/layouts/BaseLayout.astro';
import legalData from '~/data/legal.json';

const legal = 'cookie-policy';

export function getStaticPaths() {
  const legal = 'cookie-policy';
  return Object.keys((legalData as any)[legal] || {}).map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale;
const { pageTitle, pageDesc, content } = (legalData as any)[legal]?.[locale] || { pageTitle: '', pageDesc: '', content: '' };

const langHrefs: Record<string, string> = {};
Object.keys((legalData as any)[legal] || {}).forEach((l) => {
  if (l === locale) return;
  langHrefs[l] = `/${l}/${legal}/`;
});
---
<BaseLayout title={`${pageTitle} — Navi.training`} description={pageDesc} locale={locale} canonical={`https://navi.training/${locale}/${legal}/`} languageHrefs={langHrefs} fullBleed={true}>
  <section class="legal-body">
    <div class="legal-body__inner">
      <div class="legal-prose" set:html={content} />
    </div>
  </section>
</BaseLayout>
