---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import "@phosphor-icons/web/regular";
import RelatedPosts from '../../../components/RelatedPosts.astro';
import payloadContent from '../../../data/payload-content.json';

export const getStaticPaths = () => {
  const published = (payloadContent as { encyclopedia?: any[] }).encyclopedia || [];
  return published.map((term) => ({ params: { locale: term.locale === 'uk' ? 'ua' : term.locale, slug: term.route.split('/').filter(Boolean).at(-1) }, props: { term } }));
};

const { term } = Astro.props;
const locale = Astro.params.locale || 'ru';
const indexLabel = locale === 'ru' ? 'Яхтенная энциклопедия' : locale === 'ua' ? 'Яхтова енциклопедія' : 'Yachting Encyclopedia';
const sourceLabel = locale === 'ru' ? 'Источники и проверка' : locale === 'ua' ? 'Джерела та перевірка' : 'Sources and verification';
const categoryLabel = locale === 'ru' ? 'Связанные темы' : locale === 'ua' ? 'Пов’язані теми' : 'Related topics';
const readingLabel = locale === 'ru' ? 'Рекомендуемые статьи' : locale === 'ua' ? 'Рекомендовані статті' : 'Recommended reading';
const translationLabel = locale === 'ru' ? 'Термин на других языках' : locale === 'ua' ? 'Термін іншими мовами' : 'Term in other languages';
const paragraphs = String(term.content || '').split('\n\n').filter(Boolean);
const escapeHtml = (value: string) => value.replace(/[&<>"']/g, (character: string) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[character] ?? character));
const allTerms = (payloadContent as { encyclopedia?: any[] }).encyclopedia || [];
const allPosts = (payloadContent as { entries?: any[] }).entries?.filter((entry) => entry.kind === 'post' && entry.locale === term.locale) || [];
const allRoutes = new Set([
  ...((payloadContent as { entries?: any[] }).entries || []).map((entry: any) => entry.route),
  ...allTerms.map((entry: any) => entry.route),
]);
const renderParagraph = (value: string) => escapeHtml(value).replace(/\[([^\]]+)\]\((\/(?:ru|ua|en)\/(?:blog|tags|encyclopedia)\/[^)]+)\)/g, (_match, label, href) => {
  const normalized = href.replace(/\/{2,}/g, '/').replace(/\/+$/, '') + '/';
  return allRoutes.has(normalized) ? `<a href="${normalized}">${label}</a>` : label;
});
const translations = allTerms.filter((entry) => entry.canonicalKey === term.canonicalKey && entry.route !== term.route);
const languageHrefs = Object.fromEntries(
  allTerms
    .filter((entry) => entry.canonicalKey === term.canonicalKey)
    .map((entry) => [entry.locale === 'uk' ? 'ua' : entry.locale, entry.route]),
);
const languageNames: Record<string, string> = { ru: 'Русский', uk: 'Українська', ua: 'Українська', en: 'English', fr: 'Français', es: 'Español', de: 'Deutsch', zh: '中文', pt: 'Português', ja: '日本語' };
const normalizeWords = (value: string) => String(value || '').toLocaleLowerCase().replace(/^navi\.training:\s*/i, '').replace(/[^\p{L}\p{N}]+/gu, ' ').trim();
const wordSet = (value: string) => new Set(normalizeWords(value).split(' ').filter((word: string) => word.length > 2));
const internalLinks = (term.sources || []).flatMap((source: any) => {
  if (!/https?:\/\/(?:www\.)?navi\.training\/(?:ru|ua|en)\/blog\//i.test(source.url || '')) return [];
  const sourcePath = new URL(source.url).pathname.replace(/\/+$/, '') + '/';
  let post = allPosts.find((entry: any) => entry.route === sourcePath);
  if (!post) {
    const sourceWords = wordSet(source.name);
    let bestScore = 0;
    for (const candidate of allPosts) {
      const candidateWords = wordSet(candidate.name);
      const shared = [...sourceWords].filter((word: string) => candidateWords.has(word)).length;
      const score = shared / Math.max(sourceWords.size, candidateWords.size, 1);
      if (score > bestScore) { bestScore = score; post = candidate; }
    }
    if (bestScore < 0.55) post = null;
  }
  return post ? [{ url: post.route, label: post.name }] : [];
}).filter((link: any, index: number, links: any[]) => links.findIndex((candidate: any) => candidate.url === link.url) === index).slice(0, 2);
const resolvedSources = (term.sources || []).map((source: any) => {
  if (!/https?:\/\/(?:www\.)?navi\.training\//i.test(source.url || '')) return source;
  const sourceWords = wordSet(source.name);
  let bestPost = null;
  let bestScore = 0;
  for (const candidate of allPosts) {
    const candidateWords = wordSet(candidate.name);
    const shared = [...sourceWords].filter((word: string) => candidateWords.has(word)).length;
    const score = shared / Math.max(sourceWords.size, candidateWords.size, 1);
    if (score > bestScore) { bestScore = score; bestPost = candidate; }
  }
  return { ...source, url: bestScore >= 0.55 ? bestPost?.route : null };
});
const relatedPosts = [
  ...internalLinks.map((link: any) => allPosts.find((post: any) => post.route === link.url)).filter(Boolean),
  ...allPosts.slice().sort((a: any, b: any) => new Date(b.createdAt || 0).getTime() - new Date(a.createdAt || 0).getTime()),
].filter((post: any, index: number, posts: any[]) => posts.findIndex((candidate: any) => candidate.route === post.route) === index).slice(0, 3);
const currentTagIds = new Set((term.relatedTags || []).map((tag: any) => String(tag.id)));
const relatedTerms = allTerms
  .filter((entry) => entry.locale === term.locale && entry.id !== term.id)
  .map((entry) => {
    const sharedTags = (entry.relatedTags || []).filter((tag: any) => currentTagIds.has(String(tag.id))).length;
    return { entry, score: sharedTags * 10 + (entry.domain === term.domain ? 2 : 0) };
  })
  .filter(({ score }) => score > 0)
  .sort((left, right) => right.score - left.score || left.entry.term.localeCompare(right.entry.term, term.locale))
  .map(({ entry }) => entry);
const relatedItems = [
  ...(term.relatedTags || []).map((tag: any) => ({ name: tag.name, route: tag.route, icon: 'ph-tag' })),
  ...relatedTerms.map((entry) => ({ name: entry.term, route: entry.route, icon: 'ph-compass' })),
].filter((item: any, index: number, items: any[]) => items.findIndex((candidate: any) => candidate.route === item.route) === index).slice(0, 4);
const structuredData = { '@context': 'https://schema.org', '@type': 'DefinedTerm', name: term.term, description: term.definition, inDefinedTermSet: { '@type': 'DefinedTermSet', name: 'Navi.training Yachting Encyclopedia', url: `https://navi.training/${locale}/encyclopedia/` }, url: `https://navi.training${term.route}`, dateModified: term.updatedAt };
---
<BaseLayout fullBleed title={term.seoTitle} description={term.seoDescription} locale={locale} canonical={`https://navi.training${term.route}`} structuredData={structuredData} languageHrefs={languageHrefs}>
  <header class="entry-hero">
    <div><nav><a href={`/${locale}/encyclopedia/`}><i class="ph ph-books" aria-hidden="true"></i>{indexLabel}</a><span>→</span><span>{term.term}</span></nav><p class="domain">{term.domain}</p><h1>{term.term}</h1><p class="definition">{term.definition}</p>{term.aliases?.length ? <p class="aliases">{term.aliases.join(' · ')}</p> : null}</div>
  </header>
  <article class="entry">
    {translations.length ? <nav class="translations" aria-label={translationLabel}><strong><i class="ph ph-translate" aria-hidden="true"></i>{translationLabel}</strong>{translations.map((translation) => <a href={translation.route} hreflang={translation.locale}><span>{languageNames[translation.locale] || translation.locale.toUpperCase()}</span><b>{translation.term}</b></a>)}</nav> : null}
    <div class="article-copy">
      {paragraphs.map((paragraph) => <p set:html={renderParagraph(paragraph)} />)}
      {internalLinks.length ? <aside class="reading"><strong><i class="ph ph-book-open-text" aria-hidden="true"></i>{readingLabel}</strong>{internalLinks.map((link: any) => <a href={link.url}>{link.label}<i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>)}</aside> : null}
    </div>
    {term.usageNotes ? <aside>{term.usageNotes}</aside> : null}
    {relatedItems.length ? <section class="related"><h2>{categoryLabel}</h2><div>{relatedItems.map((item) => <a href={item.route}><i class={`ph ${item.icon}`} aria-hidden="true"></i>{item.name}<i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>)}</div></section> : null}
    {resolvedSources.length ? (
      <details>
        <summary>{sourceLabel}</summary>
        <ul>{resolvedSources.map((source: any) => <li>{source.url ? <a href={source.url} rel="nofollow external">{source.name}</a> : <span>{source.name}</span>}<span>{source.license ? ` · ${source.license}` : ''}</span></li>)}</ul>
      </details>
    ) : null}
  </article>
  <RelatedPosts posts={relatedPosts} locale={locale} />
</BaseLayout>
<style>
  .entry-hero{position:relative;isolation:isolate;min-height:480px;overflow:hidden;color:#fff;background:linear-gradient(90deg,rgba(3,35,46,.94),rgba(3,35,46,.46)),url('/cgi/asset/65fecaed1ad009d27a4a41ce_l1_ATycUs4suoYYnQmvJibP4.webp') center 58%/cover no-repeat}
  .entry-hero>div{display:flex;flex-direction:column;justify-content:flex-end;width:min(850px,calc(100% - 48px));min-height:480px;margin:auto;padding:82px 0 84px;box-sizing:border-box}
  .entry-hero nav{display:flex;gap:.6rem;align-items:center;margin-bottom:44px;color:rgba(255,255,255,.66);font-size:.9rem}.entry-hero nav a{display:inline-flex;gap:.45rem;align-items:center;color:#fff}.domain{margin:0;color:#ffb052;text-transform:uppercase;letter-spacing:.14em;font-size:.78rem}.entry-hero h1{max-width:14ch;margin:.35rem 0 1.25rem;color:#fff;font:400 clamp(48px,8vw,92px)/.96 'Tenor Sans',sans-serif}.definition{max-width:62ch;margin:0;font-size:clamp(18px,2vw,22px);line-height:1.5;color:rgba(255,255,255,.92)}.aliases{color:rgba(255,255,255,.65)}
  .entry{position:relative;z-index:2;max-width:none;margin-top:-60px;padding:78px max(24px,calc((100vw - 850px)/2)) 132px;color:#163e49;background:#f7faf9;border-radius:60px 60px 0 0;box-shadow:0 -7px 20px rgba(7,55,70,.18)}
  .translations{display:flex;align-items:center;gap:10px;margin:0 0 22px;padding:0 0 18px;border-bottom:1px solid #dce4e7}.translations>strong{display:inline-flex;align-items:center;gap:.5rem;margin-right:auto}.translations a{display:grid;gap:2px;min-width:9rem;padding:8px 11px;color:#164b5d;text-decoration:none;border:1px solid #cadde3;border-radius:8px}.translations a span{color:#718087;font-size:.72rem;line-height:1.2}.translations a b{font-size:.95rem;line-height:1.25;font-weight:650}.translations a:hover{border-color:#d97706;color:#9a5708}
  .article-copy{font-size:1.1rem;line-height:1.8;padding:28px 0}.article-copy p{margin:0 0 1.35rem}.article-copy :global(a){color:#164e61;text-decoration-line:underline;text-decoration-color:rgba(217,119,6,.6);text-decoration-thickness:1px;text-underline-offset:4px}.article-copy :global(a:hover){color:#9a5708;text-decoration-color:#9a5708}
  .entry aside{padding:22px 25px;border-left:4px solid #d97706;background:#fff5e8;border-radius:0 14px 14px 0}.related{margin-top:40px}.related h2{font-size:1.35rem}.related div{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.related a{display:grid;grid-template-columns:auto 1fr auto;gap:10px;align-items:center;padding:16px;border:1px solid #d6e2e6;border-radius:14px;background:#fff;color:#205b70;text-decoration:none}.related a:hover{border-color:#d97706;color:#9a5708}.entry details{margin-top:36px;padding-top:22px;border-top:1px solid #dce4e7}.entry summary{cursor:pointer;font-weight:600}.entry li{margin:.5rem 0}
  @media(max-width:640px){.entry-hero,.entry-hero>div{min-height:430px}.entry-hero>div{width:calc(100% - 36px);padding:72px 0 62px}.entry-hero nav{margin-bottom:32px;overflow:hidden}.entry-hero nav span:last-child{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.entry-hero h1{font-size:42px;line-height:1.02}.entry{margin-top:-36px;padding:52px 18px 92px;border-radius:36px 36px 0 0}.translations{align-items:flex-start;flex-wrap:wrap}.translations>strong{width:100%}.related div{grid-template-columns:1fr}.article-copy{font-size:17px;line-height:1.72}}
</style>
<style>
  .article-copy .reading{display:grid;gap:10px;margin:30px 0 4px;padding:20px 24px;border-left-color:#2b7b92;background:#eef7f8}
  .article-copy .reading strong{display:flex;align-items:center;gap:.5rem;margin-bottom:2px}
  .article-copy .reading a{display:flex;align-items:center;justify-content:space-between;gap:1rem;color:#164e61}
</style>
