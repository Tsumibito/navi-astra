---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import "@phosphor-icons/web/regular";
import RelatedPosts from '../../../components/RelatedPosts.astro';
import payloadContent from '../../../data/payload-content.json';
const content = payloadContent as unknown as { encyclopedia?: any[] };

export function getStaticPaths() {
  return ['ru', 'ua', 'en'].map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale || 'ru';
const dataLocale = locale === 'ua' ? 'uk' : locale;
const terms = (content.encyclopedia || []).filter((term) => term.locale === dataLocale);
const latestPosts = (payloadContent.entries || [])
  .filter((entry: any) => entry.kind === 'post' && entry.locale === dataLocale)
  .sort((a: any, b: any) => new Date(b.createdAt || 0).getTime() - new Date(a.createdAt || 0).getTime())
  .slice(0, 3);
const copy = {
  ru: { title: 'Яхтенная энциклопедия', intro: 'Понятные определения морских и яхтенных терминов, подготовленные на основе профессиональных источников и практики.', empty: 'Первые статьи готовятся к публикации.', kicker: 'МОРЕ ГОВОРИТ НА СВОЁМ ЯЗЫКЕ', list: 'Термины и понятия' },
  ua: { title: 'Яхтова енциклопедія', intro: 'Зрозумілі визначення морських і яхтових термінів, підготовлені на основі професійних джерел і практики.', empty: 'Перші статті готуються до публікації.', kicker: 'МОРЕ ГОВОРИТЬ СВОЄЮ МОВОЮ', list: 'Терміни та поняття' },
  en: { title: 'Yachting Encyclopedia', intro: 'Clear explanations of sailing and maritime terminology, grounded in professional sources and practical seamanship.', empty: 'The first entries are being prepared.', kicker: 'THE SEA HAS A LANGUAGE OF ITS OWN', list: 'Terms and concepts' },
}[locale as 'ru' | 'ua' | 'en'] ?? { title: 'Navi.training Encyclopedia', intro: '', empty: '' };
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['CollectionPage', 'DefinedTermSet'],
      '@id': `https://navi.training/${locale}/encyclopedia/#term-set`,
      name: copy.title,
      description: copy.intro,
      url: `https://navi.training/${locale}/encyclopedia/`,
      hasDefinedTerm: terms.map((term: any) => ({
        '@type': 'DefinedTerm',
        name: term.term,
        description: term.definition,
        url: `https://navi.training${term.route}`,
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Navi.training', item: 'https://navi.training/' },
        { '@type': 'ListItem', position: 2, name: copy.title, item: `https://navi.training/${locale}/encyclopedia/` },
      ],
    },
  ],
};
---
<BaseLayout fullBleed title={`${copy.title} — Navi.training`} description={copy.intro} locale={locale} canonical={`https://navi.training/${locale}/encyclopedia/`} structuredData={structuredData}>
  <section class="encyclopedia-hero">
    <div class="encyclopedia-hero__inner"><p class="eyebrow">{copy.kicker}</p><h1>{copy.title}</h1><p>{copy.intro}</p><span>46.1603° N · 1.1511° W</span></div>
  </section>
  <section class="encyclopedia-shell">
    <header class="section-head"><p>NAVI.TRAINING</p><h2>{copy.list}</h2></header>
    {terms.length ? <div class="term-grid">{terms.map((term) => <a class="term-card" href={term.route}><i class="ph ph-compass-rose" aria-hidden="true"></i><p class="term-domain">{term.domain}</p><h3>{term.term}<i class="ph ph-arrow-up-right" aria-hidden="true"></i></h3><p>{term.definition}</p>{term.aliases?.length ? <p class="aliases">{term.aliases.join(' · ')}</p> : null}</a>)}</div> : <p class="empty">{copy.empty}</p>}
  </section>
  <RelatedPosts posts={latestPosts} locale={locale} />
</BaseLayout>
<style>
  .encyclopedia-hero{position:relative;isolation:isolate;min-height:520px;overflow:hidden;background:linear-gradient(90deg,rgba(3,35,46,.9),rgba(3,35,46,.32)),url('/cgi/asset/65fecaed1ad009d27a4a41ce_l1_ATycUs4suoYYnQmvJibP4.webp') center 58%/cover no-repeat}
  .encyclopedia-hero__inner{display:flex;flex-direction:column;justify-content:flex-end;width:min(1180px,calc(100% - 48px));min-height:520px;margin:auto;padding:92px 0 72px;box-sizing:border-box}
  .eyebrow,.term-domain,.section-head>p{color:#d97706;text-transform:uppercase;letter-spacing:.14em;font:700 11px/1.3 Arial,sans-serif}
  .encyclopedia-hero h1{max-width:12ch;margin:12px 0 20px;color:#fff;font:400 clamp(48px,7vw,88px)/.98 'Tenor Sans',sans-serif}
  .encyclopedia-hero__inner>p:not(.eyebrow){max-width:53ch;margin:0;color:rgba(255,255,255,.9);font-size:clamp(17px,2vw,22px);line-height:1.5}
  .encyclopedia-hero__inner>span{align-self:flex-end;margin-top:32px;color:rgba(255,255,255,.76);font:700 11px/1.2 ui-monospace,monospace;letter-spacing:.12em}
  .encyclopedia-shell{position:relative;z-index:2;width:100%;margin-top:-60px;padding:78px max(24px,calc((100vw - 1120px)/2)) 132px;background:#f7faf9;border-radius:60px 60px 0 0;box-sizing:border-box;box-shadow:0 -7px 20px rgba(7,55,70,.18)}
  .section-head{margin-bottom:32px;padding-bottom:22px;border-bottom:1px solid rgba(7,55,70,.14)}
  .section-head>p{margin:0 0 10px}.section-head h2{margin:0;color:#073746;font:400 clamp(38px,5vw,58px)/1.05 'Tenor Sans',sans-serif}
  .term-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}
  .term-card{position:relative;display:block;min-width:0;padding:26px;color:#163e49;background:linear-gradient(145deg,#fff,#f0f7f7);border:1px solid #dce5e9;border-radius:18px;box-shadow:0 12px 34px rgba(18,53,65,.07);text-decoration:none;transition:transform .18s,border-color .18s,box-shadow .18s}
  .term-card:hover{color:#163e49;border-color:#d97706;box-shadow:0 18px 40px rgba(18,53,65,.12);transform:translateY(-3px)}
  .term-card>.ph{position:absolute;top:24px;right:24px;color:#77a9b8;font-size:1.45rem}
  .term-card h3{display:flex;gap:.55rem;align-items:center;margin:.4rem 30px .75rem 0;color:#102e39;font:400 1.55rem/1.15 'Tenor Sans',sans-serif}
  .term-card h3 .ph{font-size:1rem;color:#d97706}.term-card p{line-height:1.55}.aliases{color:#68777d;font-size:.9rem}.empty{padding:40px;border-radius:18px;background:#eef7fb}
  @media(max-width:900px){.term-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:640px){.encyclopedia-hero,.encyclopedia-hero__inner{min-height:440px}.encyclopedia-hero__inner{width:calc(100% - 36px);padding:76px 0 60px}.encyclopedia-hero h1{font-size:42px}.encyclopedia-hero__inner>span{align-self:flex-start;margin-top:26px}.encyclopedia-shell{margin-top:-36px;padding:54px 18px 92px;border-radius:36px 36px 0 0}.term-grid{grid-template-columns:1fr;gap:12px}.term-card{padding:22px}.term-card h3{font-size:1.35rem}}
</style>
