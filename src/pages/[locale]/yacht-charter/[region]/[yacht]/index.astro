---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Section from '~/components/design-system/Section.astro';
import { getYachtPageData, getAllFixtureYachts, type YachtDetailView } from '~/lib/charter/adapter';

export function getStaticPaths() {
  const locales = ['ru', 'ua', 'en'] as const;
  const yachts = getAllFixtureYachts();
  return yachts.flatMap(({ regionSlug, yachtSlug }) =>
    locales.map((locale) => {
      const result = getYachtPageData({ source: 'fixture', slug: yachtSlug, locale });
      const languageHrefs: Record<string, string> = {};
      for (const l of locales) {
        languageHrefs[l] = `/${l}/yacht-charter/${regionSlug}/${yachtSlug}/`;
      }
      return {
        params: { locale, region: regionSlug, yacht: yachtSlug },
        props: { result, languageHrefs, locale },
      };
    })
  );
}

const { result, languageHrefs, locale } = Astro.props;
const canonical = `https://navi.training${Astro.url.pathname}`;

const t: Record<typeof locale, { title: string; charter: string; exactDates: string; originalPrice: string; finalPrice: string; discount: string; ctaExact: string; ctaSimilar: string; openForm: string; notFound: string; unavailable: string; stale: string; expired: string; started: string; fresh: string; noOffer: string; offerActive: string; offerStarted: string; offerExpired: string }> = {
  ru: {
    title: 'Аренда яхты {name}',
    charter: 'Аренда яхт',
    exactDates: 'Точные даты',
    originalPrice: 'Базовая цена',
    finalPrice: 'Итоговая цена',
    discount: 'Скидка',
    ctaExact: 'Оставить заявку на это точное предложение',
    ctaSimilar: 'Запросить похожий вариант чартера',
    openForm: 'Открыть форму',
    notFound: 'Яхта не найдена',
    unavailable: 'Предложение временно недоступно',
    stale: 'Данные устарели',
    expired: 'Предложение просрочено',
    started: 'Предложение уже началось',
    fresh: 'Актуально',
    noOffer: 'Нет активного предложения',
    offerActive: 'Активное предложение',
    offerStarted: 'Предложение в процессе',
    offerExpired: 'Предложение завершено',
  },
  ua: {
    title: 'Оренда яхти {name}',
    charter: 'Оренда яхт',
    exactDates: 'Точні дати',
    originalPrice: 'Базова ціна',
    finalPrice: 'Підсумкова ціна',
    discount: 'Знижка',
    ctaExact: 'Залишити заявку на цю точну пропозицію',
    ctaSimilar: 'Запитати схожий варіант чартеру',
    openForm: 'Відкрити форму',
    notFound: 'Яхту не знайдено',
    unavailable: 'Пропозиція тимчасово недоступна',
    stale: 'Дані застаріли',
    expired: 'Пропозиція прострочена',
    started: 'Пропозиція вже розпочалася',
    fresh: 'Актуальне',
    noOffer: 'Немає активної пропозиції',
    offerActive: 'Активна пропозиція',
    offerStarted: 'Пропозиція в процесі',
    offerExpired: 'Пропозиція завершена',
  },
  en: {
    title: 'Yacht charter {name}',
    charter: 'Yacht charter',
    exactDates: 'Exact dates',
    originalPrice: 'Original price',
    finalPrice: 'Final price',
    discount: 'Discount',
    ctaExact: 'Request this exact offer',
    ctaSimilar: 'Request a similar charter option',
    openForm: 'Open form',
    notFound: 'Yacht not found',
    unavailable: 'Offer temporarily unavailable',
    stale: 'Data is stale',
    expired: 'Offer expired',
    started: 'Offer already started',
    fresh: 'Fresh',
    noOffer: 'No active offer',
    offerActive: 'Active offer',
    offerStarted: 'Offer in progress',
    offerExpired: 'Offer ended',
  },
};
const dict = t[locale] ?? t.en;

function freshnessText(freshness: YachtDetailView['freshness']) {
  if (freshness === 'fresh') return dict.fresh;
  if (freshness === 'stale') return dict.stale;
  if (freshness === 'started') return dict.started;
  if (freshness === 'expired') return dict.expired;
  return dict.noOffer;
}

const pageTitle =
  result.kind === 'yacht' ? dict.title.replace('{name}', result.name) : dict.notFound;
const pageDescription =
  result.kind === 'yacht'
    ? `${result.name} — ${result.model ?? ''} ${result.year ?? ''}`
    : dict.unavailable;
const socialImage = result.kind === 'yacht' ? result.images[0]?.url : undefined;

const leadContext =
  result.kind === 'yacht'
    ? {
        yacht_id: result.publicYachtId,
        yacht_name: result.name,
        public_route: Astro.url.pathname,
        offer_id: result.selectedOffer?.publicOfferId ?? '',
        offer_start: result.selectedOffer?.startDate ?? '',
        offer_end: result.selectedOffer?.endDate ?? '',
        final_price: result.selectedOffer?.finalPrice ?? '',
        currency: result.selectedOffer?.currency ?? '',
        party_context: result.selectedOffer?.partyContext ?? '',
      }
    : {};

let structuredData: Record<string, unknown> | undefined;
if (result.kind === 'yacht') {
  const regionName = result.region ?? result.base ?? 'Charter';
  const graph: Record<string, unknown>[] = [
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Navi', item: `https://navi.training/${locale}/` },
        { '@type': 'ListItem', position: 2, name: dict.charter, item: `https://navi.training/${locale}/charter` },
        { '@type': 'ListItem', position: 3, name: regionName, item: `https://navi.training/${locale}/yacht-charter/${Astro.params.region}/` },
        { '@type': 'ListItem', position: 4, name: result.name, item: canonical },
      ],
    },
  ];
  if (result.selectedOffer) {
    graph.push({
      '@context': 'https://schema.org',
      '@type': 'Offer',
      url: canonical,
      price: result.selectedOffer.finalPrice,
      priceCurrency: result.selectedOffer.currency,
      availabilityStarts: result.selectedOffer.startDate,
      availabilityEnds: result.selectedOffer.endDate,
      availability: result.selectedOffer.availability === 'confirmed' ? 'https://schema.org/InStock' : 'https://schema.org/PreOrder',
      itemOffered: { '@type': 'Product', name: result.name },
    });
  }
  structuredData = { '@context': 'https://schema.org', '@graph': graph };
}

if (result.kind === 'not-found') {
  Astro.response.status = 404;
  Astro.response.statusText = 'Not Found';
}
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  locale={locale}
  canonical={canonical}
  languageHrefs={languageHrefs}
  image={socialImage}
  fullBleed={true}
  leadForm={{ service: 'yacht-charter', context: leadContext }}
  structuredData={structuredData}
>
  {result.kind === 'not-found' && (
    <Section surface="paper" width="wide" radius="feature">
      <div class="py-20 text-center">
        <h1 class="text-4xl md:text-5xl font-tenor text-[var(--ds-ink)] mb-4">{dict.notFound}</h1>
        <a href={`/${locale}/charter`} class="text-[var(--ds-action)] hover:underline">{dict.charter}</a>
      </div>
    </Section>
  )}

  {result.kind === 'unavailable' && (
    <Section surface="paper" width="wide" radius="feature">
      <div class="py-20 text-center">
        <h1 class="text-4xl md:text-5xl font-tenor text-[var(--ds-ink)] mb-4">{dict.unavailable}</h1>
        <p class="text-[var(--ds-muted)]">{result.reason}</p>
        <a href={`/${locale}/charter`} class="text-[var(--ds-action)] hover:underline mt-4 inline-block">{dict.charter}</a>
      </div>
    </Section>
  )}

  {result.kind === 'yacht' && (
    <>
      <nav class="container mx-auto px-6 py-4 text-sm" aria-label="Breadcrumb">
        <ol class="flex gap-2 items-center text-[var(--ds-muted)]">
          <li><a href={`/${locale}/`} class="hover:underline">Navi</a></li>
          <li>/</li>
          <li><a href={`/${locale}/charter`} class="hover:underline">{dict.charter}</a></li>
          <li>/</li>
          <li><a href={`/${locale}/yacht-charter/${Astro.params.region}/`} class="hover:underline">{result.region ?? result.base}</a></li>
          <li>/</li>
          <li class="text-[var(--ds-ink)]" aria-current="page">{result.name}</li>
        </ol>
      </nav>

      <Section surface="sea" width="wide" radius="feature">
        <div class="py-16 md:py-24">
          <div class="max-w-4xl">
            <p class="eyebrow text-[var(--ds-accent-on-dark)] mb-4">{result.region ?? result.base}</p>
            <h1 class="text-4xl md:text-6xl lg:text-7xl font-tenor text-white leading-tight mb-6">{result.name}</h1>
            <p class="text-lg md:text-xl text-white/90 max-w-2xl">
              {result.model && `${result.model}, `}{result.year && `${result.year} · `}{result.vesselClass}
            </p>
            <div class="mt-8 flex flex-wrap gap-4 text-white/90 text-sm md:text-base">
              {result.lengthM !== null && <span class="px-4 py-2 rounded-full border border-white/20">{result.lengthM} m</span>}
              {result.cabins !== null && <span class="px-4 py-2 rounded-full border border-white/20">{result.cabins} cabins</span>}
              {result.berths !== null && <span class="px-4 py-2 rounded-full border border-white/20">{result.berths} berths</span>}
              {result.heads !== null && <span class="px-4 py-2 rounded-full border border-white/20">{result.heads} heads</span>}
            </div>
          </div>
        </div>
      </Section>

      <Section surface="paper" width="wide" radius="feature" stacked={true}>
        <div class="py-12 md:py-16">
          <div class="grid lg:grid-cols-[1fr_360px] gap-10 items-start">
            <div>
              <h2 class="text-2xl font-tenor text-[var(--ds-ink)] mb-6">{dict.exactDates}</h2>
              <div class="grid sm:grid-cols-2 gap-6">
                <div class="p-5 rounded-2xl bg-[var(--ds-mist)]">
                  <p class="text-sm uppercase tracking-wide text-[var(--ds-muted)] mb-1">{dict.exactDates}</p>
                  <p class="text-lg text-[var(--ds-ink)]">{result.selectedOffer ? `${result.selectedOffer.startDate} — ${result.selectedOffer.endDate}` : '—'}</p>
                </div>
                <div class="p-5 rounded-2xl bg-[var(--ds-mist)]">
                  <p class="text-sm uppercase tracking-wide text-[var(--ds-muted)] mb-1">{dict.finalPrice}</p>
                  <p class="text-2xl font-tenor text-[var(--ds-ink)]">{result.selectedOffer ? `${result.selectedOffer.finalPrice} ${result.selectedOffer.currency}` : '—'}</p>
                </div>
                {result.selectedOffer && result.selectedOffer.originalPrice && result.selectedOffer.originalPrice !== result.selectedOffer.finalPrice && (
                  <div class="p-5 rounded-2xl bg-[var(--ds-mist)]">
                    <p class="text-sm uppercase tracking-wide text-[var(--ds-muted)] mb-1">{dict.originalPrice}</p>
                    <p class="text-lg text-[var(--ds-ink)] line-through opacity-60">{result.selectedOffer.originalPrice} {result.selectedOffer.currency}</p>
                  </div>
                )}
                {result.selectedOffer && result.selectedOffer.discountPercent != null && (
                  <div class="p-5 rounded-2xl bg-[var(--ds-mist)]">
                    <p class="text-sm uppercase tracking-wide text-[var(--ds-muted)] mb-1">{dict.discount}</p>
                    <p class="text-lg text-[var(--ds-ink)]">−{result.selectedOffer.discountPercent}%</p>
                  </div>
                )}
              </div>
              <p class="mt-6 text-sm text-[var(--ds-muted)]">
                {freshnessText(result.freshness)} · {result.observedAt ? result.observedAt.slice(0, 10) : '—'}
              </p>
            </div>

            <aside class="p-6 rounded-2xl bg-white shadow-lg border border-[var(--ds-line)] lg:sticky lg:top-24">
              <p class="text-sm uppercase tracking-wide text-[var(--ds-muted)] mb-2">{dict.finalPrice}</p>
              <p class="text-3xl font-tenor text-[var(--ds-ink)]">{result.selectedOffer ? `${result.selectedOffer.finalPrice} ${result.selectedOffer.currency}` : '—'}</p>
              <p class="mt-2 text-sm text-[var(--ds-muted)]">{result.selectedOffer ? `${result.selectedOffer.startDate} — ${result.selectedOffer.endDate}` : dict.noOffer}</p>
              {result.ctaMode !== 'none' && (
                <button type="button" data-open-service-form data-service="yacht-charter" class="mt-6 w-full inline-flex items-center justify-center rounded-md border-0 bg-[var(--ds-accent)] px-6 py-4 text-base font-bold text-white hover:bg-[var(--ds-action)] transition-colors">
                  {result.ctaMode === 'exact' ? dict.ctaExact : dict.ctaSimilar}
                </button>
              )}
            </aside>
          </div>
        </div>
      </Section>

    </>
  )}
</BaseLayout>
