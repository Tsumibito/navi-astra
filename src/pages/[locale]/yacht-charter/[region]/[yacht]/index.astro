---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Section from '~/components/design-system/Section.astro';
import HeroMedia from '~/components/HeroMedia.astro';
import YachtGallery from '~/components/YachtGallery.astro';
import { getYachtPageData, getAllFixtureYachts, type YachtDetailView } from '~/lib/charter/adapter';
import { getPilotYachtPageData, getAllPilotYachts } from '~/lib/charter/pilotInventory';
import { formatCharterDate } from '~/lib/charter/dates';

export function getStaticPaths() {
  const locales = ['ru', 'ua', 'en'] as const;

  const fixtureYachts = getAllFixtureYachts();
  const pilotYachts = getAllPilotYachts();

  const allYachts = [
    ...fixtureYachts,
    ...pilotYachts,
  ];

  return allYachts.flatMap(({ regionSlug, yachtSlug }) =>
    locales.map((locale) => {
      const result =
        regionSlug === 'greece'
          ? getPilotYachtPageData(yachtSlug)
          : getYachtPageData({ source: 'fixture', slug: yachtSlug, locale });
      const languageHrefs: Record<string, string> = {};
      for (const l of locales) {
        languageHrefs[l] = `/${l}/yacht-charter/${regionSlug}/${yachtSlug}/`;
      }
      return {
        params: { locale, region: regionSlug, yacht: yachtSlug },
        props: { result, languageHrefs, locale },
      };
    })
  );
}

const { result, languageHrefs, locale } = Astro.props;
const canonical = `https://navi.training${Astro.url.pathname}`;

const t: Record<typeof locale, {
  title: string; charter: string; exactDates: string; originalPrice: string; finalPrice: string; discount: string; ctaExact: string; ctaSimilar: string; holdCta: string; openForm: string; askQuote: string; notFound: string; unavailable: string; stale: string; expired: string; started: string; fresh: string; noOffer: string; observedForDates: string; characteristics: string; equipment: string; whyThisYacht: string; heroCta: string; viewImage: string; groupOnBoard: string; ctaFinalDescription: string; whyText: string; whyTextNoOffer: string; modelLabel: string; yearLabel: string; typeLabel: string; baseLabel: string; charterModeLabel: string; lengthLabel: string; cabinsLabel: string; berthsLabel: string; headsLabel: string;
}> = {
  ru: {
    title: 'Аренда яхты {name}',
    charter: 'Аренда яхт',
    exactDates: 'Даты',
    originalPrice: 'Базовая цена',
    finalPrice: 'Итоговая цена',
    discount: 'Скидка',
    ctaExact: 'Оставить заявку на это точное предложение',
    ctaSimilar: 'Запросить похожий вариант',
    holdCta: 'Запросить опцию на 48 часов',
    openForm: 'Открыть форму',
    askQuote: 'Получить предложение',
    notFound: 'Яхта не найдена',
    unavailable: 'Предложение временно недоступно',
    stale: 'Данные устарели',
    expired: 'Предложение просрочено',
    started: 'Предложение уже началось',
    fresh: 'Актуально',
    noOffer: 'Нет активного предложения',
    observedForDates: 'Цена зафиксирована для указанных дат',
    characteristics: 'Характеристики',
    equipment: 'Оборудование',
    whyThisYacht: 'Почему эта яхта',
    heroCta: 'Смотреть фото',
    viewImage: 'Показать фото',
    groupOnBoard: 'На борту',
    ctaFinalDescription: 'Расскажите о желаемых датах, количестве гостей и базе — мы подберём лучший вариант в том же регионе и классе.',
    whyText: '{model} — {vesselClass} {year} года, база {base}. На борту кондиционер, генератор, солнечные панели, динги и Wi‑Fi. Цена зафиксирована для наблюдаемых дат {startDate}–{endDate}: {finalPrice} {currency}.',
    whyTextNoOffer: '{model} — {vesselClass} {year} года, база {base}. На борту кондиционер, генератор, солнечные панели, динги и Wi‑Fi. Для этой яхты пока нет активного предложения — оставьте запрос, и мы подберём вариант в {base}.',
    modelLabel: 'Модель',
    yearLabel: 'Год',
    typeLabel: 'Тип',
    baseLabel: 'База',
    charterModeLabel: 'Тип чартера',
    lengthLabel: 'Длина',
    cabinsLabel: 'Каюты',
    berthsLabel: 'Места',
    headsLabel: 'Санузлы',
  },
  ua: {
    title: 'Оренда яхти {name}',
    charter: 'Оренда яхт',
    exactDates: 'Дати',
    originalPrice: 'Базова ціна',
    finalPrice: 'Підсумкова ціна',
    discount: 'Знижка',
    ctaExact: 'Залишити заявку на цю точну пропозицію',
    ctaSimilar: 'Запитати схожий варіант',
    holdCta: 'Запросити опцію на 48 годин',
    openForm: 'Відкрити форму',
    askQuote: 'Отримати пропозицію',
    notFound: 'Яхту не знайдено',
    unavailable: 'Пропозиція тимчасово недоступна',
    stale: 'Дані застаріли',
    expired: 'Пропозиція прострочена',
    started: 'Пропозиція вже розпочалася',
    fresh: 'Актуальне',
    noOffer: 'Немає активної пропозиції',
    observedForDates: 'Ціна зафіксована для зазначених дат',
    characteristics: 'Характеристики',
    equipment: 'Обладнання',
    whyThisYacht: 'Чому ця яхта',
    heroCta: 'Дивитися фото',
    viewImage: 'Показати фото',
    groupOnBoard: 'На борту',
    ctaFinalDescription: 'Розкажіть про бажані дати, кількість гостей і базу — ми підберемо найкращий варіант у тому ж регіоні та класі.',
    whyText: '{model} — {vesselClass} {year} року, база {base}. На борту кондиціонер, генератор, сонячні панелі, дінгі та Wi‑Fi. Ціна зафіксована для дат спостереження {startDate}–{endDate}: {finalPrice} {currency}.',
    whyTextNoOffer: '{model} — {vesselClass} {year} року, база {base}. На борту кондиціонер, генератор, сонячні панелі, дінгі та Wi‑Fi. Для цієї яхти поки немає активної пропозиції — залиште запит, і ми підберемо варіант у {base}.',
    modelLabel: 'Модель',
    yearLabel: 'Рік',
    typeLabel: 'Тип',
    baseLabel: 'База',
    charterModeLabel: 'Тип чартеру',
    lengthLabel: 'Довжина',
    cabinsLabel: 'Каюти',
    berthsLabel: 'Місця',
    headsLabel: 'Санвузли',
  },
  en: {
    title: 'Yacht charter {name}',
    charter: 'Yacht charter',
    exactDates: 'Dates',
    originalPrice: 'Original price',
    finalPrice: 'Final price',
    discount: 'Discount',
    ctaExact: 'Request this exact offer',
    ctaSimilar: 'Request a similar option',
    holdCta: 'Request a 48-hour hold',
    openForm: 'Open form',
    askQuote: 'Get a quote',
    notFound: 'Yacht not found',
    unavailable: 'Offer temporarily unavailable',
    stale: 'Data is stale',
    expired: 'Offer expired',
    started: 'Offer already started',
    fresh: 'Fresh',
    noOffer: 'No active offer',
    observedForDates: 'Price observed for selected dates',
    characteristics: 'Characteristics',
    equipment: 'Equipment',
    whyThisYacht: 'Why this yacht',
    heroCta: 'View photos',
    viewImage: 'View image',
    groupOnBoard: 'On board',
    ctaFinalDescription: 'Tell us your preferred dates, number of guests and base — we\'ll find the best matching yacht in the same region and class.',
    whyText: '{model} — {year} {vesselClass} based in {base}. Fitted with air conditioning, a generator, solar panels, a dinghy and Wi‑Fi. Price observed for {startDate}–{endDate}: {finalPrice} {currency}.',
    whyTextNoOffer: '{model} — {year} {vesselClass} based in {base}. Fitted with air conditioning, a generator, solar panels, a dinghy and Wi‑Fi. No active offer for this yacht — send a request and we\'ll find a matching option in {base}.',
    modelLabel: 'Model',
    yearLabel: 'Year',
    typeLabel: 'Type',
    baseLabel: 'Base',
    charterModeLabel: 'Charter mode',
    lengthLabel: 'Length',
    cabinsLabel: 'Cabins',
    berthsLabel: 'Berths',
    headsLabel: 'Heads',
  },
};
const dict = t[locale] ?? t.en;

function statusText(
  freshness: YachtDetailView['freshness'],
  availability: string | undefined
) {
  if ((freshness === 'fresh' || freshness === 'stale') && availability !== 'confirmed') {
    return dict.observedForDates;
  }
  if (freshness === 'fresh') return dict.fresh;
  if (freshness === 'stale') return dict.stale;
  if (freshness === 'started') return dict.started;
  if (freshness === 'expired') return dict.expired;
  return dict.noOffer;
}

function fillTemplate(template: string, vars: Record<string, string>) {
  return Object.entries(vars).reduce((s, [k, v]) => s.replace(new RegExp(`\\{${k}\\}`, 'g'), v), template);
}

function localisedGroup(name: string) {
  return name === 'On board' ? dict.groupOnBoard : name;
}

const pageTitle =
  result.kind === 'yacht' ? dict.title.replace('{name}', result.name) : dict.notFound;
const pageDescription =
  result.kind === 'yacht'
    ? `${result.name} — ${result.model ?? ''} ${result.year ?? ''}`
    : dict.unavailable;

const heroImage =
  result.kind === 'yacht'
    ? result.images.find((img) => img.role === 'exterior') ?? result.images[0]
    : undefined;
const layoutImage = result.kind === 'yacht' ? result.images.find((image) => image.role === 'layout') : undefined;
const detailCopy = {
  ru: { overview:'Об этой яхте', layout:'План яхты', layoutNote:'План предоставлен оператором. Перед бронированием подтвердите конкретную конфигурацию, количество кают и спальных мест.', availability:'Доступность и цена', unavailable:'Для этой яхты недельный календарь и тарифные периоды пока не загружены. Отправьте даты — мы проверим свободную неделю, стоимость, депозит и обязательные доплаты у чартерной компании.', navPhotos:'Фото', navSpecs:'Характеристики', navEquipment:'Оборудование', navPlan:'План', navAvailability:'Цены и даты' },
  ua: { overview:'Про цю яхту', layout:'План яхти', layoutNote:'План наданий оператором. Перед бронюванням підтвердьте конкретну конфігурацію, кількість кают і спальних місць.', availability:'Доступність і ціна', unavailable:'Для цієї яхти тижневий календар і тарифні періоди ще не завантажені. Надішліть дати — ми перевіримо вільний тиждень, вартість, депозит та обовʼязкові доплати у чартерної компанії.', navPhotos:'Фото', navSpecs:'Характеристики', navEquipment:'Обладнання', navPlan:'План', navAvailability:'Ціни й дати' },
  en: { overview:'About this yacht', layout:'Yacht layout', layoutNote:'The plan is supplied by the operator. Confirm the exact configuration, cabins and berths before booking.', availability:'Availability and price', unavailable:'A weekly calendar and tariff periods have not yet been loaded for this yacht. Send your dates and we will verify the free week, price, security deposit and compulsory extras with the charter company.', navPhotos:'Photos', navSpecs:'Specifications', navEquipment:'Equipment', navPlan:'Layout', navAvailability:'Prices and dates' },
}[locale] ?? null;

const heroMedia = Astro.params.region === 'british-virgin-islands'
  ? {
      url: '/charter/regions/british-virgin-islands-tortola-hero.webp',
      alt: locale === 'ua'
        ? 'Узбережжя Тортоли та острови Британських Віргінських островів з повітря'
        : locale === 'en'
          ? 'Aerial view of Tortola and the British Virgin Islands'
          : 'Побережье Тортолы и острова Британских Виргинских островов с воздуха',
      width: 1920,
      height: 820,
      mimeType: 'image/webp',
    }
  : Astro.params.region === 'greece'
    ? {
        url: '/media/heroes/saronic-gulf-1920.webp',
        alt: locale === 'ua'
          ? 'Острови та синє море Саронічної затоки з повітря'
          : locale === 'en'
            ? 'Aerial view of islands and blue water in the Saronic Gulf'
            : 'Острова и синее море Саронического залива с воздуха',
        width: 1920,
        height: 1080,
        mimeType: 'image/webp',
      }
    : heroImage;

const leadContext =
  result.kind === 'yacht'
    ? {
        yacht_id: result.publicYachtId,
        yacht_name: result.name,
        public_route: Astro.url.pathname,
        offer_id: result.selectedOffer?.publicOfferId ?? '',
        offer_start: result.selectedOffer?.startDate ?? '',
        offer_end: result.selectedOffer?.endDate ?? '',
        final_price: result.selectedOffer?.finalPrice ?? '',
        currency: result.selectedOffer?.currency ?? '',
        party_context: result.selectedOffer?.partyContext ?? '',
      }
    : {};

let structuredData: Record<string, unknown> | undefined;
if (result.kind === 'yacht') {
  const regionName = result.region ?? result.base ?? 'Charter';
  const charterUrl = `https://navi.training/${locale}/charter/`;
  const regionPath = Astro.params.region === 'greece'
    ? `/${locale}/yacht-charter/greece/saronic-gulf/`
    : `/${locale}/charter/`;
  const regionUrl = `https://navi.training${regionPath}`;
  structuredData = {
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Navi', item: 'https://navi.training/' },
          { '@type': 'ListItem', position: 2, name: dict.charter, item: charterUrl },
          { '@type': 'ListItem', position: 3, name: regionName, item: regionUrl },
          { '@type': 'ListItem', position: 4, name: result.name, item: canonical },
        ],
      },
    ],
  };
}

let whyText = '';
if (result.kind === 'yacht') {
  const tpl = result.selectedOffer ? dict.whyText : dict.whyTextNoOffer;
  const offer = result.selectedOffer;
  whyText = fillTemplate(tpl, {
    model: result.model ?? result.name,
    vesselClass: result.vesselClass ?? '',
    year: String(result.year ?? ''),
    base: result.base ?? '',
    startDate: offer ? formatCharterDate(offer.startDate, locale) : '',
    endDate: offer ? formatCharterDate(offer.endDate, locale) : '',
    finalPrice: offer ? String(offer.finalPrice) : '',
    currency: offer?.currency ?? '',
  });
}

if (result.kind === 'not-found') {
  Astro.response.status = 404;
  Astro.response.statusText = 'Not Found';
}
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  locale={locale}
  canonical={canonical}
  languageHrefs={languageHrefs}
  image={heroMedia?.url}
  preloadImage={heroMedia ? { href: heroMedia.url, type: heroMedia.mimeType } : undefined}
  fullBleed={true}
  leadForm={{ service: 'yacht-charter', context: leadContext }}
  structuredData={structuredData}
  noindex={true}
>
  {result.kind === 'not-found' && (
    <Section surface="paper" width="wide" radius="feature">
      <div class="py-20 text-center">
        <h1 class="text-4xl md:text-5xl font-tenor text-[var(--ds-ink)] mb-4">{dict.notFound}</h1>
        <a href={`/${locale}/charter/`} class="text-[var(--ds-action)] hover:underline">{dict.charter}</a>
      </div>
    </Section>
  )}

  {result.kind === 'unavailable' && (
    <Section surface="paper" width="wide" radius="feature">
      <div class="py-20 text-center">
        <h1 class="text-4xl md:text-5xl font-tenor text-[var(--ds-ink)] mb-4">{dict.unavailable}</h1>
        <p class="text-[var(--ds-muted)]">{result.reason}</p>
        <a href={`/${locale}/charter/`} class="text-[var(--ds-action)] hover:underline mt-4 inline-block">{dict.charter}</a>
      </div>
    </Section>
  )}

  {result.kind === 'yacht' && (
    <>
      <nav class="hidden md:block container mx-auto px-6 py-4 text-sm" aria-label="Breadcrumb">
        <ol class="flex gap-2 items-center text-[var(--ds-muted)]">
          <li><a href="/" class="hover:underline">Navi</a></li>
          <li>/</li>
          <li><a href={`/${locale}/charter/`} class="hover:underline">{dict.charter}</a></li>
          <li>/</li>
          <li><a href={Astro.params.region === 'greece' ? `/${locale}/yacht-charter/greece/saronic-gulf/` : `/${locale}/charter/`} class="hover:underline">{result.region ?? result.base}</a></li>
          <li>/</li>
          <li class="text-[var(--ds-ink)]" aria-current="page">{result.name}</li>
        </ol>
      </nav>

      <section class="relative isolate min-h-[60vh] md:min-h-[70vh] overflow-hidden" aria-label="Hero">
        {heroMedia && (
          <HeroMedia
            src={heroMedia.url}
            alt={heroMedia.alt}
            width={heroMedia.width}
            height={heroMedia.height}
            overlay="rgba(0,0,0,.5)"
          />
        )}
        <div class="absolute inset-0 z-10 flex flex-col justify-end px-6 pb-16 md:pb-20">
          <div class="container mx-auto">
            <p class="eyebrow text-white/80 mb-3">{result.region ?? result.base}</p>
            <h1 class="text-4xl md:text-6xl lg:text-7xl font-tenor text-white leading-tight mb-4">{result.name}</h1>
            <p class="text-lg md:text-xl text-white/90 max-w-2xl mb-6">
              {result.model && `${result.model}, `}{result.year && `${result.year} · `}{result.vesselClass}
            </p>
            <a href="#gallery" class="inline-flex items-center gap-2 rounded-full border border-white/30 bg-white/10 px-5 py-2.5 text-sm font-medium text-white backdrop-blur hover:bg-white/20 transition-colors focus:outline-none focus:ring-2 focus:ring-white/50">
              {dict.heroCta}
            </a>
          </div>
        </div>
      </section>

      <nav class="yacht-jump" aria-label={locale === 'ru' ? 'Разделы карточки яхты' : locale === 'ua' ? 'Розділи картки яхти' : 'Yacht page sections'}>
        <a href="#gallery">{detailCopy.navPhotos}</a><a href="#characteristics">{detailCopy.navSpecs}</a><a href="#equipment">{detailCopy.navEquipment}</a>{layoutImage && <a href="#layout">{detailCopy.navPlan}</a>}<a href="#availability">{detailCopy.navAvailability}</a>
      </nav>

      <Section surface="paper" width="wide" radius="feature" stacked={true}>
        <div class="grid lg:grid-cols-[minmax(0,1fr)_360px] gap-10 items-start pt-6 pb-12 md:pt-8 md:pb-16" id="gallery">
          <div class="space-y-16 min-w-0">
            {result.images.length > 0 && <YachtGallery images={result.images} viewImageLabel={dict.viewImage} />}

            <section class="yacht-overview" aria-labelledby="overview-title">
              <h2 id="overview-title">{detailCopy.overview}</h2>
              <p>{locale === 'ru' ? `${result.model ?? result.name} ${result.year ? `${result.year} года` : ''} — ${result.vesselClass?.toLowerCase() ?? 'яхта'} для старта из ${result.base}. Катамаранная компоновка разделяет жилые зоны между двумя корпусами и оставляет общий салон и кокпит для экипажа — практичный формат для недельного маршрута по Сароническому заливу.` : locale === 'ua' ? `${result.model ?? result.name} ${result.year ? `${result.year} року` : ''} — ${result.vesselClass?.toLowerCase() ?? 'яхта'} для старту з ${result.base}. Катамаранне компонування розділяє житлові зони між двома корпусами та залишає спільний салон і кокпіт для екіпажу — практичний формат для тижневого маршруту Саронічною затокою.` : `${result.model ?? result.name} is a ${result.year ?? ''} ${result.vesselClass?.toLowerCase() ?? 'yacht'} based at ${result.base}. The catamaran arrangement separates accommodation between two hulls while retaining a shared saloon and cockpit—an effective format for a one-week Saronic itinerary.`}</p>
              <p>{locale === 'ru' ? `В опубликованной комплектации отмечены навигационные и бытовые системы, включая автопилот, картплоттер, кондиционер, генератор, солнечные панели и электрические лебёдки. Перед оплатой мы сверяем комплектацию, план и рабочее состояние ключевых систем с оператором: карточка каталога показывает исходные данные, но не заменяет приёмку яхты.` : locale === 'ua' ? `В опублікованій комплектації зазначені навігаційні та побутові системи, зокрема автопілот, картплотер, кондиціонер, генератор, сонячні панелі й електричні лебідки. Перед оплатою ми звіряємо комплектацію, план і робочий стан ключових систем з оператором: картка каталогу показує вихідні дані, але не замінює приймання яхти.` : `The published inventory lists navigation and comfort systems including autopilot, chart plotter, air conditioning, generator, solar panels and electric winches. Before payment we confirm equipment, layout and the status of key systems with the operator: catalogue data informs the choice but does not replace yacht handover.`}</p>
            </section>

            <section id="characteristics" aria-labelledby="char-title">
              <h2 id="char-title" class="text-2xl font-tenor text-[var(--ds-ink)] mb-6">{dict.characteristics}</h2>
              <dl class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
                {[
                  { k: dict.modelLabel, v: result.model },
                  { k: dict.yearLabel, v: result.year },
                  { k: dict.typeLabel, v: result.vesselClass },
                  { k: dict.baseLabel, v: result.base },
                  { k: dict.charterModeLabel, v: result.charterMode },
                  { k: dict.lengthLabel, v: result.lengthM ? `${result.lengthM} m` : null },
                  { k: dict.cabinsLabel, v: result.cabins },
                  { k: dict.berthsLabel, v: result.berths },
                  { k: dict.headsLabel, v: result.heads },
                ].filter((item) => item.v !== null && item.v !== undefined && String(item.v) !== '').map((item) => (
                  <div class="p-4 rounded-xl bg-[var(--ds-mist)]">
                    <dt class="text-xs uppercase tracking-wide text-[var(--ds-muted)]">{item.k}</dt>
                    <dd class="mt-1 text-lg text-[var(--ds-ink)]">{item.v}</dd>
                  </div>
                ))}
              </dl>
            </section>

            <section id="equipment" aria-labelledby="equipment-title">
              <h2 id="equipment-title" class="text-2xl font-tenor text-[var(--ds-ink)] mb-6">{dict.equipment}</h2>
              {result.equipment.map((group) => (
                <div class="mb-6">
                  <h3 class="font-tenor text-[var(--ds-ink)] mb-3">{localisedGroup(group.group)}</h3>
                  <ul class="flex flex-wrap gap-2">
                    {group.items.map((item) => (
                      <li class="px-3 py-1.5 rounded-full bg-[var(--ds-mist)] text-sm text-[var(--ds-ink)]">{item}</li>
                    ))}
                  </ul>
                </div>
              ))}
            </section>

            {layoutImage && <section id="layout" class="yacht-layout" aria-labelledby="layout-title"><h2 id="layout-title">{detailCopy.layout}</h2><img src={layoutImage.url} alt={layoutImage.alt} width={layoutImage.width} height={layoutImage.height} loading="lazy" /><p>{detailCopy.layoutNote}</p></section>}

            <section id="availability" class="yacht-availability" aria-labelledby="availability-title"><h2 id="availability-title">{detailCopy.availability}</h2>{result.selectedOffer ? <div class="offer-row"><span>{formatCharterDate(result.selectedOffer.startDate, locale)} — {formatCharterDate(result.selectedOffer.endDate, locale)}</span><strong>{result.selectedOffer.finalPrice} {result.selectedOffer.currency}</strong></div> : <p>{detailCopy.unavailable}</p>}<button type="button" class="ds-button ds-button--accent" data-open-service-form data-service="yacht-charter">{dict.askQuote}</button></section>
          </div>

          <aside class="p-6 rounded-2xl bg-white shadow-lg border border-[var(--ds-line)] lg:sticky lg:top-24">
            <p class="text-lg font-tenor text-[var(--ds-ink)] mb-1">{result.name}</p>
            <p class="text-sm text-[var(--ds-muted)] mb-4">{result.charterMode} · {result.base}</p>
            <p class="text-sm uppercase tracking-wide text-[var(--ds-muted)] mb-1">{dict.finalPrice}</p>
            <p class="text-3xl font-tenor text-[var(--ds-ink)]">{result.selectedOffer ? `${result.selectedOffer.finalPrice} ${result.selectedOffer.currency}` : '—'}</p>
            {result.selectedOffer?.originalPrice && result.selectedOffer.originalPrice !== result.selectedOffer.finalPrice && (
              <p class="text-sm text-[var(--ds-muted)] line-through mt-1">{result.selectedOffer.originalPrice} {result.selectedOffer.currency}</p>
            )}
            {result.selectedOffer?.discountPercent != null && (
              <p class="mt-2 inline-block px-2 py-1 rounded bg-[var(--ds-accent)]/10 text-[var(--ds-accent)] text-sm font-medium">−{result.selectedOffer.discountPercent}%</p>
            )}
            <p class="mt-4 text-sm text-[var(--ds-muted)]">
              {result.selectedOffer ? `${result.selectedOffer.startDate} — ${result.selectedOffer.endDate}` : dict.noOffer}
            </p>
            <p class="mt-2 text-sm text-[var(--ds-muted)]">{statusText(result.freshness, result.selectedOffer?.availability)}</p>
            {result.ctaMode !== 'none' && (
              <div class="mt-6 grid gap-2">
                <button type="button" data-open-service-form data-service="yacht-charter" class="w-full inline-flex items-center justify-center rounded-md border-0 bg-[var(--ds-accent)] px-6 py-4 text-base font-bold text-white hover:bg-[var(--ds-action)] transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[var(--ds-accent)]">
                  {result.ctaMode === 'exact' ? dict.ctaExact : dict.ctaSimilar}
                </button>
                {result.ctaMode === 'exact' && result.selectedOffer && (
                  <button type="button" data-open-service-form data-service="yacht-charter-hold" class="w-full inline-flex items-center justify-center rounded-md border border-[var(--ds-accent)] bg-white px-6 py-3 text-sm font-bold text-[var(--ds-accent)] hover:bg-[var(--ds-mist)] transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[var(--ds-accent)]">
                    {dict.holdCta}
                  </button>
                )}
              </div>
            )}
          </aside>
        </div>
      </Section>

      <Section surface="sea" width="wide" radius="feature" stacked={true}>
        <div class="py-16 md:py-24">
          <div class="max-w-3xl mx-auto text-center">
            <h2 class="text-3xl md:text-4xl font-tenor text-white mb-6">{dict.whyThisYacht}</h2>
            <p class="text-lg md:text-xl text-white/90 leading-relaxed">{whyText}</p>
          </div>
        </div>
      </Section>

      <Section surface="paper" width="wide" radius="feature" stacked={true}>
        <div class="py-16 md:py-24 text-center">
          <h2 class="text-3xl md:text-4xl font-tenor text-[var(--ds-ink)] mb-4">{dict.askQuote}</h2>
          <p class="text-lg text-[var(--ds-muted)] max-w-2xl mx-auto mb-8">{dict.ctaFinalDescription}</p>
          <button type="button" data-open-service-form data-service="yacht-charter" class="inline-flex items-center justify-center rounded-md border-0 bg-[var(--ds-accent)] px-8 py-4 text-lg font-bold text-white hover:bg-[var(--ds-action)] transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[var(--ds-accent)]">
            {dict.askQuote}
          </button>
        </div>
      </Section>
    </>
  )}
</BaseLayout>

<style>
  .yacht-jump{display:flex;justify-content:center;gap:8px;padding:14px 20px;overflow-x:auto;background:#fff;border-bottom:1px solid var(--ds-line)}.yacht-jump a{flex:none;padding:9px 13px;border-radius:999px;color:var(--ds-ink);font-weight:700;text-decoration:none}.yacht-jump a:hover{background:var(--ds-mist)}.yacht-overview h2,.yacht-layout h2,.yacht-availability h2{margin:0 0 18px;color:var(--ds-ink);font:400 clamp(30px,4vw,46px)/1.08 'Tenor Sans',sans-serif}.yacht-overview p,.yacht-layout p,.yacht-availability p{color:var(--ds-muted);font-size:17px;line-height:1.72}.yacht-layout img{display:block;width:100%;height:auto;border:1px solid var(--ds-line);border-radius:18px;background:#fff}.yacht-availability{padding:clamp(24px,4vw,40px);border-radius:20px;background:var(--ds-mist)}.offer-row{display:flex;justify-content:space-between;gap:20px;margin-bottom:20px;padding:18px 0;border-block:1px solid var(--ds-line)}@media(max-width:600px){.yacht-jump{justify-content:flex-start}.offer-row{display:grid}}
</style>
