---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/design-system/Hero.astro';
import Section from '~/components/design-system/Section.astro';
import GeographyMap from '~/components/GeographyMap.astro';
import MarineWeather from '~/components/MarineWeather.astro';
import GeographyMediaCredit from '~/components/GeographyMediaCredit.astro';

type Locale = 'ru' | 'ua' | 'en';
type Island = 'aegina' | 'poros' | 'hydra';

const islands = {
  aegina: {
    source: 'https://www.visitgreece.gr/blog/travel-tips/539/aegina-one-of-greeces-best-kept-secrets/',
    names: { ru: 'Эгина', ua: 'Егіна', en: 'Aegina' },
    lead: { ru: 'Ближайший крупный остров к Афинам: короткий первый переход, городская гавань, храм Афайи и фисташковые сады.', ua: 'Найближчий великий острів до Афін: короткий перший перехід, міська гавань, храм Афаї та фісташкові сади.', en: 'The nearest major island to Athens: a short opening passage, a town harbour, the Temple of Aphaia and pistachio groves.' },
    body: { ru: ['Эгина часто становится первой остановкой после субботней приёмки яхты в Алимосе. Переход достаточно короткий, чтобы экипаж успел освоиться с лодкой и прийти засветло, но место в порту всё равно нельзя считать гарантированным.', 'На берегу стоит оставить время на город Эгина, храм Афайи и местные фисташки. Для дальнейшего маршрута остров удобен как развилка: продолжить к Поросу либо сократить план и остаться ближе к Афинам при неблагоприятном прогнозе.'], ua: ['Егіна часто стає першою зупинкою після суботнього приймання яхти в Алімосі. Перехід досить короткий, щоб екіпаж устиг освоїтися з човном і прийти до темряви, але місце в порту не можна вважати гарантованим.', 'На березі варто залишити час на місто Егіна, храм Афаї та місцеві фісташки. Для подальшого маршруту острів зручний як розвилка: продовжити до Пороса або скоротити план і залишитися ближче до Афін за несприятливого прогнозу.'], en: ['Aegina often becomes the first stop after a Saturday handover in Alimos. The passage is short enough for a crew to settle into the yacht and arrive in daylight, although a harbour berth must never be assumed.', 'Allow shore time for Aegina town, the Temple of Aphaia and the island’s pistachios. The island also works as a decision point: continue towards Poros or keep the itinerary closer to Athens when the forecast deteriorates.'] },
  },
  poros: {
    source: 'https://www.visitgreece.gr/islands/saronic-islands/poros/', names: { ru: 'Порос', ua: 'Порос', en: 'Poros' },
    lead: { ru: 'Зелёный остров и узкий пролив у Пелопоннеса: набережная, часовая башня и удобная середина недельного маршрута.', ua: 'Зелений острів і вузька протока біля Пелопоннесу: набережна, годинникова вежа та зручна середина тижневого маршруту.', en: 'A green island and narrow strait off the Peloponnese: a waterfront, clock tower and a practical middle point in a one-week itinerary.' },
    body: { ru: ['Порос отличается от более открытых островных портов: город обращён к узкому проливу, а на противоположном берегу уже Пелопоннес. Подход и стоянку планируют по актуальной лоции и указаниям на месте.', 'Город поднимается амфитеатром над набережной. Главный ориентир прогулки — часовая башня; через пролив находится район Лимонного леса. Отсюда можно продолжить к Идре или провести дополнительный день в более защищённой части маршрута.'], ua: ['Порос відрізняється від відкритіших острівних портів: місто звернене до вузької протоки, а на протилежному березі вже Пелопоннес. Підхід і стоянку планують за актуальною лоцією та вказівками на місці.', 'Місто підіймається амфітеатром над набережною. Головний орієнтир прогулянки — годинникова вежа; через протоку розташований район Лимонного лісу. Звідси можна продовжити до Ідри або провести додатковий день у захищенішій частині маршруту.'], en: ['Poros differs from the more exposed island harbours: the town faces a narrow strait with the Peloponnese immediately opposite. Plan the approach and berth from current pilotage and local instructions.', 'The town rises amphitheatrically above the waterfront. Its clock tower is the obvious walking landmark, while the Lemon Forest lies across the strait. From here a crew can continue to Hydra or spend another day in the more sheltered part of the itinerary.'] },
  },
  hydra: {
    source: 'https://www.visitgreece.gr/islands/saronic-islands/hydra/', names: { ru: 'Идра', ua: 'Ідра', en: 'Hydra' },
    lead: { ru: 'Каменный порт без автомобилей, морские особняки и самый характерный островной день маршрута.', ua: 'Камʼяний порт без автомобілів, морські особняки та найхарактерніший острівний день маршруту.', en: 'A car-free stone harbour, maritime mansions and the itinerary’s most distinctive island day.' },
    body: { ru: ['Идра — визуальная кульминация маршрута, но популярность порта требует плана Б. Место у набережной нельзя обещать заранее; шкипер должен проверить прогноз, условия стоянки и запасные варианты до подхода.', 'По городу передвигаются пешком. Морская история читается в капитанских домах, музеях и монастырях, а отсутствие автомобилей сохраняет особый ритм острова. Обратный переход к Афинам длиннее, поэтому в недельном плане нужен резерв времени.'], ua: ['Ідра — візуальна кульмінація маршруту, але популярність порту вимагає плану Б. Місце біля набережної не можна обіцяти заздалегідь; шкіпер має перевірити прогноз, умови стоянки та запасні варіанти до підходу.', 'Містом пересуваються пішки. Морську історію видно в капітанських будинках, музеях і монастирях, а відсутність автомобілів зберігає особливий ритм острова. Зворотний перехід до Афін довший, тому в тижневому плані потрібен резерв часу.'], en: ['Hydra is the visual climax of the itinerary, but its popular harbour requires a plan B. A quay berth cannot be promised; the skipper must check the forecast, current berthing conditions and alternatives before approach.', 'The town is explored on foot. Maritime history is visible in captains’ houses, museums and monasteries, while the absence of cars preserves the island’s distinctive pace. The return towards Athens is longer, so a weekly plan needs time in reserve.'] },
  },
} as const;

export function getStaticPaths() {
  return (['ru','ua','en'] as Locale[]).flatMap((locale) => (['aegina','poros','hydra'] as Island[]).map((island) => ({ params: { locale, island } })));
}
const locale = Astro.params.locale as Locale;
const island = Astro.params.island as Island;
const data = islands[island];
if (!data) return Astro.redirect(`/${locale}/yacht-charter/greece/saronic-gulf/`);
const name = data.names[locale];
const canonical = `https://navi.training/${locale}/yacht-charter/greece/saronic-gulf/${island}/`;
const hrefs = Object.fromEntries((['ru','ua','en'] as Locale[]).map((l) => [l, `/${l}/yacht-charter/greece/saronic-gulf/${island}/`]));
const title = locale === 'ru' ? `${name}: яхтенный гид по острову` : locale === 'ua' ? `${name}: яхтовий гід островом` : `${name}: sailing guide to the island`;
const aeginaGuide = {
  ru: {
    practical:'Остров для экипажа: города, порты и стоянки', practicalLead:'Эгина — не одна гавань. Перед переходом выберите береговую задачу и запасной вариант стоянки.',
    places:[['Город Эгина и главный порт','Исторический центр, набережная, снабжение и паромное сообщение. Храм Аполлона находится примерно в пяти минутах от порта.'],['Агия-Марина','Посёлок и порт на восточном берегу рядом с храмом Афайи; официальный портовый справочник отмечает пляжи и бухты вокруг.'],['Сувала','Небольшой северный порт и курортная часть острова; подходит как отдельная береговая остановка, но условия стоянки проверяют перед подходом.'],['Пердика','Рыбацкий посёлок на юго-западе с набережной и тавернами; удобная точка для спокойной прогулки после перехода.']],
    sights:'Что посмотреть на Эгине', sightsLead:'Три разных по характеру остановки, которые можно совместить с яхтенным маршрутом.',
    sightsItems:[['Храм Афайи','Архаический храм на востоке острова и одна из главных археологических точек Эгины.'],['Храм Аполлона','Археологический комплекс рядом с главным портом — практичный вариант до или после перехода.'],['Монастырь Святого Нектария','Крупный религиозный комплекс в центре острова; до него удобнее добираться по дороге.']],
    beaches:'Пляжи и береговые районы', beachesLead:'Agia Marina — длинный мелководный семейный пляж; Marathonas и Souvala находятся в более спокойных частях острова. Проверяйте ветер, волну и транспорт перед выездом.',
    food:'Где искать еду и продукты', foodText:'За снабжением удобнее идти в городе Эгина: вокруг порта находятся магазины, кафе и таверны. За рыбными тавернами едут в Пердику. Мы не публикуем рейтинг «лучших ресторанов» без регулярно обновляемого источника: используйте карту ниже, проверяйте свежие отзывы и часы работы в день визита.',
    experience:'Что обычно ценят посетители', experienceText:'Официальные туристические материалы выделяют близость к Афинам, исторический город, фисташки, пляжи и возможность совместить археологические места с короткой поездкой. Для экипажа главный практический плюс — несколько разных береговых точек на одном острове. Это редакционное резюме, а не скопированные отзывы.',
    mapTitle:'Карта острова Эгина', mapIntro:'Дороги, населённые пункты, порты, пляж Марафонас и главные достопримечательности. Масштабируйте карту и нажимайте на отмеченные точки.',
  },
  ua: {
    practical:'Острів для екіпажу: міста, порти й стоянки', practicalLead:'Егіна — не одна гавань. Перед переходом оберіть берегову мету та запасний варіант стоянки.',
    places:[['Місто Егіна й головний порт','Історичний центр, набережна, постачання та поромне сполучення. Храм Аполлона розташований приблизно за п’ять хвилин від порту.'],['Агія-Маріна','Селище й порт на східному березі біля храму Афаї; офіційний портовий довідник відзначає пляжі та бухти навколо.'],['Сувала','Невеликий північний порт і курортна частина острова; умови стоянки перевіряють перед підходом.'],['Пердіка','Рибальське селище на південному заході з набережною і тавернами.']],
    sights:'Що подивитися на Егіні', sightsLead:'Три різні зупинки, які можна поєднати з яхтовим маршрутом.', sightsItems:[['Храм Афаї','Архаїчний храм на сході острова.'],['Храм Аполлона','Археологічний комплекс поруч із головним портом.'],['Монастир Святого Нектарія','Великий релігійний комплекс у центрі острова.']],
    beaches:'Пляжі та узбережжя', beachesLead:'Agia Marina — довгий мілководний сімейний пляж; Marathonas і Souvala розташовані у спокійніших частинах острова.', food:'Де шукати їжу та продукти', foodText:'Для постачання зручне місто Егіна. За рибними тавернами їдуть у Пердіку. Перевіряйте свіжі відгуки й години роботи на карті в день візиту.', experience:'Що зазвичай цінують відвідувачі', experienceText:'Офіційні туристичні матеріали виділяють близькість до Афін, історичне місто, фісташки, пляжі й археологічні місця. Це редакційне резюме, а не скопійовані відгуки.', mapTitle:'Карта острова Егіна', mapIntro:'Дороги, міста, порти, пляж Марафонас і головні пам’ятки.'
  },
  en: {
    practical:'For a sailing crew: towns, ports and stops', practicalLead:'Aegina is more than one harbour. Choose a shore objective and an alternative berth before setting out.', places:[['Aegina town & main port','Historic centre, waterfront, provisioning and ferries. The Temple of Apollo is about five minutes from the port.'],['Agia Marina','An east-coast village and port near the Temple of Aphaia, with beaches and coves nearby.'],['Souvala','A small northern port and resort area; verify current berthing conditions before approach.'],['Perdika','A south-west fishing village with a waterfront and tavernas.']], sights:'What to see on Aegina', sightsLead:'Three very different stops that fit into a sailing itinerary.', sightsItems:[['Temple of Aphaia','The island’s landmark Archaic temple.'],['Temple of Apollo','An archaeological site beside the main port.'],['Agios Nektarios monastery','A major religious complex in the island interior.']], beaches:'Beaches and coastal areas', beachesLead:'Agia Marina is a long, shallow family beach; Marathonas and Souvala offer alternatives elsewhere on the island.', food:'Food and provisioning', foodText:'Aegina town is the practical provisioning stop. Perdika is known for waterfront fish tavernas. Use the live map and check recent reviews and opening times on the day.', experience:'What visitors tend to value', experienceText:'Official tourism sources emphasise proximity to Athens, the historic town, pistachios, beaches and archaeological sites. This is an editorial summary, not copied review text.', mapTitle:'Map of Aegina island', mapIntro:'Roads, settlements, ports, Marathonas beach and key landmarks.'
  },
}[locale];
---
<BaseLayout fullBleed locale={locale} title={title} description={data.lead[locale]} canonical={canonical} languageHrefs={hrefs} noindex={true}>
  <Hero variant={island === 'aegina' ? 'cinematic' : 'editorial'} image={island === 'aegina' ? '/media/heroes/aegina-1920.jpg' : undefined} imageBaseName={island === 'aegina' ? 'aegina' : undefined} imageWidths={island === 'aegina' ? [640,960,1280,1920] : []} imageAlt={island === 'aegina' ? (locale === 'ru' ? 'Город и порт Эгина' : locale === 'ua' ? 'Місто і порт Егіна' : 'Aegina town and port') : ''} imageOverlay={island === 'aegina' ? 'linear-gradient(90deg,rgba(3,30,40,.86),rgba(3,30,40,.26))' : undefined} eyebrow={locale === 'ru' ? 'Саронический залив · остров' : locale === 'ua' ? 'Саронічна затока · острів' : 'Saronic Gulf · island'} title={title} description={data.lead[locale]} align="left" />
  <Section surface="paper" width="content" radius="feature" stacked>
    <article class="island-copy">{data.body[locale].map((paragraph) => <p>{paragraph}</p>)}</article>
  </Section>
  {island === 'aegina' && <Section surface="mist" width="wide" radius="feature" stacked><div class="island-shell"><h2>{aeginaGuide.practical}</h2><p>{aeginaGuide.practicalLead}</p><div class="place-grid">{aeginaGuide.places.map(([heading,text])=><article><h3>{heading}</h3><p>{text}</p></article>)}</div></div></Section>}
  {island === 'aegina' && <Section surface="paper" width="wide" radius="feature" stacked><div class="island-shell"><h2>{aeginaGuide.sights}</h2><p>{aeginaGuide.sightsLead}</p><div class="place-grid place-grid--three">{aeginaGuide.sightsItems.map(([heading,text])=><article><h3>{heading}</h3><p>{text}</p></article>)}</div><div class="island-notes"><article><h3>{aeginaGuide.beaches}</h3><p>{aeginaGuide.beachesLead}</p></article><article><h3>{aeginaGuide.food}</h3><p>{aeginaGuide.foodText}</p></article><article><h3>{aeginaGuide.experience}</h3><p>{aeginaGuide.experienceText}</p></article></div></div></Section>}
  {island === 'aegina' && <Section surface="paper" width="wide" radius="feature" stacked><MarineWeather locale={locale} place="saronic" latitude={37.746} longitude={23.428} title={locale === 'ru' ? 'Погода на Эгине' : locale === 'ua' ? 'Погода на Егіні' : 'Weather on Aegina'} /></Section>}
  <Section surface="mist" width="wide" radius="feature" stacked>
    <GeographyMap locale={locale} mode={island === 'aegina' ? 'island' : 'region'} focusId={island} title={island === 'aegina' ? aeginaGuide.mapTitle : (locale === 'ru' ? `${name} на карте региона` : locale === 'ua' ? `${name} на мапі регіону` : `${name} on the regional map`)} intro={island === 'aegina' ? aeginaGuide.mapIntro : undefined} />
    <p class="source"><a href={data.source} target="_blank" rel="external noopener">Visit Greece · {locale === 'en' ? 'source facts' : 'источник фактов'} ↗</a>{island === 'aegina' && <>{' · '}<a href="https://portofaegina.gr/web/limania.html" target="_blank" rel="external noopener">Port of Aegina ↗</a>{' · '}<a href="https://www.discovergreece.com/attica/aegina" target="_blank" rel="external noopener">Discover Greece ↗</a></>}</p>
  </Section>
  {island === 'aegina' && <Section surface="paper" width="wide"><GeographyMediaCredit creator="Nicolas Vigier" sourceName="Wikimedia Commons" sourceUrl="https://commons.wikimedia.org/wiki/File:Aegina_Port.jpg" licenceName="CC0 1.0" licenceUrl="https://creativecommons.org/publicdomain/zero/1.0/" transformations={{cropped:'16:9',resized:[640,960,1280,1920],formats:['AVIF','WebP','JPG']}} locale={locale} /></Section>}
  <Section surface="sea" width="wide" radius="feature" stacked><div class="next"><h2>{locale === 'ru' ? 'Продолжить планирование' : locale === 'ua' ? 'Продовжити планування' : 'Continue planning'}</h2><a class="ds-button ds-button--accent" href={`/${locale}/yacht-charter/greece/saronic-gulf/`}>{locale === 'ru' ? 'Вернуться к гиду по региону' : locale === 'ua' ? 'Повернутися до гіда регіоном' : 'Back to the regional guide'}</a></div></Section>
</BaseLayout>
<style>.island-copy{max-width:780px;margin:auto}.island-copy p{font-size:clamp(18px,2vw,22px);line-height:1.75}.island-shell{display:grid;gap:22px}.island-shell>h2{max-width:18ch;margin:0;color:var(--ds-ink);font:400 clamp(38px,5vw,62px)/1.04 'Tenor Sans',sans-serif}.island-shell>p{max-width:70ch;margin:0;color:var(--ds-muted);font-size:18px;line-height:1.6}.place-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}.place-grid--three{grid-template-columns:repeat(3,minmax(0,1fr))}.place-grid article,.island-notes article{padding:24px;border:1px solid var(--ds-line);border-radius:18px;background:#fff}.place-grid h3,.island-notes h3{margin:0 0 12px;color:var(--ds-ink);font-size:19px}.place-grid p,.island-notes p{margin:0;color:var(--ds-muted);line-height:1.6}.island-notes{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.source{margin:20px 0 0}.source a{color:var(--ds-ink)}.next{color:#fff}.next h2{font:400 clamp(36px,5vw,58px)/1.05 'Tenor Sans',sans-serif}@media(max-width:850px){.place-grid,.place-grid--three,.island-notes{grid-template-columns:1fr 1fr}}@media(max-width:560px){.place-grid,.place-grid--three,.island-notes{grid-template-columns:1fr}}</style>
