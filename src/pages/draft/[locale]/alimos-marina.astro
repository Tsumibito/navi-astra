---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/design-system/Hero.astro';
import Section from '~/components/design-system/Section.astro';
import StatPanel from '~/components/design-system/StatPanel.astro';
import YachtSearch from '~/components/YachtSearch.astro';
import YachtRail from '~/components/YachtRail.astro';
import factPack from '~/data/alimos-marina.json';
import { getRouteById, getYachtTypeLabel } from '~/lib/charter/routes.ts';
import { getPilotYachtsByScope } from '~/lib/charter/pilotInventory.ts';
import operatorCandidates from '~/data/operator-candidates-greece.json';
import GeographyMediaCredit from '~/components/GeographyMediaCredit.astro';
import GeographyMap from '~/components/GeographyMap.astro';
import { geographyCopy } from '~/data/geography/saronic-pilot';
import { defaultSearchState } from '~/lib/charter/search.ts';
import MarineWeather from '~/components/MarineWeather.astro';

export function getStaticPaths() {
  return ['ru', 'ua', 'en'].map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as 'ru' | 'ua' | 'en';
const publicMode = !Astro.url.pathname.startsWith('/draft/');
const path = publicMode ? `/${locale}/yacht-charter/greece/athens/alimos-marina/` : `/draft/${locale}/alimos-marina`;
const alimosRoute = getRouteById('marina:alimos-marina');
const initialSearch = alimosRoute ? defaultSearchState(alimosRoute, locale) : null;
const alimosYachts = getPilotYachtsByScope('marina:alimos-marina');
const typeRails = [
  { type: 'Catamaran' as const, yachts: alimosYachts.filter((y) => y.vesselClass === 'Catamaran') },
  { type: 'Sailing boat' as const, yachts: alimosYachts.filter((y) => y.vesselClass === 'Sailing boat') },
  { type: 'Motoryacht' as const, yachts: alimosYachts.filter((y) => y.vesselClass === 'Motoryacht') },
].filter(({ yachts }) => yachts.length > 0);
const now = new Date();
const minDate = now.toISOString().slice(0, 10);
const maxDate = new Date(now.getTime() + 365 * 24 * 60 * 60 * 1000).toISOString().slice(0, 10);
const languageHrefs = {
  ru: publicMode ? '/ru/yacht-charter/greece/athens/alimos-marina/' : '/draft/ru/alimos-marina',
  ua: publicMode ? '/ua/yacht-charter/greece/athens/alimos-marina/' : '/draft/ua/alimos-marina',
  en: publicMode ? '/en/yacht-charter/greece/athens/alimos-marina/' : '/draft/en/alimos-marina',
};

const baseId = '13';
const alimosOperators = (operatorCandidates as any[]).filter(
  (op) => Array.isArray(op.greek_bases) && op.greek_bases.includes(baseId)
);

const pack = factPack as any;
const coords = pack.claims.find((c: any) => c.topic === 'coordinates')?.value || { latitude: 37.9140134, longitude: 23.699967 };
const facilities = pack.claims.find((c: any) => c.topic === 'facilities')?.value || [];
const officialUrl = pack.claims.find((c: any) => c.topic === 'official_url')?.value || '';
const totalOffers = pack.catalogue_metrics?.loadable_offer_count || 0;
const capturedAt = pack.catalogue_metrics?.captured_at || '2026-07-21T09:04:01Z';
const observedDate = new Date(capturedAt).toLocaleDateString(
  locale === 'ua' ? 'uk' : locale,
  { year: 'numeric', month: 'long', day: 'numeric' }
);
const containedIn = pack.claims.find((c: any) => c.topic === 'membership' && c.predicate === 'located_in')?.value || 'locality:alimos';
const metroContext = pack.claims.find((c: any) => c.topic === 'membership' && c.predicate === 'metropolitan_context')?.value || 'locality:athens';
const addressClaim = pack.claims.find((c: any) => c.predicate === 'address')?.value;

const facilityKey: Record<string, string> = {
  '1100 permanent berths': 'berths',
  '600 wintering places': 'wintering',
  'yacht service village': 'service_village',
  'shoreside restaurants and cafes': 'restaurants',
};

const metroName = metroContext === 'locality:athens'
  ? (locale === 'ru' ? 'Афины' : locale === 'ua' ? 'Афіни' : 'Athens')
  : 'Athens';

const postalAddress = addressClaim
  ? {
      '@type': 'PostalAddress',
      streetAddress: addressClaim.streetAddress,
      addressLocality: addressClaim.addressLocality,
      addressRegion: addressClaim.addressRegion,
      postalCode: addressClaim.postalCode,
      addressCountry: addressClaim.addressCountry,
    }
  : {
      '@type': 'PostalAddress',
      streetAddress: 'Posidonos Avenue',
      addressLocality: 'Alimos',
      addressRegion: 'Attica',
      postalCode: '17455',
      addressCountry: 'GR',
    };

const translations = {
  ru: {
    eyebrow: 'Марина · Алимос · Саронический залив',
    title: 'Аренда яхт в марине Алимос, Греция',
    description: 'Практический гид по главной чартерной базе Афин: как добраться, что есть в марине, карта, морская погода и яхты для старта по Сароническому заливу.',
    officialSite: 'Официальный сайт',
    statsTitle: 'Марина Алимос в цифрах',
    aboutTitle: 'О марине',
    aboutText: `Марина Алимос — одна из крупнейших марин восточного Средиземноморья и историческая база яхт-чартеров в Алимосе на Афинской Ривьере. Согласно лекции Navi, Алимос отмечается как чартерная база Саронического залива наряду с Лаврионом. Официальный сайт марины подтверждает наличие специализированной деревни чартерных компаний (Yacht Charter Village).`,
    locationTitle: 'Расположение и доступ',
    transportText: 'Марина находится примерно в 15 км от центра Афин, 8 км от Пирея и 30 км от аэропорта. Сюда идут трамваи и автобусы; для экипажа с багажом практичнее заранее заказать такси или трансфер прямо к понтону.',
    facilitiesTitle: 'Инфраструктура',
    facilitiesText: 'Официальный сайт марины подтверждает следующие объекты и услуги:',
    reviewsTitle: 'Отзывы и актуальная обстановка',
    reviewsText: 'Мы не копируем отдельные отзывы без лицензии и не превращаем старые оценки в собственный рейтинг. Перед приездом откройте свежие отзывы на карте: особенно полезны комментарии о доступе к понтонам, санитарных зонах, парковке и работе сервисов в день приёмки.',
    reviewsLink: 'Открыть отзывы и места на Google Maps',
    facilityLabels: {
      berths: '1100 постоянных мест для яхт',
      wintering: '600 зимовочных мест',
      service_village: 'деревня сервисных и чартерных компаний',
      restaurants: 'причальные рестораны и кафе',
    },
    operatorsTitle: 'Чартерные компании в Алимосе',
    operatorsText: 'В марине работает Yacht Charter Village и офисы чартерных операторов. Ниже — компании, присутствие которых в Алимосе зафиксировано в каталоге; перед визитом мы уточним понтон и часы работы выбранного оператора.',
    observedOffersText: '{count} предложений зафиксировано в каталоге на {date}. Это недельный snapshot, а не подтверждённая текущая доступность.',
    pilotRailTitle: 'Яхты для аренды в марине Алимос',
    pilotRailEmpty: 'Откройте поиск — мы проверим актуальные варианты и даты у операторов марины.',
    pilotTypePrefix: '',
    ctaTitle: 'Запросить варианты из Алимоса',
    ctaText: 'Мы подберём доступные яхты у операторов, работающих с этой мариной, и свяжемся с вами.',
    ctaButton: 'Подобрать яхту',
    disclaimer: 'Эта информация о марине не заменяет актуальные карты, уведомления для мореплавателей, указания гаванского мастера и качественный лоцманский провод.',
    stats: {
      berths: '1100',
      berthsLabel: 'постоянных мест',
      wintering: '600',
      winteringLabel: 'зимовочных мест',
      offers: String(totalOffers),
      offersLabel: 'записей в каталоге',
      operators: String(alimosOperators.length),
      operatorsLabel: 'операторов',
    },
  },
  ua: {
    eyebrow: 'Марина · Алімос · Саронічна затока',
    title: 'Оренда яхт у марині Алімос, Греція',
    description: 'Практичний гід головною чартерною базою Афін: як дістатися, інфраструктура, карта, морська погода та яхти для старту Саронічною затокою.',
    officialSite: 'Офіційний сайт',
    statsTitle: 'Марина Алімос у цифрах',
    aboutTitle: 'Про марину',
    aboutText: `Марина Алімос — одна з найбільших марин східного Середземномор'я та історична база яхт-чартерів в Алімосі на Афінській Ривʼєрі. За лекцією Navi, Алімос зазначається як чартерна база Саронічної затоки разом із Лавріоном. Офіційний сайт марини підтверджує наявність спеціалізованого чартерного селища (Yacht Charter Village).`,
    locationTitle: 'Розташування та доступ',
    transportText: 'Марина розташована приблизно за 15 км від центру Афін, 8 км від Пірея та 30 км від аеропорту. Сюди ходять трамваї й автобуси; екіпажу з багажем зручніше замовити таксі або трансфер безпосередньо до понтона.',
    facilitiesTitle: 'Інфраструктура',
    facilitiesText: 'Офіційний сайт марини підтверджує такі обʼєкти та послуги:',
    reviewsTitle: 'Відгуки й актуальна ситуація', reviewsText: 'Ми не копіюємо окремі відгуки без ліцензії та не перетворюємо старі оцінки на власний рейтинг. Перед приїздом відкрийте свіжі відгуки на карті — особливо про доступ до понтонів, санітарні зони, паркування та роботу сервісів.', reviewsLink: 'Відкрити відгуки й місця на Google Maps',
    facilityLabels: {
      berths: '1100 постійних місць для яхт',
      wintering: '600 зимовочних місць',
      service_village: 'селище сервісних і чартерних компаній',
      restaurants: 'причальні ресторани та кавʼярні',
    },
    operatorsTitle: 'Чартерні компанії в Алімосі',
    operatorsText: 'У марині працює Yacht Charter Village та офіси чартерних операторів. Нижче — компанії, присутність яких в Алімосі зафіксована в каталозі; перед візитом ми уточнимо понтон і години роботи обраного оператора.',
    observedOffersText: '{count} пропозицій зафіксовано в каталозі на {date}. Це тижневий snapshot, а не підтверджена поточна доступність.',
    pilotRailTitle: 'Яхти для оренди в марині Алімос',
    pilotRailEmpty: 'Відкрийте пошук — ми перевіримо актуальні варіанти та дати в операторів марини.',
    pilotTypePrefix: '',
    ctaTitle: 'Запитати варіанти з Алімоса',
    ctaText: 'Ми підберемо доступні яхти у операторів, що працюють із цією мариною, і звʼяжемося з вами.',
    ctaButton: 'Підібрати яхту',
    disclaimer: 'Ця інформація про марину не замінює актуальні карти, повідомлення для мореплавців, вказівки гаванського майстра та якісний лоцманський провід.',
    stats: {
      berths: '1100',
      berthsLabel: 'постійних місць',
      wintering: '600',
      winteringLabel: 'зимовочних місць',
      offers: String(totalOffers),
      offersLabel: 'записів у каталозі',
      operators: String(alimosOperators.length),
      operatorsLabel: 'операторів',
    },
  },
  en: {
    eyebrow: 'Marina · Alimos · Saronic Gulf',
    title: 'Yacht charter from Alimos Marina, Greece',
    description: 'A practical guide to Athens’ main charter base: access, facilities, map, marine weather and yachts for a Saronic Gulf departure.',
    officialSite: 'Official website',
    statsTitle: 'Alimos Marina in numbers',
    aboutTitle: 'About the marina',
    aboutText: `Alimos Marina is one of the largest marinas in the eastern Mediterranean and a historic yacht-charter base in Alimos on the Athenian Riviera. The Navi regions lecture notes Alimos as a charter base in the Saronic Gulf, alongside Lavrion. The marina's official website confirms a dedicated Yacht Charter Village with charter companies.`,
    locationTitle: 'Location and access',
    transportText: 'The marina is approximately 15 km from central Athens, 8 km from Piraeus and 30 km from the airport. Trams and buses serve the area; crews with luggage will usually find a pre-booked taxi or pontoon transfer easier.',
    facilitiesTitle: 'Facilities',
    facilitiesText: 'The marina official website confirms the following facilities and services:',
    reviewsTitle: 'Reviews and current conditions', reviewsText: 'We do not reproduce individual reviews without a licence or turn old scores into our own rating. Before arrival, open recent map reviews—especially comments about pontoon access, washrooms, parking and services on handover day.', reviewsLink: 'Open reviews and nearby places on Google Maps',
    facilityLabels: {
      berths: '1100 permanent berths for yachts',
      wintering: '600 wintering places',
      service_village: 'yacht service and charter village',
      restaurants: 'quayside restaurants and cafés',
    },
    operatorsTitle: 'Charter companies in Alimos',
    operatorsText: 'The marina has a Yacht Charter Village and charter operator offices. The companies below are recorded at Alimos in the catalogue; before arrival we will confirm the pontoon and opening hours for your operator.',
    observedOffersText: '{count} offers were recorded in the catalogue on {date}. This is a weekly snapshot, not confirmed current availability.',
    pilotRailTitle: 'Yachts for charter from Alimos Marina',
    pilotRailEmpty: 'Open the search and we will check current yachts and dates with marina operators.',
    pilotTypePrefix: '',
    ctaTitle: 'Request options from Alimos',
    ctaText: 'We will match available yachts with operators working from this marina and contact you.',
    ctaButton: 'Find a yacht',
    disclaimer: 'This marina information does not replace current charts, Notices to Mariners, harbourmaster instructions or proper pilotage.',
    stats: {
      berths: '1100',
      berthsLabel: 'permanent berths',
      wintering: '600',
      winteringLabel: 'wintering places',
      offers: String(totalOffers),
      offersLabel: 'catalogue records',
      operators: String(alimosOperators.length),
      operatorsLabel: 'operators',
    },
  },
};

const t = translations[locale];
const scopedOffers = alimosYachts.reduce((sum, y) => sum + y.offers.length, 0);
const totalYachts = pack.catalogue_metrics?.catalogue_yacht_count ?? 0;
const catalogueLine = t.observedOffersText.replace('{count}', String(totalOffers)).replace('{date}', observedDate);

const stats = [
  { value: t.stats.berths, label: t.stats.berthsLabel },
  { value: t.stats.wintering, label: t.stats.winteringLabel },
  { value: String(totalYachts), label: locale === 'ru' ? 'яхт в каталоге (snapshot)' : locale === 'ua' ? 'яхт у каталозі (snapshot)' : 'yachts in catalogue (snapshot)' },
  { value: String(totalOffers), label: locale === 'ru' ? 'записей в каталоге (snapshot)' : locale === 'ua' ? 'записів у каталозі (snapshot)' : 'catalogue records (snapshot)' },
  { value: String(alimosYachts.length), label: locale === 'ru' ? 'яхт с фото и данными' : locale === 'ua' ? 'яхт із фото та даними' : 'yachts with photos and data' },
  { value: String(scopedOffers), label: locale === 'ru' ? 'ценовых предложений в подборке' : locale === 'ua' ? 'цінових пропозицій у добірці' : 'priced offers in this selection' },
  { value: t.stats.operators, label: t.stats.operatorsLabel },
];

const athensTitle = locale === 'ru' ? 'Афины' : locale === 'ua' ? 'Афіни' : 'Athens';
const yachtList = {
  '@type': 'ItemList',
  itemListElement: alimosYachts.map((y, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: y.name,
    item: {
      '@type': 'Product',
      name: y.name,
      '@id': `https://navi.training/${locale}/yacht-charter/greece/${y.slug}/`,
      url: `https://navi.training/${locale}/yacht-charter/greece/${y.slug}/`,
    },
  })),
};

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: athensTitle, item: publicMode ? `https://navi.training/${locale}/charter/` : `https://navi.training/draft/${locale}/athens` },
        { '@type': 'ListItem', position: 2, name: t.title, item: `https://navi.training${path}` },
      ],
    },
    {
      '@type': 'BoatTerminal',
      name: t.title,
      description: t.description,
      url: `https://navi.training${path}/`,
      ...(officialUrl ? { sameAs: [officialUrl] } : {}),
      address: postalAddress,
      geo: {
        '@type': 'GeoCoordinates',
        latitude: coords.latitude,
        longitude: coords.longitude,
      },
      containedInPlace: {
        '@type': 'City',
        name: containedIn === 'locality:alimos' ? 'Alimos' : 'Alimos',
      },
      additionalProperty: {
        '@type': 'PropertyValue',
        name: 'metropolitan_context',
        value: metroName,
      },
    },
    yachtList,
  ],
};

const preloadImage = {
  href: '/media/heroes/alimos-marina-1280.avif',
  type: 'image/avif',
  srcset: '/media/heroes/alimos-marina-640.avif 640w, /media/heroes/alimos-marina-960.avif 960w, /media/heroes/alimos-marina-1280.avif 1280w',
  sizes: '100vw',
};
---

<BaseLayout
  fullBleed={true}
  title={t.title}
  description={t.description}
  locale={locale}
  noindex={true}
  canonical={`https://navi.training${path}`}
  languageHrefs={languageHrefs}
  image='/media/heroes/alimos-marina-1280.jpg'
  preloadImage={preloadImage}
  structuredData={structuredData}
  leadForm={{ service: 'yacht-charter', title: t.ctaTitle, intro: t.ctaText, button: t.ctaButton, context: { marina: 'Alimos Marina', region: 'Saronic Gulf' } }}
>
  <Hero
    variant='cinematic'
    image='/media/heroes/alimos-marina-1280.jpg'
    imageBaseName='alimos-marina'
    imageWidths={[640, 960, 1280]}
    imageAlt={t.title}
    imageOverlay='rgba(7, 55, 70, 0.42)'
    eyebrow={t.eyebrow}
    title={t.title}
    description={t.description}
  >
    <div slot='actions' class='alimos-hero-actions'>
      <a href={officialUrl} class='alimos-btn alimos-btn--secondary' target='_blank' rel='noopener nofollow external'>{t.officialSite}</a>
      <button type='button' data-open-service-form data-service='yacht-charter' class='alimos-btn alimos-btn--accent'>{t.ctaButton}</button>
    </div>
  </Hero>

  <StatPanel title={t.statsTitle} stats={stats} />

  <Section surface='mist' width='wide' radius='feature' stacked>
    <div class='alimos-shell'>
      <h2 class='alimos-title'>{t.aboutTitle}</h2>
      <p class='alimos-body'>{t.aboutText}</p>
      <h3 class='alimos-subtitle'>{t.locationTitle}</h3>
      <p class='alimos-body'>
        <span class='alimos-coordinate'>{coords.latitude.toFixed(5)}° N, {coords.longitude.toFixed(5)}° E</span><br />
        {t.transportText}
      </p>
    </div>
  </Section>

  <Section surface='paper' width='wide' radius='feature' stacked>
    <div class='alimos-shell'>
      <h2 class='alimos-title'>{t.facilitiesTitle}</h2>
      <p class='alimos-body'>{t.facilitiesText}</p>
      <ul class='alimos-checklist'>
        {facilities
          .filter((item: string) => facilityKey[item])
          .map((item: string) => <li>{t.facilityLabels[facilityKey[item] as keyof typeof t.facilityLabels]}</li>)}
      </ul>
      <p class='alimos-body alimos-body--small'>{t.disclaimer}</p>
    </div>
  </Section>

  <Section surface='mist' width='wide' radius='feature' stacked>
    <GeographyMap locale={locale} mode='marina' title={geographyCopy[locale].marina.mapTitle} intro={geographyCopy[locale].marina.mapIntro} />
  </Section>

  <Section surface='paper' width='wide' radius='feature' stacked>
    <div class='alimos-shell alimos-reviews'><div><p class='ds-eyebrow'>LIVE SOURCES</p><h2 class='alimos-title'>{t.reviewsTitle}</h2></div><div><p class='alimos-body'>{t.reviewsText}</p><a class='alimos-btn alimos-btn--secondary' href='https://www.google.com/maps/search/?api=1&query=Alimos+Marina' target='_blank' rel='external noopener nofollow'>{t.reviewsLink} ↗</a></div></div>
  </Section>

  <Section surface='paper' width='wide' radius='feature' stacked>
    <MarineWeather locale={locale} />
  </Section>

  {alimosRoute && initialSearch && (
    <YachtSearch locale={locale} route={alimosRoute} initialState={initialSearch} minDate={minDate} maxDate={maxDate} />
  )}

  {alimosYachts.length > 0 && (
    <YachtRail yachts={alimosYachts} locale={locale} title={t.pilotRailTitle} empty={t.pilotRailEmpty} searchState={initialSearch} layout='grid' />
  )}

  {typeRails.map(({ type, yachts }) => yachts.length > 0 && (
    <YachtRail yachts={yachts} locale={locale} title={locale === 'ru' ? `Арендовать ${getYachtTypeLabel(type, locale).toLowerCase()} в марине Алимос` : locale === 'ua' ? `Орендувати ${getYachtTypeLabel(type, locale).toLowerCase()} у марині Алімос` : `Charter a ${getYachtTypeLabel(type, locale).toLowerCase()} from Alimos Marina`} empty={t.pilotRailEmpty} searchState={initialSearch} layout='grid' />
  ))}

  <Section surface='mist' width='wide' radius='feature' stacked>
    <div class='alimos-shell'>
      <h2 class='alimos-title'>{t.operatorsTitle}</h2>
      <p class='alimos-body'>{t.operatorsText}</p>
      {alimosOperators.length > 0 ? (
        <ul class='alimos-operator-list'>
          {alimosOperators.map((op) => (
            <li class='alimos-operator-item'>{op.display_name}</li>
          ))}
        </ul>
      ) : (
        <p class='alimos-body'>{t.observedOffersText}</p>
      )}
      <p class='alimos-body alimos-body--small'>{catalogueLine}</p>
    </div>
  </Section>

  <Section surface='sea' width='wide' radius='feature' stacked>
    <div class='alimos-shell'>
      <h2 class='alimos-title alimos-title--light'>{t.ctaTitle}</h2>
      <p class='alimos-body alimos-body--light'>{t.ctaText}</p>
      <button type='button' data-open-service-form data-service='yacht-charter' class='alimos-btn alimos-btn--accent'>{t.ctaButton}</button>
    </div>
  </Section>
  {pack.media_credit && (
    <Section surface="mist" width="wide">
      <GeographyMediaCredit
        creator={pack.media_credit.creator}
        sourceName={pack.media_credit.sourceName}
        sourceUrl={pack.media_credit.sourceUrl}
        licenceName={pack.media_credit.licenceName}
        licenceUrl={pack.media_credit.licenceUrl}
        changes={pack.media_credit.changes}
        locale={locale}
      />
    </Section>
  )}
</BaseLayout>

