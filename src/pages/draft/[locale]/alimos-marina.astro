---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Hero from '../../../components/design-system/Hero.astro';
import Section from '../../../components/design-system/Section.astro';
import StatPanel from '../../../components/design-system/StatPanel.astro';
import factPack from '../../../data/alimos-marina.json';
import operatorCandidates from '../../../data/operator-candidates-greece.json';

export function getStaticPaths() {
  return ['ru', 'ua', 'en'].map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as 'ru' | 'ua' | 'en';
const path = `/draft/${locale}/alimos-marina`;
const languageHrefs = {
  ru: '/draft/ru/alimos-marina',
  ua: '/draft/ua/alimos-marina',
  en: '/draft/en/alimos-marina',
};

const baseId = '13';
const alimosOperators = (operatorCandidates as any[]).filter(
  (op) => Array.isArray(op.greek_bases) && op.greek_bases.includes(baseId)
);

const pack = factPack as any;
const coords = pack.claims.find((c: any) => c.topic === 'coordinates')?.value || { latitude: 37.9140134, longitude: 23.699967 };
const facilities = pack.claims.find((c: any) => c.topic === 'facilities')?.value || [];
const officialUrl = pack.claims.find((c: any) => c.topic === 'official_url')?.value || '';
const totalOffers = pack.catalogue_metrics?.loadable_offer_count || 0;
const capturedAt = pack.catalogue_metrics?.captured_at || '2026-07-21T09:04:01Z';
const observedDate = new Date(capturedAt).toLocaleDateString(
  locale === 'ua' ? 'uk' : locale,
  { year: 'numeric', month: 'long', day: 'numeric' }
);

const facilityKey: Record<string, string> = {
  '1100 permanent berths': 'berths',
  '600 wintering places': 'wintering',
  'yacht service village': 'service_village',
  'shoreside restaurants and cafes': 'restaurants',
};

const translations = {
  ru: {
    eyebrow: 'Марина · Афины · Саронический залив',
    title: 'Марина Алимос',
    description: 'Крупная яхт-чартерная марина в Афинах: 1100 постоянных мест, 600 зимовочных, деревня чартерных компаний, около 40 минут от аэропорта.',
    officialSite: 'Официальный сайт',
    aboutTitle: 'О марине',
    aboutText: `Марина Алимос — одна из крупнейших марин восточного Средиземноморья и историческая база яхт-чартеров в Афинах. Согласно лекции Navi, Алимос отмечается как чартерная база Саронического залива наряду с Лаврионом. Официальный сайт марины подтверждает наличие специализированной деревни чартерных компаний (Yacht Charter Village).`,
    locationTitle: 'Расположение и доступ',
    transportText: 'Около 40 минут от международного аэропорта Афин имени Элефтериоса Венизелоса; рядом с портом Пирей и центром города.',
    facilitiesTitle: 'Инфраструктура',
    facilitiesText: 'Официальный сайт марины подтверждает следующие объекты и услуги:',
    facilityLabels: {
      berths: '1100 постоянных мест для яхт',
      wintering: '600 зимовочных мест',
      service_village: 'деревня сервисных и чартерных компаний',
      restaurants: 'причальные рестораны и кафе',
    },
    operatorsTitle: 'Чартерные операторы',
    operatorsText: 'Следующие операторы заявлены в каталоге с базой в Алимосе.',
    observedOffersText: '{count} предложений зафиксировано в каталоге на {date}. Это недельный snapshot, а не подтверждённая текущая доступность.',
    ctaTitle: 'Запросить варианты из Алимоса',
    ctaText: 'Мы подберём доступные яхты у операторов, работающих с этой мариной, и свяжемся с вами.',
    ctaButton: 'Подобрать яхту',
    disclaimer: 'Эта информация о марине не заменяет актуальные карты, уведомления для мореплавателей, указания гаванского мастера и качественный лоцманский провод.',
    stats: {
      berths: '1100',
      berthsLabel: 'постоянных мест',
      wintering: '600',
      winteringLabel: 'зимовочных мест',
      offers: '237',
      offersLabel: 'записей в каталоге',
      operators: String(alimosOperators.length),
      operatorsLabel: 'операторов',
    },
  },
  ua: {
    eyebrow: 'Марина · Афіни · Саронічна затока',
    title: 'Марина Алімос',
    description: 'Велика яхт-чартерна марина в Афінах: 1100 постійних місць, 600 зимовочних, чартерне селище, близько 40 хвилин від аеропорту.',
    officialSite: 'Офіційний сайт',
    aboutTitle: 'Про марину',
    aboutText: `Марина Алімос — одна з найбільших марин східного Середземномор'я та історична база яхт-чартерів в Афінах. За лекцією Navi, Алімос зазначається як чартерна база Саронічної затоки разом із Лавріоном. Офіційний сайт марини підтверджує наявність спеціалізованого чартерного селища (Yacht Charter Village).`,
    locationTitle: 'Розташування та доступ',
    transportText: 'Близько 40 хвилин від міжнародного аеропорту Афін імені Елефтеріоса Венізелоса; поруч із портом Пірей і центром міста.',
    facilitiesTitle: 'Інфраструктура',
    facilitiesText: 'Офіційний сайт марини підтверджує такі обʼєкти та послуги:',
    facilityLabels: {
      berths: '1100 постійних місць для яхт',
      wintering: '600 зимовочних місць',
      service_village: 'селище сервісних і чартерних компаній',
      restaurants: 'причальні ресторани та кавʼярні',
    },
    operatorsTitle: 'Чартерні оператори',
    operatorsText: 'Наступні оператори заявлені в каталозі з базою в Алімосі.',
    observedOffersText: '{count} пропозицій зафіксовано в каталозі на {date}. Це тижневий snapshot, а не підтверджена поточна доступність.',
    ctaTitle: 'Запитати варіанти з Алімоса',
    ctaText: 'Ми підберемо доступні яхти у операторів, що працюють із цією мариною, і звʼяжемося з вами.',
    ctaButton: 'Підібрати яхту',
    disclaimer: 'Ця інформація про марину не замінює актуальні карти, повідомлення для мореплавців, вказівки гаванського майстра та якісний лоцманський провід.',
    stats: {
      berths: '1100',
      berthsLabel: 'постійних місць',
      wintering: '600',
      winteringLabel: 'зимовочних місць',
      offers: '237',
      offersLabel: 'записів у каталозі',
      operators: String(alimosOperators.length),
      operatorsLabel: 'операторів',
    },
  },
  en: {
    eyebrow: 'Marina · Athens · Saronic Gulf',
    title: 'Alimos Marina',
    description: 'A major yacht-charter marina in Athens: 1100 permanent berths, 600 wintering places, a charter village, about 40 minutes from the airport.',
    officialSite: 'Official website',
    aboutTitle: 'About the marina',
    aboutText: `Alimos Marina is one of the largest marinas in the eastern Mediterranean and a historic yacht-charter base in Athens. The Navi regions lecture notes Alimos as a charter base in the Saronic Gulf, alongside Lavrion. The marina's official website confirms a dedicated Yacht Charter Village with charter companies.`,
    locationTitle: 'Location and access',
    transportText: 'About 40 minutes from Athens International Airport (Eleftherios Venizelos); close to Piraeus port and the city centre.',
    facilitiesTitle: 'Facilities',
    facilitiesText: 'The marina’s official website confirms the following amenities and services:',
    facilityLabels: {
      berths: '1100 permanent yacht berths',
      wintering: '600 wintering places',
      service_village: 'yacht service and charter village',
      restaurants: 'shoreside restaurants and cafes',
    },
    operatorsTitle: 'Charter operators',
    operatorsText: 'The following operators are listed in the catalogue with a base at Alimos.',
    observedOffersText: '{count} loadable records were observed in the catalogue on {date}. This is a weekly snapshot, not confirmed current availability.',
    ctaTitle: 'Request options from Alimos',
    ctaText: 'We will match available yachts from operators working with this marina and get back to you.',
    ctaButton: 'Find a yacht',
    disclaimer: 'This marina information does not replace current charts, Notices to Mariners, harbourmaster instructions or proper pilotage.',
    stats: {
      berths: '1100',
      berthsLabel: 'permanent berths',
      wintering: '600',
      winteringLabel: 'wintering places',
      offers: '237',
      offersLabel: 'catalogue records',
      operators: String(alimosOperators.length),
      operatorsLabel: 'operators',
    },
  },
};

const t = translations[locale];
const catalogueLine = t.observedOffersText.replace('{count}', String(totalOffers)).replace('{date}', observedDate);

const stats = [
  { value: t.stats.berths, label: t.stats.berthsLabel },
  { value: t.stats.wintering, label: t.stats.winteringLabel },
  { value: String(totalOffers), label: t.stats.offersLabel },
  { value: t.stats.operators, label: t.stats.operatorsLabel },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BoatTerminal',
  name: t.title,
  description: t.description,
  url: `https://navi.training${path}/`,
  geo: {
    '@type': 'GeoCoordinates',
    latitude: coords.latitude,
    longitude: coords.longitude,
  },
  containedInPlace: {
    '@type': 'City',
    name: locale === 'ru' ? 'Афины' : locale === 'ua' ? 'Афіни' : 'Athens',
  },
};

const preloadImage = {
  href: '/media/heroes/charter-1280.avif',
  type: 'image/avif',
  srcset: '/media/heroes/charter-640.avif 640w, /media/heroes/charter-960.avif 960w, /media/heroes/charter-1280.avif 1280w',
  sizes: '100vw',
};
---

<BaseLayout
  title={t.title}
  description={t.description}
  locale={locale}
  noindex={true}
  languageHrefs={languageHrefs}
  image='/media/heroes/charter-1280.avif'
  preloadImage={preloadImage}
  structuredData={structuredData}
  leadForm={{ service: 'yacht-charter', title: t.ctaTitle, intro: t.ctaText, button: t.ctaButton, context: { marina: 'Alimos Marina', region: 'Saronic Gulf' } }}
>
  <Hero
    variant='cinematic'
    image='/media/heroes/charter-1280.avif'
    imageBaseName='charter'
    imageWidths={[640, 960, 1280]}
    imageAlt={t.title}
    eyebrow={t.eyebrow}
    title={t.title}
    description={t.description}
  >
    <div slot='actions' class='alimos-hero-actions'>
      <a href={officialUrl} class='alimos-btn alimos-btn--secondary' target='_blank' rel='noopener nofollow external'>{t.officialSite}</a>
      <button type='button' data-open-service-form data-service='yacht-charter' class='alimos-btn alimos-btn--accent'>{t.ctaButton}</button>
    </div>
  </Hero>

  <StatPanel title={t.aboutTitle} stats={stats} />

  <Section surface='mist' width='wide' radius='feature' stacked>
    <div class='alimos-shell'>
      <h2 class='alimos-title'>{t.aboutTitle}</h2>
      <p class='alimos-body'>{t.aboutText}</p>
      <h3 class='alimos-subtitle'>{t.locationTitle}</h3>
      <p class='alimos-body'>
        <span class='alimos-coordinate'>{coords.latitude.toFixed(5)}° N, {coords.longitude.toFixed(5)}° E</span><br />
        {t.transportText}
      </p>
    </div>
  </Section>

  <Section surface='paper' width='wide' radius='feature' stacked>
    <div class='alimos-shell'>
      <h2 class='alimos-title'>{t.facilitiesTitle}</h2>
      <p class='alimos-body'>{t.facilitiesText}</p>
      <ul class='alimos-checklist'>
        {facilities
          .filter((item: string) => facilityKey[item])
          .map((item: string) => <li>{t.facilityLabels[facilityKey[item] as keyof typeof t.facilityLabels]}</li>)}
      </ul>
      <p class='alimos-body alimos-body--small'>{t.disclaimer}</p>
    </div>
  </Section>

  <Section surface='mist' width='wide' radius='feature' stacked>
    <div class='alimos-shell'>
      <h2 class='alimos-title'>{t.operatorsTitle}</h2>
      <p class='alimos-body'>{t.operatorsText}</p>
      {alimosOperators.length > 0 ? (
        <ul class='alimos-operator-list'>
          {alimosOperators.map((op) => (
            <li class='alimos-operator-item'>{op.display_name}</li>
          ))}
        </ul>
      ) : (
        <p class='alimos-body'>{t.observedOffersText}</p>
      )}
      <p class='alimos-body alimos-body--small'>{catalogueLine}</p>
    </div>
  </Section>

  <Section surface='sea' width='wide' radius='feature' stacked>
    <div class='alimos-shell'>
      <h2 class='alimos-title alimos-title--light'>{t.ctaTitle}</h2>
      <p class='alimos-body alimos-body--light'>{t.ctaText}</p>
      <button type='button' data-open-service-form data-service='yacht-charter' class='alimos-btn alimos-btn--accent'>{t.ctaButton}</button>
    </div>
  </Section>
</BaseLayout>

<style>
  .alimos-shell {
    width: min(800px, 100%);
    margin-inline: auto;
  }
  .alimos-title {
    margin: 0 0 18px;
    font: 400 clamp(32px, 4vw, 48px)/1.1 'Tenor Sans', sans-serif;
    color: #073746;
  }
  .alimos-title--light {
    color: #fff;
  }
  .alimos-subtitle {
    margin: 32px 0 14px;
    font: 700 22px/1.3 Arial, sans-serif;
    color: #073746;
  }
  .alimos-body {
    max-width: 70ch;
    font-size: 18px;
    line-height: 1.75;
    color: #163e49;
    margin: 0 0 22px;
  }
  .alimos-body--light {
    color: rgba(255, 255, 255, 0.92);
  }
  .alimos-body--small {
    font-size: 15px;
    color: #52656b;
  }
  .alimos-coordinate {
    font-family: Arial, sans-serif;
    font-size: 15px;
    letter-spacing: 0.02em;
    color: #52656b;
  }
  .alimos-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    justify-content: center;
    margin-top: 32px;
  }
  .ds-hero--left .alimos-hero-actions {
    justify-content: flex-start;
  }
  .alimos-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 12px 28px;
    border: 0;
    border-radius: 10px;
    font: 700 16px/1.2 Arial, sans-serif;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.18s ease, color 0.18s ease;
  }
  .alimos-btn--secondary {
    color: #073746;
    background: #f7faf9;
  }
  .alimos-btn--secondary:hover {
    background: #e9f2f1;
  }
  .alimos-btn--accent {
    color: #073746;
    background: #ffb052;
  }
  .alimos-btn--accent:hover {
    background: #d97706;
    color: #fff;
  }
  .alimos-checklist {
    display: grid;
    gap: 12px;
    padding: 0;
    margin: 0 0 22px;
    list-style: none;
  }
  .alimos-checklist li {
    position: relative;
    padding-left: 32px;
    font-size: 18px;
    line-height: 1.5;
    color: #163e49;
  }
  .alimos-checklist li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 5px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 2px solid #d97706;
  }
  .alimos-operator-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 18px;
    padding: 0;
    margin: 0 0 22px;
    list-style: none;
  }
  .alimos-operator-item {
    padding: 18px 22px;
    font-size: 17px;
    color: #073746;
    background: #fff;
    border: 1px solid rgba(7, 55, 70, 0.12);
    border-radius: 14px;
  }
</style>