---
import CampaignAudience from '../../components/campaign/ru/CampaignAudience.astro';
import CampaignChoice from '../../components/campaign/ru/CampaignChoice.astro';
import CampaignCta from '../../components/campaign/ru/CampaignCta.astro';
import CampaignFaq from '../../components/campaign/ru/CampaignFaq.astro';
import CampaignHero from '../../components/campaign/ru/CampaignHero.astro';
import CampaignHowItWorks from '../../components/campaign/ru/CampaignHowItWorks.astro';
import CampaignInstructor from '../../components/campaign/ru/CampaignInstructor.astro';
import CampaignOutcomes from '../../components/campaign/ru/CampaignOutcomes.astro';
import CampaignProblem from '../../components/campaign/ru/CampaignProblem.astro';
import CampaignReviews from '../../components/campaign/ru/CampaignReviews.astro';
import CharterForDummiesProgram from '../../components/CharterForDummiesProgram.astro';
import LandingLayout from '../../layouts/LandingLayout.astro';
import data from '../../data/pages/charter-for-dummies-ru.json';

const locale = data.locale as 'ru' | 'ua' | 'en';
---
<LandingLayout {...data} locale={locale}>
  <CampaignHero />
  <CampaignAudience />
  <CampaignReviews />
  <CampaignProblem />
  <CampaignOutcomes />
  <CampaignChoice />
  <CharterForDummiesProgram locale={locale as 'ru' | 'ua'} />
  <CampaignInstructor />
  <CampaignHowItWorks />
  <CampaignFaq />
  <CampaignCta />
</LandingLayout>
