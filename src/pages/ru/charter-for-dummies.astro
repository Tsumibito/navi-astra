---
import LandingLayout from '../../layouts/LandingLayout.astro';
import data from '../../data/pages/charter-for-dummies-ru.json' with { type: 'json' };

const { meta, body, styleTags, locale } = data as { meta: any; body: string; styleTags: string[]; locale: 'ru' | 'ua' | 'en' };
---
<LandingLayout {...meta} locale={locale} styleTags={styleTags}>
  <Fragment set:html={body} />
</LandingLayout>
